// Oracle checked 2026-10-22. The target discards two cards; count the exact visible discard
// result (CR 608.2c, 701.9c) so hidden Library of Leng cards do not contribute card types.
(
  id: "gerrards_verdict",
  name: "Gerrard's Verdict",
  face_id: "gerrard_s_verdict",
  mana_cost: "{W}{B}",
  types: ["Sorcery"],
  spell_program: Some((body: (steps: [
    (id: "discard", bind: ["discarded"],
      kind: Perform(ChooseHandCards(action: Discard, count: 2,
        target: (kind: AnyPlayer),
        card_filter: None))),
    (id: "gain_life", input: Some("discarded"),
      kind: Perform(GainLife(amount: Count(Affine( terms: [
        (coefficient: 3, quantity: BoundCardResultCount(
          aggregation: Total, card_type: Some(Land),
        ))
      ])))))
  ]), target_bindings: [
    (instruction_id: "discard", role: Target, target_group_index: 0),
  ])),
  targeting: Some((groups: [(
    min: 1, max: 1, prompt: "Choose target player", effect_indices: [],
  )])),
)
