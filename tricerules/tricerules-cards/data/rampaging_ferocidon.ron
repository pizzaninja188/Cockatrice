(
  id: "rampaging_ferocidon",
  name: "Rampaging Ferocidon",
  mana_cost: "{2}{R}",
  types: ["Creature", "Dinosaur"],
  power: 3,
  toughness: 3,
  keywords: [Menace],
  static_abilities: [ProhibitLifeGain(players: All)],
  triggered_abilities: [
    (
      trigger: WheneverPermanentEntersBattlefield(
        controller: AnyPlayer,
        filter: (permanent_type: Some(Creature), exclude_source: true),
      ),
      effect: [DamagePlayer(amount: 1, who: TriggerObjectController)],
      text: "Whenever another creature enters, this creature deals 1 damage to that creature's controller.",
    ),
  ],
)
