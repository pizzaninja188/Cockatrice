  face_id: "rampaging_ferocidon",
  mana_cost: "{2}{R}",
  types: ["Creature", "Dinosaur"],
  power: 3,
  toughness: 3,
  keywords: [Menace],
  static_abilities: [(ability_id: "static_01", presentation: Fallback, definition: ProhibitLifeGain(players: All))],
