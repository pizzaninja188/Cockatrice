// Oracle (EOE): Menace. Threshold — Whenever this creature attacks, if there are seven or more
// cards in your graveyard, it gets +2/+0 until end of turn. The intervening-if condition is
// checked both when the ability would trigger and when it resolves (CR 603.4).
(
  id: "crypt_feaster",
  name: "Crypt Feaster",
  mana_cost: "{3}{B}",
  types: ["Creature", "Zombie"],
  power: 3,
  toughness: 4,
  keywords: [Menace],
  triggered_abilities: [
    (
      trigger: WheneverSelfAttacks(minimum_other_attackers: 0),
      effect: [PumpTarget(power: 2, toughness: 0, subject: Source)],
      text: "Whenever this creature attacks, if there are seven or more cards in your graveyard, this creature gets +2/+0 until end of turn.",
      intervening_if: Some(GameCondition(GraveyardAggregate(
        owners: Controller,
        aggregate: CardCount,
        min: Some(7),
      ))),
    ),
  ],
)
