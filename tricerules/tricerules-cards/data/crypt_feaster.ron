// The intervening-if condition is checked at trigger and resolution time (CR 603.4).
(
  id: "crypt_feaster",
  name: "Crypt Feaster",
  face_id: "crypt_feaster",
  mana_cost: "{3}{B}",
  types: ["Creature", "Zombie"],
  power: 3,
  toughness: 4,
  keywords: [Menace],
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: Fallback,
      trigger: WheneverSelfAttacks(minimum_other_attackers: 0),
      effect: [PumpTarget(power: 2, toughness: 0, subject: Source)],
      intervening_if: Some(GameCondition(GraveyardAggregate(
        owners: Controller,
        aggregate: CardCount,
        min: Some(7),
      ))),
    ),
  ],
)
