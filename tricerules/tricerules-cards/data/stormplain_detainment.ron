(
  id: "stormplain_detainment",
  name: "Stormplain Detainment",
  mana_cost: "{2}{W}",
  // Oracle: When Stormplain Detainment enters the battlefield, exile target nonland permanent an
  // opponent controls until Stormplain Detainment leaves the battlefield. CR 610.3.
  types: ["Enchantment"],
  triggered_abilities: [(
    trigger: WhenSelfEntersBattlefield,
    effect: [ExileUntilSourceLeaves(target: (kind: AnyPermanent, controller: Opponent, not_land: true))],
    text: "When Stormplain Detainment enters, exile target nonland permanent an opponent controls until Stormplain Detainment leaves the battlefield.",
  )],
)
