  name: "Keening Apparition",
  face_id: "keening_apparition",
  mana_cost: "{1}{W}",
  types: ["Creature", "Spirit"],
  power: 2,
  toughness: 2,
  activated_abilities: [
    (
      ability_id: "activated_01",
      presentation: OracleLines([1]),
      costs: [SacrificeSelf],
      effect: [Destroy(subject: Chosen((kind: AnyPermanent, permanent_types: [Enchantment])))],
    ),
  ],
)
