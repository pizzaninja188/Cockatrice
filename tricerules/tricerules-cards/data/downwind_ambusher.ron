// Oracle/rulings verified 2026-08-28. Damage eligibility uses committed turn history.
(
  id: "downwind_ambusher",
  name: "Downwind Ambusher",
  face_id: "downwind_ambusher",
  mana_cost: "{3}{B}",
  types: ["Creature", "Skunk", "Assassin"],
  power: 4,
  toughness: 2,
  keywords: [Flash],
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: Fallback,
    trigger: WhenSelfEntersBattlefield,
    modal: Some((min_modes: 1, max_modes: 1, modes: [
      (mode_id: "mode_01", presentation: OracleLines([3]), effects: [PumpTarget(power: -1, toughness: -1, subject: Chosen((kind: Creature, controller: Opponent)))]),
      (mode_id: "mode_02", presentation: OracleLines([4]), effects: [Destroy(subject: Chosen((kind: Creature, controller: Opponent, was_dealt_damage_this_turn: Some(true))))]),
    ])),
  )],
)
