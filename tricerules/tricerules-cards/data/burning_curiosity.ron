// Oracle and rulings verified 2026-08-29. CR 601.2f-h/701.68: the optional
// Blight payment is captured at cast time and controls one grouped exile permission.
(
  id: "burning_curiosity",
  name: "Burning Curiosity",
  face_id: "burning_curiosity",
  mana_cost: "{2}{R}",
  types: ["Sorcery"],
  cast_cost_groups: [(
    group_id: "cast_cost_01",
    presentation: OracleLines([1]),
    min: 0,
    max: 1,
    options: [Blight(option_id: "option_01", presentation: OracleLines([1]), count: 1)],
  )],
  spell_effect: [ExileTopWithPlayPermission(
    player: Controller,
    count: 2,
    count_by_cast_cost: Some((
      condition: (group_index: 0, option_index: 0, expected_selected: true),
      if_selected: 3,
      otherwise: 2,
    )),
  )],
)
