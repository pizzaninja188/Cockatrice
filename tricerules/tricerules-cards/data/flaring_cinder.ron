// Oracle and ruling checked against Scryfall on 2026-08-26. A cast spell's mana value includes
// announced X; copied spells are not cast and do not trigger this ability.
(
  id: "flaring_cinder",
  name: "Flaring Cinder",
  face_id: "flaring_cinder",
  mana_cost: "{1}{U/R}{U/R}",
  types: ["Creature", "Elemental", "Sorcerer"],
  power: 3,
  toughness: 2,
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: Fallback,
      trigger: WhenSelfEntersBattlefield,
      effect: [ChooseResolutionBranch(
        optional: true,
        branches: [(
          branch_id: "discard_a_card", presentation: Fallback,
          cost: DiscardCard(filter: None),
          effects: [Draw(count: 1)],
        )],
      )],
    ),
    (
      ability_id: "triggered_02",
      presentation: Fallback,
      trigger: WheneverPlayerCastsSpell(caster: Controller, filter: (min_mana_value: Some(4))),
      effect: [ChooseResolutionBranch(
        optional: true,
        branches: [(
          branch_id: "discard_a_card", presentation: Fallback,
          cost: DiscardCard(filter: None),
          effects: [Draw(count: 1)],
        )],
      )],
    ),
  ],
)
