(
  id: "pirate_peddlers",
  name: "Pirate Peddlers",
  mana_cost: "{2}{B}",
  types: ["Creature", "Human", "Pirate"],
  power: 2,
  toughness: 2,
  keywords: [Deathtouch],
  triggered_abilities: [(
