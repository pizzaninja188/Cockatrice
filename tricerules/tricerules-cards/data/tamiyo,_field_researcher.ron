// Oracle 9cf99129-f51a-4418-a8cc-8ca2992b17fa; INR 249 printing 576ba8db-fad9-4c48-96be-a8a7e5f43039.
// Source/rulings: official Innistrad Remastered release notes.
// CR 603.7b-e: captured controller and exact watched objects until that player's next turn.
// CR 118.9a-d / 107.3b: alternate base cost; additional costs remain and mana X is zero.
(
    id: "tamiyo,_field_researcher", name: "Tamiyo, Field Researcher", face_id: "tamiyo_field_researcher",
    mana_cost: "{1}{G}{W}{U}", supertypes: ["Legendary"],
    types: ["Planeswalker", "Tamiyo"], loyalty: 4,
    activated_abilities: [(
        ability_id: "activated_01", presentation: OracleLines([1]), costs: [Loyalty(1)],
        effect: [CreateWatchedCombatDamageDrawUntilNextTurn(target: (kind: Creature), ability: (
            ability_id: "delayed_01", presentation: OracleLines([1]),
            trigger: WheneverWatchedObjectDealsCombatDamage,
            effect: [Draw(who: Controller, count: 1)],
        ))],
        targeting: Some((groups: [(
            min: 0, max: 2, effect_indices: [0],
        )])),
    ), (
        ability_id: "activated_02", presentation: OracleLines([2]), costs: [Loyalty(-2)],
        effect: [
            Tap(subject: Chosen((kind: AnyPermanent, excluded_permanent_types: [Land]))),
            SkipNextUntap(target: (kind: AnyPermanent, excluded_permanent_types: [Land])),
        ],
        targeting: Some((groups: [(
            min: 0, max: 2, prompt: "Choose up to two target nonland permanents", effect_indices: [0, 1],
        )])),
    ), (
        ability_id: "activated_03", presentation: OracleLines([3]), costs: [Loyalty(-7)],
        effect: [Draw(who: Controller, count: 3), CreateStaticEmblem(
            emblem_id: "tamiyo_field_researcher_emblem", display_name: "Tamiyo, Field Researcher Emblem",
            effects: [CastSpellsFromHandWithoutPayingManaCost],
        )],
    )],
)
