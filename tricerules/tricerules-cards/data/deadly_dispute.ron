// CR 118.8 and 601.2f-h (the sacrifice is an additional cost paid before casting), 701.21
// (sacrifice), 121.1 (draw) and 701.6a (Treasure token). Copy of Fanatical Offering's
// additional-cost shape, Altar's Reap's draw and Seize the Spoils' Treasure rider.
(
  id: "deadly_dispute",
  name: "Deadly Dispute",
  face_id: "deadly_dispute",
  mana_cost: "{1}{B}",
  types: ["Instant"],
  cast_cost_groups: [(
    group_id: "additional_cost",
    presentation: OracleLines([1]),
    min: 1,
    options: [
      SacrificePermanent(
        option_id: "sacrifice_artifact_or_creature",
        presentation: OracleLines([1]),
        kind: AdditionalPayment,
        filter: (any_of: Some([
          (kind: AnyPermanent, controller: You, permanent_types: [Artifact]),
          (kind: Creature, controller: You),
        ])),
      ),
    ],
  )],
  spell_effect: [
    Draw(count: 2),
    CreateTokens(token: "treasure", count: 1),
  ],
)
