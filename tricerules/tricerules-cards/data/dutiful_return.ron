// Oracle c8f958da-3a31-4064-9a78-66e9b65b85ab; source/rulings checked 2026-11-12.
// CR 115.1a/601.2c (up to two targets chosen at cast), 608.2b (stale targets) and 400.7 (a graveyard card moves to hand as a new object).
(
  id: "dutiful_return",
  name: "Dutiful Return",
  face_id: "dutiful_return",
  mana_cost: "{3}{B}",
  types: ["Sorcery"],
  spell_effect: [MoveGraveyardCards(
    filter: ( card: Some((card_type: Some(Creature)))),
    destination: Hand,
  )],
  targeting: Some((groups: [(
    min: 0,
    max: 2,
    prompt: "Choose up to two target creature cards in your graveyard",
    effect_indices: [0],
  )])),
)
