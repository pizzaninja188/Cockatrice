// Exact Oracle card and rulings refreshed 2026-10-16:
// https://scryfall.com/card/cmr/202/sparktongue-dragon
// https://api.scryfall.com/cards/289a3c60-c740-4e2e-a622-a749ed230c5b/rulings
// CR 603.12 and 603.3d: payment creates the reflexive trigger, which is targeted as it is put on the stack.
(
  id: "sparktongue_dragon",
  name: "Sparktongue Dragon",
  face_id: "sparktongue_dragon",
  mana_cost: "{3}{R}{R}",
  types: ["Creature", "Dragon"],
  power: 3,
  toughness: 3,
  keywords: [Flying],
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: OracleLines([2]),
      trigger: WhenSelfEntersBattlefield,
      program: Some((body: (steps: [
        (id: "pay_2_r", kind: Choose(
          choice: "sparktongue_pay_to_damage", chooser: Controller, optional: true,
          branches: [(
            branch_id: "pay_2_r", presentation: Fallback,
            cost: Mana("{2}{R}"),
            body: (steps: [
              (id: "create_reflexive_damage",
               kind: Perform(CreateReflexiveTrigger(ability: (
                 ability_id: "reflexive_01", presentation: Fallback,
                 effect: [DamageTarget(amount: 3, target: (kind: AnyTarget))],
               )))),
            ]),
          )],
          otherwise: (),
        )),
      ]))),
    ),
  ],
)
