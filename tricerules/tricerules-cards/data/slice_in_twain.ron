// Oracle a96d0065-b8c1-4843-8752-dce60bf83545; source/rulings checked 2026-11-23 against the
// pinned Scryfall bulk SHA-256 a9a2fd3b550cc5cff4cec9bbc82aaf5fb8e3f781b4b95a896a0d94c15dce7853.
// CR 701.8 (destroy), 121.1 (draw), 115.1/601.2c (target at cast) and 608.2b (a stale sole
// target fizzles the whole spell, so no draw). The pinned 2017-09-29 ruling fixes both branches:
// illegal target means no draw, but an indestructible legal target still draws. Copy of the
// reviewed naturalize artifact-or-enchantment destruction plus aura_blast's draw.
(
  id: "slice_in_twain",
  name: "Slice in Twain",
  face_id: "slice_in_twain",
  mana_cost: "{2}{G}{G}",
  types: ["Instant"],
  spell_effect: [
    Destroy(subject: Chosen((
      any_of: Some([
        (kind: AnyPermanent, permanent_types: [Artifact]),
        (kind: AnyPermanent, permanent_types: [Enchantment]),
      ]),
    ))),
    Draw(count: 1),
  ],
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target artifact or enchantment",
    effect_indices: [0],
  )])),
)
