// Oracle 40544d12-0391-4a61-af95-9b8ec01ed8fc; source/rulings checked 2026-11-13.
// CR 305.6/305.8 (basic land subtypes), 614.1c (enter-tapped replacement) and
// 605.1a/605.3b (mana ability).
(
  id: "vernal_fen",
  name: "Vernal Fen",
  face_id: "vernal_fen",
  mana_cost: "",
  types: ["Land", "Swamp", "Forest"],
  activated_abilities: [
    (
      ability_id: "activated_01",
      presentation: OracleLines([1]),
      intrinsic_land_mana: true,
      costs: [Tap],
      effect: [ProduceMana(options: [
        (b: 1),
        (g: 1),
      ])],
    ),
  ],
  static_abilities: [
    (
      ability_id: "static_01",
      presentation: OracleLines([2]),
      definition: EntersTapped(
        affected: Self_,
        condition: Some(BattlefieldAggregate(
          filter: (controllers: Controller, card_type: Some(BasicLand), exclude_source: true),
          aggregate: Count,
          max: Some(1),
        )),
      ),
    ),
  ],
)
