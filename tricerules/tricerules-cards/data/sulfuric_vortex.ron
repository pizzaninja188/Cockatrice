// Sulfuric Vortex — CR 503.1a upkeep trigger scoped to *each* player (AnyPlayer).
// The 2 damage goes to the player whose upkeep it is, not to the enchantment's controller, so
// the effect resolves against the trigger's affected player (StackItem::trigger_player).
// CR 120.3a: damage to a player, so a prevention shield (CR 615.1) applies — deliberately not
// modelled as life loss.
//
// The unimplemented CR 614 life-gain replacement is tracked in authoring/partial-cards.tsv.
// Consequence while it is unimplemented:
// life gain still resolves normally and lifegain payoffs (Ajani's Pridemate, Soul Warden) still
// trigger with a Vortex on the battlefield.
(
  id: "sulfuric_vortex",
  name: "Sulfuric Vortex",
  face_id: "sulfuric_vortex",
  mana_cost: "{1}{R}{R}",
  types: ["Enchantment"],
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: OracleLines([1]),
      trigger: AtBeginningOfUpkeep(player: AnyPlayer),
      effect: [DamagePlayer(amount: 2, who: AffectedPlayer)],
    ),
  ],
)
