// Oracle and rulings checked against Gatherer on 2026-08-26.
(
  id: "kav_landseeker",
  name: "Kav Landseeker",
  mana_cost: "{3}{R}",
  types: ["Creature", "Kavu", "Soldier"],
  power: 4,
  toughness: 3,
  keywords: [Menace],
  triggered_abilities: [(
    trigger: WhenSelfEntersBattlefield,
    effect: [CreateTokens(
      token: "lander",
      count: 1,
      sacrifice_timing: Some(ControllerNextTurnEndStep),
    )],
    text: "When this creature enters, create a Lander token. At the beginning of the end step on your next turn, sacrifice that token.",
  )],
)
