// Pinned 2009-05-01 rulings: the opponent may have no cards, and the draw still happens when no
// card is discarded. CR 701.9, 121.1 and 608.2c: the discard parks, then the draw resumes.
(
  id: "brainbite",
  name: "Brainbite",
  face_id: "brainbite",
  mana_cost: "{2}{U}{B}",
  types: ["Sorcery"],
  spell_effect: [
    ChooseHandCards(action: Discard,
      count: 1,
      target: (kind: OpponentPlayer),
      chooser: Controller,
      visibility: PublicReveal,
    ),
    Draw(count: 1),
  ],
  targeting: Some((groups: [(min: 1, max: 1, effect_indices: [0])])),
)
