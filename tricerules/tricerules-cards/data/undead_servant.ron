// Oracle/rulings checked 2026-08-10. Count the controller's public graveyard when the ETB trigger
// resolves; the source card counts if it died in response (CR 400.2, 404, 608.2h).
(
  id: "undead_servant",
  name: "Undead Servant",
  face_id: "undead_servant",
  mana_cost: "{3}{B}",
  types: ["Creature", "Zombie"],
  power: 3,
  toughness: 2,
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: OracleLines([1]),
      trigger: WhenSelfEntersBattlefield,
      effect: [
        CreateTokens(
          token: "zombie_b_2_2",
          count: Count(GraveyardCardsNamed(owners: Controller, name: "Undead Servant")),
        ),
      ],
    ),
  ],
)
