  id: "impossible_inferno",
  name: "Impossible Inferno",
  face_id: "impossible_inferno",
  mana_cost: "{4}{R}",
  types: ["Instant"],
  spell_effect: [],
  spell_program: Some((body: (steps: [
    (id: "damage_target", bind: [], input: None,
      kind: Perform(DamageTarget(amount: 6, target: (kind: Creature)))),
    (id: "delirium", bind: [], input: None,
