(
  id: "rambunctious_mutt",
  name: "Rambunctious Mutt",
  face_id: "rambunctious_mutt",
  mana_cost: "{3}{W}{W}",
  // ETB targeting is constrained to an opponent's artifact or enchantment.
  types: ["Creature", "Dog"],
  power: 3,
  toughness: 4,
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: OracleLines([1]),
      trigger: WhenSelfEntersBattlefield,
      effect: [
        Destroy(
          subject: Chosen((
            kind: AnyPermanent,
            controller: Opponent,
            permanent_types: [Artifact, Enchantment],
          )),
        ),
      ],
    ),
  ],
)
