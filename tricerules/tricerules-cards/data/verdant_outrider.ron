// Oracle and rulings fetched 2026-08-27. CR 509.1b/h: gaining evasion does not undo blocks.
(
  id: "verdant_outrider", name: "Verdant Outrider", mana_cost: "{2}{G}",
  types: ["Creature", "Human", "Knight"], power: 4, toughness: 2,
  activated_abilities: [(
    costs: [Mana("{1}{G}")],
    effect: [ApplyCombatRestriction(scope: Source, restriction: (
      cant_be_blocked_by: [(kind: Creature, power: Some(AtMost(2)))],
    ))],
    text: "{1}{G}: This creature can't be blocked by creatures with power 2 or less this turn.",
  )],
)
