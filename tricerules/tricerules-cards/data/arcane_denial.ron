// Pinned Oracle/ruling verified from Scryfall on 2026-10-06. CR 503.1, 603.3b, 603.7a-b/d,
// 121.2 govern the next-upkeep trigger, its controller, simultaneous ordering, and the draw choice.
(
  id: "arcane_denial",
  name: "Arcane Denial",
  face_id: "arcane_denial",
  mana_cost: "{1}{U}",
  types: ["Instant"],
  spell_program: Some((body: (steps: [
    (id: "counter_spell", bind: ["target_controller"],
      kind: Perform(CounterTargetSpell(
        spell_filter: (), unless_controller_pays: None,
      ))),
    (id: "create_target_draw_trigger", input: Some("target_controller"),
      kind: Perform(CreateDelayedTrigger(
        subject: None,
        affected_player: Some(ProgramInputPlayer),
        ability: (
          ability_id: "delayed_01",
          presentation: OracleLines([1]),
          trigger: AtBeginningOfNextTurnUpkeep,
          effect: [],
          program: Some((body: (steps: [
            (id: "choose_count", kind: DrawCountChoice(
              choice: "draw_count",
              chooser: AffectedPlayer,
              presentation: OracleLines([1]),
              who: AffectedPlayer,
              alternatives: [
                (branch_id: "draw_zero", count: 0),
                (branch_id: "draw_one", count: 1),
                (branch_id: "draw_two", count: 2),
              ],
            )),
          ], yields: []), target_bindings: [])),
          modal: None, targeting: None, may: false, intervening_if: None,
          triggers_only_once: false, max_triggers_per_turn: None,
        ),
      ))),
    (id: "create_caster_draw_trigger",
      kind: Perform(CreateDelayedTrigger(
        subject: None,
        ability: (
          ability_id: "delayed_02",
          presentation: OracleLines([2]),
          trigger: AtBeginningOfNextTurnUpkeep,
          effect: [Draw(count: 1)],
        ),
      ))),
  ], yields: []), target_bindings: [
    (instruction_id: "counter_spell", role: Spell, target_group_index: 0),
  ])),
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target spell",
    effect_indices: [],
  )])),
)
