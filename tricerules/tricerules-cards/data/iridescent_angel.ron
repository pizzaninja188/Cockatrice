  name: "Iridescent Angel",
  face_id: "iridescent_angel",
  mana_cost: "{5}{W}{U}",
  types: ["Creature", "Angel"],
  power: 4,
  toughness: 4,
  keywords: [Flying],
  protections: [Color(White), Color(Blue), Color(Black), Color(Red), Color(Green)],
