// Oracle 1b388371-f9ef-45b4-82a3-ca20a8cd7807; source/rulings checked 2026-11-23 against the
// pinned Scryfall bulk SHA-256 a9a2fd3b550cc5cff4cec9bbc82aaf5fb8e3f781b4b95a896a0d94c15dce7853.
// CR 701.6a (counter), 113.6g (an ability that says it can't be countered functions on the stack) and
// 115.1 (a noncreature spell is the target). The pinned 2021-03-19 ruling confirms a counterspell
// may still target it and any additional effects of that spell still happen. Copy of the reviewed
// long_goodbye static plus negate's noncreature filter.
(
  id: "dovins_veto",
  name: "Dovin's Veto",
  face_id: "dovins_veto",
  mana_cost: "{W}{U}",
  types: ["Instant"],
  static_abilities: [(
    ability_id: "static_01",
    presentation: OracleLines([1]),
    definition: SpellCannotBeCountered,
  )],
  spell_effect: [CounterTargetSpell(spell_filter: (card_type: Some(Noncreature)))],
)
