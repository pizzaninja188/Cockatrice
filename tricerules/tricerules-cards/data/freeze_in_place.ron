(
  id: "freeze_in_place",
  name: "Freeze in Place",
  face_id: "freeze_in_place",
  mana_cost: "{1}{U}",
  types: ["Sorcery"],
  spell_effect: [
    Tap(subject: Chosen((kind: Creature, controller: Opponent))),
