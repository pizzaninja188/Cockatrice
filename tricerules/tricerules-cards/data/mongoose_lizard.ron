// Oracle and rulings checked against Scryfall on 2026-08-26; there are no card-specific rulings.
(
  id: "mongoose_lizard",
  name: "Mongoose Lizard",
  mana_cost: "{4}{R}{R}",
  types: ["Creature", "Mongoose", "Lizard"],
  power: 5,
  toughness: 6,
  keywords: [Menace],
  triggered_abilities: [(
    trigger: WhenSelfEntersBattlefield,
    effect: [DamageTarget(amount: 1, target: (kind: AnyTarget))],
    text: "When this creature enters, it deals 1 damage to any target.",
  )],
  activated_abilities: [(
    source_zone: Hand,
    costs: [Mana("{2}"), DiscardSelf],
    effect: [SearchLibrary(
      filter: Some((subtype: Some("Mountain"))),
      destination: Hand,
      shuffle: true,
      reveal: true,
    )],
    text: "Mountaincycling {2}",
  )],
)
