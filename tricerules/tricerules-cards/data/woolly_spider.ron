(
  id: "woolly_spider",
  name: "Woolly Spider",
  face_id: "woolly_spider",
  mana_cost: "{1}{G}{G}",
  types: ["Creature", "Spider"],
  power: 2,
  toughness: 3,
  keywords: [Reach],
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: OracleLines([2]),
      trigger: WheneverSelfBlocksCreature(attacker: (required_keywords: [Flying])),
      effect: [PumpTarget(power: 0, toughness: 2, subject: Source)],
    ),
  ],
)
