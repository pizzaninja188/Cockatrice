(
  id: "vaynes_treachery",
  name: "Vayne's Treachery",
  face_id: "vaynes_treachery",
  mana_cost: "{1}{B}",
  types: ["Instant"],
  cast_cost_groups: [(
    group_id: "kicker",
    presentation: OracleLines([1]),
    min: 0,
    max: 1,
    options: [SacrificePermanent(
      option_id: "sacrifice_kicker",
      presentation: OracleLines([1]),
      kind: Kicker,
      filter: (any_of: Some([
        (kind: AnyPermanent, controller: You, permanent_types: [Artifact]),
        (kind: Creature, controller: You),
      ])),
    )],
  )],
  spell_effect: [
    PumpTarget(power: -2, toughness: -2, subject: Chosen((kind: Creature))),
    ConditionalCastCost(
      condition: (group_id: "kicker", option_id: "sacrifice_kicker", expected_selected: true),
      effect: PumpTarget(power: -4, toughness: -4, subject: Chosen((kind: Creature))),
    ),
  ],
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target creature",
    effect_indices: [0, 1],
  )])),
)
