// Oracle and rulings checked against Scryfall on 2026-08-27.
(
  id: "vengeful_tracker",
  name: "Vengeful Tracker",
  mana_cost: "{1}{R}",
  types: ["Creature", "Human", "Detective"],
  power: 2,
  toughness: 2,
  triggered_abilities: [(
    trigger: WheneverPlayerSacrificesPermanent(
      player: Opponent,
      filter: (permanent_type: Some(Artifact)),
    ),
    effect: [DamagePlayer(amount: 2, who: AffectedPlayer)],
    text: "Whenever an opponent sacrifices an artifact, this creature deals 2 damage to that player.",
  )],
)
