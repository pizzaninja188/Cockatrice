// Oracle 86851bdb-9b2f-4407-97a1-a6a9f2e0ef66, CMM729.
// https://magic.wizards.com/en/news/feature/commander-masters-release-notes
// CR603.7c / 702.26: retained delayed cohort and ordinary untap return.
// CR601.2c / 602.2b / 608.2b / 707.10: fixed per-opponent target roles and copies.
// CR205.1b / 611.2a / 613: persistent animation retains other types and abilities.
(
    id: "vronos,_masked_inquisitor",
    name: "Vronos, Masked Inquisitor",
    face_id: "vronos_masked_inquisitor",
    mana_cost: "{3}{U}{U}",
    supertypes: ["Legendary"],
    types: ["Planeswalker", "Vronos"],
    loyalty: 5,
    activated_abilities: [(
        ability_id: "activated_01", presentation: OracleLines([1]),
        costs: [Loyalty(1)],
        targeting: Some((groups: [(
            min: 0, max: 2, prompt: "Choose up to two other planeswalkers you control", effect_indices: [0],
        )])),
        effect: [CreateDelayedTrigger(
            subject: Some(Chosen((kind: AnyPermanent, controller: You,
                permanent_types: [Planeswalker], excluded_objects: [Source]))),
            ability: (ability_id: "delayed_phase_out", presentation: OracleLines([1]),
                trigger: AtBeginningOfNextEndStep, effect: [PhaseOutObservedObjects]),
        )],
    ), (
        ability_id: "activated_02", presentation: OracleLines([2]),
        costs: [Loyalty(-2)],
        targeting: Some((groups: [(
            min: 0, max: 1, prompt: "Choose up to one nonland permanent", effect_indices: [0],
            for_each_opponent: true,
        )])),
        effect: [ReturnToOwnersHand(subject: Chosen((kind: AnyPermanent, controller: Opponent,
            excluded_permanent_types: [Land])))],
    ), (
        ability_id: "activated_03", presentation: OracleLines([3]),
        costs: [Loyalty(-7)],
        targeting: Some((groups: [(
            min: 1, max: 1, prompt: "Choose target artifact you control", effect_indices: [0, 1, 2, 3, 4],
        )])),
        effect: [
            ApplyPermanentModifier(subject: Chosen((kind: AnyPermanent, controller: You, permanent_types: [Artifact])),
                modifier: AddTypes((card_types: [Artifact, Creature])), duration: Indefinite),
            ApplyPermanentModifier(subject: Chosen((kind: AnyPermanent, controller: You, permanent_types: [Artifact])),
                modifier: SetCreatureTypes(["Construct"]), duration: Indefinite),
            ApplyPermanentModifier(subject: Chosen((kind: AnyPermanent, controller: You, permanent_types: [Artifact])),
                modifier: SetBasePowerToughness(power: 9, toughness: 9), duration: Indefinite),
            ApplyPermanentModifier(subject: Chosen((kind: AnyPermanent, controller: You, permanent_types: [Artifact])),
                modifier: GrantKeywords([Vigilance, Indestructible]), duration: Indefinite),
            ApplyPermanentModifier(subject: Chosen((kind: AnyPermanent, controller: You, permanent_types: [Artifact])),
                modifier: GrantCantBeBlocked, duration: Indefinite),
        ],
    )],
)
