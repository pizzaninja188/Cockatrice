// Bonecrusher Giant // Stomp (Throne of Eldraine) — Adventure, CR 715.
// The Adventure lifecycle and both faces' Oracle text are implemented by the engine.
(
    id: "bonecrusher_giant_stomp",
    name: "Bonecrusher Giant // Stomp",
    layout: Adventure,
    faces: [
        (
            name: "Bonecrusher Giant",
            mana_cost: "{2}{R}",
            types: ["Creature", "Giant"],
            power: 4,
            toughness: 3,
            triggered_abilities: [
                (
                    trigger: WheneverSelfBecomesTarget(
                        source: Spell,
                        source_controller: AnyPlayer,
                    ),
                    effect: [DamagePlayer(amount: 2, who: AffectedPlayer)],
                    text: "Whenever this creature becomes the target of a spell, this creature deals 2 damage to that spell's controller.",
                ),
            ],
        ),
        (
            name: "Stomp",
            mana_cost: "{1}{R}",
            types: ["Instant"],
            spell_effect: [
                DamageCantBePreventedThisTurn,
                DamageTarget(amount: 2, target: (kind: AnyTarget)),
            ],
        ),
    ],
)
