// Fire // Ice (Apocalypse) — split card, CR 709. Each half is an independently castable
// instant; the engine picks the half via CastSpell.face_index.
(
    id: "fire_ice",
    name: "Fire // Ice",
    layout: Split,
    faces: [
        (
            name: "Fire",
            face_id: "fire",
            mana_cost: "{1}{R}",
            types: ["Instant"],
            // CR 601.2d: fixed total (2), no per-target surcharge, max 2 targets.
            spell_effect: [DamageTargets(
                amount: 2,
                target: (kind: AnyTarget),
                division: ChooseAtCast,
                extra_mana_per_target: 0,
            )],
            targeting: Some((groups: [(
                min: 1,
                max: 2,
                prompt: "Choose one or two targets",
                effect_indices: [0],
            )])),
        ),
        (
            name: "Ice",
            face_id: "ice",
            mana_cost: "{1}{U}",
            types: ["Instant"],
            spell_effect: [Tap(subject: Chosen((kind: AnyPermanent))), Draw(count: 1)],
        ),
    ],
)
