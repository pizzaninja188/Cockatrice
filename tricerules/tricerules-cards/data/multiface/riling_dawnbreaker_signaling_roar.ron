// Riling Dawnbreaker // Signaling Roar (Tarkir: Dragonstorm) — Omen, CR 720.
(
  id: "riling_dawnbreaker_signaling_roar",
  name: "Riling Dawnbreaker // Signaling Roar",
  layout: Omen,
  faces: [
    (
      name: "Riling Dawnbreaker",
      mana_cost: "{4}{W}",
      types: ["Creature", "Dragon"],
      power: 3,
      toughness: 4,
      keywords: [Flying, Vigilance],
      triggered_abilities: [(
        trigger: AtBeginningOfCombat(player: Controller),
        effect: [PumpTarget(
          power: 1,
          toughness: 0,
          subject: Chosen((kind: Creature, controller: You, excluded_objects: [Source])),
        )],
        text: "At the beginning of combat on your turn, another target creature you control gets +1/+0 until end of turn.",
      )],
    ),
    (
      name: "Signaling Roar",
      mana_cost: "{1}{W}",
      types: ["Sorcery", "Omen"],
      spell_effect: [CreateTokens(token: "soldier_w_2_2", count: 1)],
    ),
  ],
)
