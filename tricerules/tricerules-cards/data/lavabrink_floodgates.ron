// 701.21a, 122.2, 400.7, 120.4b, 616.1e-f, and 800.4g govern upkeep choice and resolution.
(
  id: "lavabrink_floodgates",
  name: "Lavabrink Floodgates",
  face_id: "lavabrink_floodgates",
  mana_cost: "{3}{R}",
  types: ["Artifact"],
  activated_abilities: [(
    ability_id: "activated_01",
    presentation: OracleLines([1]),
    costs: [Tap],
    effect: [ProduceMana(options: [(r: 2)])],
  )],
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([2]),
    trigger: AtBeginningOfUpkeep(player: AnyPlayer),
    effect: [],
    program: Some((body: (steps: [
      (id: "choose_doom_change", kind: Choose(
        choice: "doom_change",
        chooser: AffectedPlayer,
        optional: true,
        branches: [
          (branch_id: "add_doom_counter", presentation: Fallback, cost: None,
            requirement: GameCondition(ObjectMatches(
              object: Source,
              filter: (kind: AnyPermanent),
            )),
            body: (steps: [(id: "add_doom", kind: Perform(PutCounters(
              counter: Doom, count: 1, subject: Source,
            )))], yields: [])),
          (branch_id: "remove_doom_counter", presentation: Fallback, cost: None,
            requirement: GameCondition(AllOf([
              ObjectMatches(object: Source, filter: (kind: AnyPermanent)),
              SourceCounterCount(counter: Doom, min: Some(1)),
            ])),
            body: (steps: [(id: "remove_doom", kind: Perform(RemoveCounters(
              counter: Doom, count: 1, subject: Source,
            )))], yields: [])),
        ],
        otherwise: (steps: [], yields: []),
      )),
      (id: "check_doom_threshold", kind: If(
        condition: SourceCounterCount(counter: Doom, min: Some(3)),
        yes: (steps: [
          (id: "sacrifice_source", bind: ["sacrificed"], kind: Perform(
            Sacrifice(subject: Source),
          )),
          (id: "create_reflexive_damage", input: Some("sacrificed"), kind: Perform(
            CreateReflexiveTrigger(
              when: Some(Sacrificed(object: Source)),
              ability: (
                ability_id: "reflexive_01",
                // This is the reflexive damage fragment of the source's upkeep ability.
                presentation: Fallback,
                effect: [DamageAll(amount: 6, players: All, kind: (kind: Creature))],
              ),
            ),
          )),
        ], yields: []),
        no: (steps: [], yields: []),
      )),
    ], yields: []), target_bindings: [])),
  )],
)
