// The graveyard card-type condition is reevaluated continuously.
(
  id: "spineseeker_centipede",
  name: "Spineseeker Centipede",
  face_id: "spineseeker_centipede",
  mana_cost: "{2}{G}",
  types: ["Creature", "Insect"],
  power: 2,
  toughness: 1,
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: OracleLines([1]),
      trigger: WhenSelfEntersBattlefield,
      effect: [
        SearchLibrary(
          filter: Some((card_type: Some(BasicLand))),
          destination: Hand,
          shuffle: true,
          reveal: true,
        ),
      ],
    ),
  ],
  static_abilities: [
    (ability_id: "static_01", presentation: Fallback, definition: ConditionalSelfModifier(
      condition: GraveyardAggregate(
        owners: Controller,
        aggregate: DistinctCardTypes,
        min: Some(4),
      ),
      delta_power: 1,
      delta_toughness: 2,
      keywords: [Vigilance],
    )),
  ],
)
