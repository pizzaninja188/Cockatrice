(
  id: "savor",
  name: "Savor",
  face_id: "savor",
  mana_cost: "{1}{B}",
  types: ["Instant"],
  spell_effect: [
    PumpTarget(power: -2, toughness: -2, subject: Chosen((kind: Creature))),
    CreateTokens(token: "food", count: 1),
  ],
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target creature",
    effect_indices: [0],
  )])),
)
