// The pinned 2016-04-08 rulings confirm Clue is an artifact type and one Clue cannot pay two costs.
// Copy of Mind Stone's mana ability plus a {4}, {T} investigate activation.
(
  id: "magnifying_glass",
  name: "Magnifying Glass",
  face_id: "magnifying_glass",
  mana_cost: "{3}",
  types: ["Artifact"],
  activated_abilities: [
    (
      ability_id: "activated_01",
      presentation: OracleLines([1]),
      costs: [Tap],
      effect: [ProduceMana(options: [(c: 1)])],
    ),
    (
      ability_id: "activated_02",
      presentation: OracleLines([2]),
      costs: [Mana("{4}"), Tap],
      effect: [CreateTokens(token: "clue", count: 1)],
    ),
  ],
)
