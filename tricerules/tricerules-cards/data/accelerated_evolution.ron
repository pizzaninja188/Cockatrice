(
  id: "accelerated_evolution",
  name: "Accelerated Evolution",
  face_id: "accelerated_evolution",
  mana_cost: "{2}{G}",
  types: ["Enchantment", "Aura"],
  keywords: [Flash],
  spell_effect: [AuraAttach(target: (kind: Creature, controller: You))],
  triggered_abilities: [
