// Oracle and rulings verified 2026-09-01. The third mode creates a one-shot
// base-P/T continuous effect; later modifiers and counters still apply.
(
  id: "quandrix_charm",
  name: "Quandrix Charm",
  face_id: "quandrix_charm",
  mana_cost: "{G}{U}",
  types: ["Instant"],
  modal_spell: (
    min_modes: 1,
    max_modes: 1,
    modes: [
      (
        mode_id: "mode_01",
        presentation: OracleLines([2]),
        effects: [CounterTargetSpell(spell_filter: None, unless_controller_pays: Some(2))],
      ),
      (
        mode_id: "mode_02",
        presentation: OracleLines([3]),
        effects: [Destroy(subject: Chosen((kind: AnyPermanent, permanent_types: [Enchantment])))],
      ),
      (
        mode_id: "mode_03",
        presentation: OracleLines([4]),
        effects: [SetBasePowerToughness(
          target: (kind: Creature),
          power: Fixed(5),
          toughness: Fixed(5),
        )],
      ),
    ],
  ),
)
