(
  id: "curse_of_opulence",
  name: "Curse of Opulence",
  mana_cost: "{R}",
  types: ["Enchantment", "Aura", "Curse"],
  spell_effect: [AuraAttach(target: (kind: AnyPlayer))],
  triggered_abilities: [(
    trigger: WheneverAttachedPlayerIsAttacked,
    effect: [
      CreateTokens(token: "gold", count: 1),
      CreateTokens(token: "gold", count: 1, who: AttackingOpponentsOfDefendingPlayer),
    ],
    text: "Whenever enchanted player is attacked, create a Gold token. Each opponent attacking that player does the same.",
  )],
)
