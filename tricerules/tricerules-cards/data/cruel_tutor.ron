// CR 701.23 (search), 701.23d-e (search quantity and no reveal) and 701.24 (shuffle), then put the chosen card on top, 119.3 (lose
// 2 life) and 608.2 (resolution order). The search choice is private; the card put on top
// is not revealed. The pinned Vampiric Tutor ruling makes the shuffle-and-top action one
// action, so an already face-up top card does not reveal the second card.

(
  id: "cruel_tutor",
  name: "Cruel Tutor",
  face_id: "cruel_tutor",
  mana_cost: "{2}{B}",
  types: ["Sorcery"],
  spell_program: Some((body: (steps: [
    (id: "search_top", kind: Perform(SearchLibrary(
      zones: Fixed([Library]),
      destination: TopOfLibrary,
      selection_bounds: Some((min: 1, max: 1)),
    ))),
    (id: "lose_life", kind: Perform(LoseLife(amount: Fixed(2), who: Controller))),
  ]))),
)
