// Oracle and rulings checked 2026-09-08. CR 608.2c/h: determine the replacement instruction
// from the current graveyard once, before parking the private selection. CR 121.5: not drawing.
(
  id: "flow_state",
  name: "Flow State",
  face_id: "flow_state",
  mana_cost: "{1}{U}",
  types: ["Sorcery"],
  spell_program: Some((body: (steps: [
    (id: "graveyard_gate",
     kind: If(
       condition: AllOf([
         GraveyardAggregate(
           owners: Controller, aggregate: CardCount,
           filter: Some((card_type: Some(Instant))), min: Some(1),
         ),
         GraveyardAggregate(
           owners: Controller, aggregate: CardCount,
           filter: Some((card_type: Some(Sorcery))), min: Some(1),
         ),
       ]),
       yes: (steps: [
         (id: "take_two",
          kind: Perform(LookChooseToHand(
            count: 3, min: 2, max: 2,
            reveal: false, bottom_order: Chosen,
          ))),
       ]),
       no: (steps: [
         (id: "take_one",
          kind: Perform(LookChooseToHand(
            count: 3, min: 1,
            reveal: false, bottom_order: Chosen,
          ))),
       ]),
     )),
  ]))),
)
