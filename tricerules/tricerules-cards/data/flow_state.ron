// Oracle and rulings checked 2026-09-08. CR 608.2c/h: determine the replacement instruction
// from the current graveyard once, before parking the private selection. CR 121.5: not drawing.
(
  id: "flow_state",
  name: "Flow State",
  face_id: "flow_state",
  mana_cost: "{1}{U}",
  types: ["Sorcery"],
  spell_effect: [ChooseResolutionBranch(
    selection: FirstApplicable,
    branches: [
      (
        branch_id: "take_two", presentation: OracleLines([1]), cost: None,
        requirement: GameCondition(AllOf([
          GraveyardAggregate(owners: Controller, aggregate: CardCount, filter: Some((card_type: Some(Instant))), min: Some(1)),
          GraveyardAggregate(owners: Controller, aggregate: CardCount, filter: Some((card_type: Some(Sorcery))), min: Some(1)),
        ])),
        effects: [LookChooseToHand(count: 3, min: 2, max: 2, reveal: false, bottom_order: Chosen)],
      ),
      (
        branch_id: "take_one", presentation: OracleLines([1]), cost: None, requirement: Always,
        effects: [LookChooseToHand(count: 3, min: 1, max: 1, reveal: false, bottom_order: Chosen)],
      ),
    ],
  )],
)
