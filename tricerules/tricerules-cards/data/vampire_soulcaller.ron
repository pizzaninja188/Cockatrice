// Oracle and rulings checked against Scryfall on 2026-08-19; there are no card-specific rulings.
// CR 509.1b: a creature that can't block is an illegal declared blocker.
(
  id: "vampire_soulcaller",
  name: "Vampire Soulcaller",
  face_id: "vampire_soulcaller",
  mana_cost: "{4}{B}",
  types: ["Creature", "Vampire", "Warlock"],
  power: 3,
  toughness: 2,
  keywords: [Flying],
  static_abilities: [(ability_id: "static_01", presentation: Fallback, definition: SelfCombatRestriction(restriction: (cant_block: true)))],
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: OracleLines([3]),
      trigger: WhenSelfEntersBattlefield,
      effect: [MoveGraveyardCards(filter: (owner: Controller, card_type: Some(Creature)), destination: Hand)],
    ),
  ],
)
