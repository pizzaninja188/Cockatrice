// Create a 1/1 green Snake creature token, a 2/2 green Wolf creature token,
// and a 3/3 green Elephant creature token.
(
  id: "bestial_menace",
  name: "Bestial Menace",
  face_id: "bestial_menace",
  mana_cost: "{3}{G}{G}",
  types: ["Sorcery"],
  spell_effect: [
    CreateTokens(token: "snake_g_1_1", count: 1),
    CreateTokens(token: "wolf_g_2_2", count: 1),
    CreateTokens(token: "elephant_g_3_3", count: 1),
  ],
)
