// Create a 1/1 green Snake creature token, a 2/2 green Wolf creature token,
// and a 3/3 green Elephant creature token.
(
  id: "bestial_menace",
  name: "Bestial Menace",
  mana_cost: "{3}{G}{G}",
  types: ["Sorcery"],
  spell_effect: [
    CreateTokens(token: "snake", count: 1),
    CreateTokens(token: "wolf", count: 1),
    CreateTokens(token: "elephant", count: 1),
  ],
)
