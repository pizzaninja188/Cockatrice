// Oracle and ruling checked 2026-08-13. CR 106.6 keeps the mana red while restricting what it
// may pay for; the Chandra planeswalker restriction means subtype Chandra, not a name or illustration.
(
  id: "chandras_embercat",
  name: "Chandra's Embercat",
  face_id: "chandra_s_embercat",
  mana_cost: "{1}{R}",
  types: ["Creature", "Elemental", "Cat"],
  power: 2,
  toughness: 2,
  activated_abilities: [
    (
      ability_id: "activated_01",
      presentation: OracleLines([1]),
      costs: [Tap],
      effect: [ProduceMana(
        options: [(r: 1)],
        restriction: Some((
          restriction_id: "restriction_01",
          presentation: OracleLines([1]),
          cast_spell: [
            (subtype: Some("Elemental")),
            (card_type: Some(Planeswalker), subtype: Some("Chandra")),
          ],
        )),
      )],
    ),
  ],
)
