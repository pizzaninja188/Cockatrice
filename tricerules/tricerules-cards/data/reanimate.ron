(
  id: "reanimate",
  name: "Reanimate",
  mana_cost: "{B}",
  types: ["Sorcery"],
  // "from a graveyard" — any player's (GraveyardOwner::AnyPlayer), entering under the caster's
  // control (CR 110.2). LoseLife is untargeted and reads the mana value of the same target the
  // MoveGraveyardCards declared, so the two must stay in one effect list.
  spell_effect: [
    MoveGraveyardCards(filter: (owner: AnyPlayer, card_type: Some(Creature)), destination: Battlefield(tapped: false)),
    LoseLife(amount: TargetManaValue),
  ],
)
