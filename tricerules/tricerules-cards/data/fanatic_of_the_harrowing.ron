// Oracle and CR 101.4/701.9 checked 2026-08-24. Hidden hand choices are collected in APNAP
// order, the complete discard action is applied, then the exact resulting cohort is inspected.
(
  id: "fanatic_of_the_harrowing",
  name: "Fanatic of the Harrowing",
  face_id: "fanatic_of_the_harrowing",
  mana_cost: "{3}{B}",
  types: ["Creature", "Human", "Cleric"],
  power: 2,
  toughness: 2,
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([1]),
    trigger: WhenSelfEntersBattlefield,
    effect: [
      Discard(who: EachPlayer, count: 1),
      ChooseResolutionBranch(
        selection: FirstApplicable,
        branches: [
          (
            branch_id: "draw_a_card", presentation: Fallback,
            cost: None,
            requirement: CardResultCount(
              filter: (
                source: PreviousEffect,
                action: Discard,
                players: Controller,
              ),
              min: Some(1),
            ),
            effects: [Draw(count: 1)],
          ),
          (
            branch_id: "do_not_draw", presentation: Fallback,
            cost: None,
            requirement: Always,
            effects: [],
          ),
        ],
      ),
    ],
  )],
)
