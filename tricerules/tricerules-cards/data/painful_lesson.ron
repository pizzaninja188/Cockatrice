(
  id: "painful_lesson",
  name: "Painful Lesson",
  face_id: "painful_lesson",
  mana_cost: "{2}{B}",
  types: ["Sorcery"],
  spell_effect: [
    TargetPlayerDraws(count: 2, target: (kind: AnyPlayer)),
