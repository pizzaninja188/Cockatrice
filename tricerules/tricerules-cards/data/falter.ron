  name: "Falter",
  face_id: "falter",
  mana_cost: "{1}{R}",
  types: ["Instant"],
  spell_effect: [
    ApplyCombatRestriction(
      scope: Matching((kind: Creature, excluded_keywords: [Flying])),
      restriction: (cant_block: true),
