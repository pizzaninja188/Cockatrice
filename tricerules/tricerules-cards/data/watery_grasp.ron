// Oracle and Waterbend rulings verified 2026-08-29. The move is untargeted and uses the
// enchanted creature's owner for both library placement and shuffle.
(
  id: "watery_grasp",
  name: "Watery Grasp",
  face_id: "watery_grasp",
  mana_cost: "{U}",
  types: ["Enchantment", "Aura"],
  spell_effect: [AuraAttach(target: (kind: Creature))],
  static_abilities: [(ability_id: "static_01", presentation: Fallback, definition: AttachedModifier(doesnt_untap_during_untap_step: true))],
  activated_abilities: [(
    ability_id: "activated_01",
    presentation: Fallback,
    costs: [Waterbend("{5}")],
    effect: [PutInOwnersLibrary(subject: AttachedObject, placement: Shuffle)],
  )],
)
