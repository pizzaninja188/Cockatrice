(
  id: "evolving_wilds",
  name: "Evolving Wilds",
  mana_cost: "",
  types: ["Land"],
  activated_abilities: [
    (
      costs: [Tap, SacrificeSelf],
      effect: [
        SearchLibrary(
          filter: Some(BasicLand),
          destination: Battlefield(tapped: true),
          shuffle: true,
          reveal: false,
        ),
      ],
      text: "{T}, Sacrifice this land: Search your library for a basic land card, put it onto the battlefield tapped, then shuffle.",
    ),
  ],
)
