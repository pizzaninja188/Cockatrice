// 701.8 (destroy) and 121.1 (draw). The pinned 2017-09-29 ruling: an illegal target means no
// draw; a legal indestructible target still draws.
// Copy of Immolating Glare's target plus Slice in Twain's draw.
(
  id: "bright_reprisal",
  name: "Bright Reprisal",
  face_id: "bright_reprisal",
  mana_cost: "{4}{W}",
  types: ["Instant"],
  spell_effect: [
    Destroy(subject: Chosen((kind: Creature, combat_role: Attacking))),
    Draw(count: 1),
  ],
  targeting: Some((groups: [(
    min: 1, max: 1,
    prompt: "Choose target attacking creature",
    effect_indices: [0],
  )])),
)
