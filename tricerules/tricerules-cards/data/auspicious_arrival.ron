// CR 608.2b-c and 701.16: recheck the target, pump it, then investigate by creating one Clue.
(
  id: "auspicious_arrival",
  name: "Auspicious Arrival",
  face_id: "auspicious_arrival",
  mana_cost: "{1}{W}",
  types: ["Instant"],
  spell_effect: [
    PumpTarget(power: 2, toughness: 2, subject: Chosen((kind: Creature))),
    CreateTokens(token: "clue", count: 1),
  ],
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target creature",
    effect_indices: [0],
  )])),
)
