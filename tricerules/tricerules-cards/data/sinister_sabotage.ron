// CR 701.6 (counter), 701.25 (surveil), 608.2b (a stale sole target makes the spell not resolve,
// so the rider does not happen) and 608.2c (printed order: counter, then surveil). The 2018-10-05
// ruling confirms a spell that can't be countered is still a legal target and the surveil happens.
// Copy of the reviewed dissolve counter-then-scry shape with the surveil partition.
(
  id: "sinister_sabotage",
  name: "Sinister Sabotage",
  face_id: "sinister_sabotage",
  mana_cost: "{1}{U}{U}",
  types: ["Instant"],
  spell_effect: [
    CounterTargetSpell(),
    LibraryPartition(count: 1, top_min: 0, top_max: None, kind: Surveil),
  ],
)
