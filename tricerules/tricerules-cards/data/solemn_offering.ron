  name: "Solemn Offering",
  face_id: "solemn_offering",
  mana_cost: "{2}{W}",
  types: ["Sorcery"],
  spell_effect: [
    Destroy(subject: Chosen((kind: AnyPermanent, permanent_types: [Artifact, Enchantment]))),
    GainLife(amount: 4),
