(
  id: "aven_wind_mage",
  name: "Aven Wind Mage",
  mana_cost: "{2}{U}",
  types: ["Creature", "Bird", "Wizard"],
  power: 2,
  toughness: 2,
  keywords: [Flying],
  triggered_abilities: [
    (
      trigger: WheneverPlayerCastsSpell(
        caster: Controller,
        spell_type: Some(InstantOrSorcery),
