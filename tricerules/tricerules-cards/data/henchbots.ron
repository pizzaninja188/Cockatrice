(
  id: "henchbots",
  name: "Henchbots",
  face_id: "henchbots",
  mana_cost: "{4}",
  types: ["Artifact", "Creature", "Robot"],
  power: 2,
  toughness: 3,
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([1]),
    trigger: WhenSelfEntersBattlefield,
    effect: [ExileUntilSourceLeaves(target: (
      kind: Creature,
      tapped: Some(true),
