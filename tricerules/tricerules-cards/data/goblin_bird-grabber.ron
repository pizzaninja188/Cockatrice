(
  id: "goblin_bird-grabber",
  name: "Goblin Bird-Grabber",
  mana_cost: "{1}{R}",
  types: ["Creature", "Goblin"],
  power: 2,
  toughness: 1,
  activated_abilities: [
    (
      costs: [Mana("{R}")],
      effect: [GrantKeywords(subject: Source, keywords: [Flying])],
      conditions: [BattlefieldCreatureCount(
        filter: (controllers: Controller, required_keywords: [Flying]),
        min: Some(1),
        max: None,
      )],
      text: "{R}: This creature gains flying until end of turn. Activate only if you control a creature with flying.",
    ),
  ],
)
