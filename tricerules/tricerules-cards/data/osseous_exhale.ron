          cost: None,
          requirement: CastCostReceipt((
            group_id: "cast_cost_01",
            option_id: "option_01",
          )),
          body: (steps: [
            (id: "gain_two_life", kind: Perform(GainLife(amount: 2))),
          ]),
        ),
        (
          branch_id: "no_dragon_beheld",
          presentation: Fallback,
          cost: None,
          requirement: CastCostReceipt((
            group_id: "cast_cost_01",
            option_id: "option_01",
            expected_selected: false,
          )),
          body: (),
        ),
      ],
      otherwise: (),
    )),
  ]), target_bindings: [
    (instruction_id: "damage_target", role: Target, target_group_index: 0),
  ])),
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target attacking or blocking creature",
    effect_indices: [],
  )])),
)
