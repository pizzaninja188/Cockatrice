// Oracle verified 2026-08-29. CR 701.17c: mill moves a card from a library to its owner's graveyard.
// Optional return uses only this Mill's exact, committed, live, face-up public output incarnations.
(
  id: "midnight_tilling",
  name: "Midnight Tilling",
  face_id: "midnight_tilling",
  mana_cost: "{1}{G}",
  types: ["Instant"],
  spell_program: Some((body: (steps: [
    (id: "mill", bind: ["milled"],
      kind: Perform(Mill(count: 4))),
    (id: "recover", input: Some("milled"),
      kind: Perform(ChooseCard(
        source: CardResultCohort(players: Controller),
        filter: (any_of: Some([
          (card_type: Some(Land)),
          (card_type: Some(NonlandPermanent)),
        ])),
        destination: Hand,
        optional: true,
      ))),
  ]))),
)
