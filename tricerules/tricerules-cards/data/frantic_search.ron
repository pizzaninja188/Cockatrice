// Oracle and rulings checked 2026-10-12: https://scryfall.com/card/tle/159/frantic-search
// Lands are chosen during resolution, may belong to any player, and are not targets.
(
  id: "frantic_search",
  name: "Frantic Search",
  face_id: "frantic_search",
  mana_cost: "{2}{U}",
  types: ["Instant"],
  spell_program: Some((body: (
    steps: [
      (id: "draw_two", kind: Perform(Draw(who: Controller, count: 2))),
      (id: "discard_two", kind: Perform(Discard(who: Controller, quantity: Exact(2)))),
      (id: "choose_lands", bind: ["lands"], kind: Perform(ChoosePermanents(
        chooser: Controller,
        filter: (kind: AnyPermanent, permanent_types: [Land]),
        min: 0,
        max: 3,
      ))),
      (id: "untap_lands", input: Some("lands"), kind: Perform(UntapChosenPermanents)),
    ],
    yields: [],
  ))),
)
