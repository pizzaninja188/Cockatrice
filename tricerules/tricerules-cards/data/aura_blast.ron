// CR 701.8 (destroy), 115.1/601.2c (target at cast), 608.2b (a stale sole target makes the whole
// spell not resolve, so the draw does not happen) and 121.1 (draw). Pinned 2004-10-04 rulings:
// no draw if it is countered or the target is illegal; the draw still happens if the enchantment
// regenerates. Copy of the reviewed cursebreak destruction plus a draw.
(
  id: "aura_blast",
  name: "Aura Blast",
  face_id: "aura_blast",
  mana_cost: "{1}{W}",
  types: ["Instant"],
  spell_effect: [
    Destroy(subject: Chosen((kind: AnyPermanent, permanent_types: [Enchantment]))),
    Draw(count: 1),
  ],
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target enchantment",
    effect_indices: [0],
  )])),
)
