// CR 113.10 and 602.2 (a granted activated ability belongs to each affected permanent) and
// CR 611.3a/613.4c (the pump is cumulative). The pinned 2013-07-01 rulings confirm cumulative
// grants and that a creature that stops being a Sliver stops receiving its own grant.
(
  id: "spectral_sliver",
  name: "Spectral Sliver",
  face_id: "spectral_sliver",
  mana_cost: "{2}{B}",
  types: ["Creature", "Sliver", "Spirit"],
  power: 2,
  toughness: 2,
  static_abilities: [(
    ability_id: "static_01",
    presentation: OracleLines([1]),
    definition: GrantActivatedAbilityToPermanents(
      filter: (kind: Creature, required_subtypes: ["Sliver"]),
      activated_abilities: [(
        ability_id: "activated_01",
        presentation: Fallback,
        costs: [Mana("{2}")],
        effect: [PumpTarget(power: 1, toughness: 1, subject: Source)],
      )],
    ),
  )],
)
