// Oracle and Marvel Super Heroes rulings verified 2026-09-02. The counter instruction precedes
// the temporary keyword grant, matching the printed power-up ability.
(
  id: "hercules,_prince_of_power",
  name: "Hercules, Prince of Power",
  face_id: "hercules_prince_of_power",
  mana_cost: "{2}{G}",
  types: ["Creature", "Demigod", "Warrior", "Hero"],
  supertypes: ["Legendary"],
  power: 3,
  toughness: 3,
  activated_abilities: [(
    ability_id: "activated_01",
    presentation: OracleLines([1]),
    costs: [Mana("{4}{G}")],
    cost_modifiers: [ConditionalSourceManaCostReduction(condition: PermanentsEnteredThisTurn(
      controllers: All,
      filter: (source_only: true),
      min: Some(1),
    ))],
    effect: [
      PutCounters(counter: PlusOnePlusOne, count: 1, subject: Source),
      GrantKeywords(subject: Source, keywords: [Vigilance, Indestructible, Haste]),
    ],
    activation_limit: Some(PerObject(max_activations: 1)),
  )],
)
