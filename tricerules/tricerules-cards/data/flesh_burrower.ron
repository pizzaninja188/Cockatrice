(
  id: "flesh_burrower",
  name: "Flesh Burrower",
  mana_cost: "{1}{G}",
  types: ["Creature", "Insect"],
  power: 2,
  toughness: 2,
  keywords: [Deathtouch],
  triggered_abilities: [(
    trigger: WheneverSelfAttacks(minimum_other_attackers: 0),
    effect: [GrantKeywords(
      subject: Chosen((kind: Creature, controller: You, excluded_objects: [Source])),
      keywords: [Deathtouch],
    )],
    text: "Whenever this creature attacks, another target creature you control gains deathtouch until end of turn.",
  )],
)
