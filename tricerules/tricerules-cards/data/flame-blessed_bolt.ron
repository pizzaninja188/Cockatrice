// Oracle 6a521eed-0965-4fce-8a11-190dc2863da8; source/rulings checked 2026-11-21 against the pinned Scryfall bulk
// SHA-256 a9a2fd3b550cc5cff4cec9bbc82aaf5fb8e3f781b4b95a896a0d94c15dce7853.
// CR 115.1/601.2c (one creature-or-planeswalker target), 120.3 (damage), 614.1a
// (the turn-scoped exile replacement) and 608.2b (stale target). Pinned ruling: a creature or
// planeswalker dealt damage this way is exiled if it dies for any reason later in the turn.
(
  id: "flame-blessed_bolt",
  name: "Flame-Blessed Bolt",
  face_id: "flame_blessed_bolt",
  mana_cost: "{R}",
  types: ["Instant"],
  spell_effect: [
    DamageTarget(amount: 2, target: (any_of: Some([
      (kind: Creature),
      (kind: AnyPermanent, permanent_types: [Planeswalker]),
    ]))),
    ExileIfWouldDieThisTurn(target: (any_of: Some([
      (kind: Creature),
      (kind: AnyPermanent, permanent_types: [Planeswalker]),
    ]))),
  ],
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target creature or planeswalker",
    effect_indices: [0, 1],
  )])),
)
