  types: ["Artifact"],
  activated_abilities: [
    (
      ability_id: "activated_01",
      presentation: OracleLines([1]),
      source_zone: Battlefield,
      costs: [Tap],
      effect: [MillTargetPlayer(count: 1, target: (kind: AnyPlayer))],
    ),
    (
      ability_id: "activated_02",
      presentation: OracleLines([2]),
      source_zone: Battlefield,
      costs: [Mana("{5}"), Tap, SacrificeSelf],
      effect: [MoveGraveyardCards(
        filter: (owner: Controller),
        destination: Hand,
      )],
      targeting: Some((groups: [(
        min: 1,
        max: 1,
        prompt: "Choose target card from your graveyard",
        effect_indices: [0],
      )])),
    ),
  ],
