// Oracle and rulings checked 2026-10-18 against the pinned source set.
// CR 701.21a defines the optional sacrifice; CR 400.7/603.4/603.10a apply to Disappear.
(
  id: "west_wind_avatar",
  name: "West Wind Avatar",
  face_id: "west_wind_avatar",
  mana_cost: "{5}{G}{G}",
  types: ["Creature", "Cat", "Spirit", "Avatar"],
  power: 7,
  toughness: 7,
  keywords: [Trample],
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: OracleLines([2]),
      trigger: WhenSelfEntersBattlefield,
      program: Some((body: (steps: [
        (id: "choose_sacrifice", kind: Choose(
          choice: "sacrifice",
          chooser: Controller,
          optional: true,
          branches: [(
            branch_id: "sacrifice_a_token_or_land",
            presentation: OracleLines([2]),
            cost: SacrificePermanent(filter: (any_of: Some([
              (kind: AnyPermanent, controller: You, token: Some(true)),
              (kind: AnyPermanent, controller: You, permanent_types: [Land]),
            ]))),
            body: (steps: [
              (id: "gain_life", kind: Perform(GainLife(amount: 3))),
            ]),
          )],
          otherwise: (),
        )),
      ]))),
    ),
    (
      ability_id: "triggered_02",
      presentation: OracleLines([2]),
      trigger: WheneverSelfAttacks(minimum_other_attackers: 0),
      program: Some((body: (steps: [
        (id: "choose_sacrifice", kind: Choose(
          choice: "sacrifice",
          chooser: Controller,
          optional: true,
          branches: [(
            branch_id: "sacrifice_a_token_or_land",
            presentation: OracleLines([2]),
            cost: SacrificePermanent(filter: (any_of: Some([
              (kind: AnyPermanent, controller: You, token: Some(true)),
              (kind: AnyPermanent, controller: You, permanent_types: [Land]),
            ]))),
            body: (steps: [
              (id: "gain_life", kind: Perform(GainLife(amount: 3))),
            ]),
          )],
          otherwise: (),
        )),
      ]))),
    ),
    (
      ability_id: "triggered_03",
      presentation: OracleLines([3]),
      trigger: AtBeginningOfEndStep(),
      intervening_if: Some(PermanentLeftBattlefieldThisTurn(controllers: Controller)),
      program: Some((body: (steps: [
        (id: "draw", kind: Perform(Draw(count: 1))),
      ]))),
    ),
  ],
)
