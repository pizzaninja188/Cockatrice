// Howling Mine — CR 504.2 draw-step trigger with a CR 603.4 intervening-"if" clause.
// The additional card goes to the player whose draw step it is, not to the Mine's controller.
(
    id: "howling_mine",
    name: "Howling Mine",
    face_id: "howling_mine",
    mana_cost: "{2}",
    types: ["Artifact"],
    triggered_abilities: [
        (
            ability_id: "triggered_01",
            presentation: OracleLines([1]),
            trigger: AtBeginningOfDrawStep(player: AnyPlayer),
            intervening_if: Some(ObjectTapped(object: Source, tapped: false)),
            effect: [Draw(who: AffectedPlayer, count: 1)],
        ),
    ],
)
