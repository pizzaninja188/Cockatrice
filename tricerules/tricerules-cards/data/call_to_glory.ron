// CR 701.26 (untap) and 613.4c (layer-7c pump). The untap applies to every creature the controller
// controls at resolution; only current Samurai creatures get the pump. Copy of Rally to Battle's
// untap-plus-scoped-pump shape.
(
  id: "call_to_glory",
  name: "Call to Glory",
  face_id: "call_to_glory",
  mana_cost: "{1}{W}",
  types: ["Instant"],
  spell_effect: [
    UntapAll(players: Controller),
    PumpAll(
      filter: (controller: YouControl, matching: (kind: Creature, required_subtypes: ["Samurai"])),
      power: 1,
      toughness: 1,
    ),
  ],
)
