// Oracle verified 2026-08-29. CR 301.5/701.3: the temporary keyword is part of the ETB trigger.
(
  id: "squires_lightblade",
  name: "Squire's Lightblade",
  mana_cost: "{W}",
  types: ["Artifact", "Equipment"],
  keywords: [Flash],
  triggered_abilities: [(
    trigger: WhenSelfEntersBattlefield,
    effect: [
      AttachSource(target: (kind: Creature, controller: You)),
      GrantKeywords(subject: Chosen((kind: Creature, controller: You)), keywords: [FirstStrike]),
    ],
    text: "When this Equipment enters, attach it to target creature you control. That creature gains first strike until end of turn.",
  )],
  static_abilities: [AttachedModifier(delta_power: 1, delta_toughness: 0)],
  activated_abilities: [(
    costs: [Mana("{3}")],
    effect: [Equip(target: (kind: Creature, controller: You))],
    text: "Equip {3}",
  )],
)
