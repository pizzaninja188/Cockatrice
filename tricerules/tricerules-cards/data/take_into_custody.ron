(
  id: "take_into_custody",
  name: "Take into Custody",
  face_id: "take_into_custody",
  mana_cost: "{U}",
  types: ["Instant"],
  spell_effect: [
    Tap(subject: Chosen((kind: Creature))),
    SkipNextUntap(target: (kind: Creature)),
  ],
  targeting: Some((groups: [(min: 1, max: 1, effect_indices: [0, 1])])),
)
