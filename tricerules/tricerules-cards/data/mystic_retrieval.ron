// CR 115.1/601.2c (one instant-or-sorcery card target), 400.7 (new object on zone change),
// 404.1, 702.34a-d (flashback) and 608.2b. Pinned ruling: Mystic Retrieval cannot target itself
// because it is on the stack when its target is chosen.
// Copy of Call to Mind's filter plus Firebolt's flashback cost.
(
  id: "mystic_retrieval",
  name: "Mystic Retrieval",
  face_id: "mystic_retrieval",
  mana_cost: "{3}{U}",
  flashback_cost: Some("{2}{R}"),
  types: ["Sorcery"],
  spell_effect: [MoveGraveyardCards(
    filter: (card: Some((card_type: Some(InstantOrSorcery)))),
    destination: Hand,
    linked_exile_id: None,
  )],
)
