  name: "Jaspera Sentinel",
  face_id: "jaspera_sentinel",
  mana_cost: "{G}",
  types: ["Creature", "Elf", "Rogue"],
  power: 1,
  toughness: 2,
  keywords: [Reach],
  activated_abilities: [
    (
      ability_id: "any_color",
