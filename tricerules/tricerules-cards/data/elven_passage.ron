// Oracle and rulings checked against Scryfall on 2026-09-04.
// CR 118.3, 118.3b, 119.4, 608.2c, 701.4a, 701.20, 701.23, and 701.26a/b: life is paid atomically;
// Behold may use an Elf permanent or reveal an Elf card from hand, then untaps the found land.
(
  id: "elven_passage",
  name: "Elven Passage",
  face_id: "elven_passage",
  mana_cost: "",
  types: ["Land"],
  activated_abilities: [(
    ability_id: "activated_01",
    presentation: OracleLines([1]),
    costs: [Tap, PayLife(amount: 1), SacrificeSelf],
    effect: [],
    program: Some((body: (steps: [
      (id: "find_basic_land", bind: ["found_land"], kind: Perform(SearchLibrary(
        filter: Some((card_type: Some(BasicLand))),
        zones: Fixed([Library]),
        destination: Battlefield(tapped: true),
        selection_bounds: Some((min: 0, max: 1)),
      ))),
      (id: "behold_elf", input: Some("found_land"), kind: Perform(MayBehold(
        choice_id: "behold_elf",
        criterion: (required_subtype: "Elf"),
        if_beheld: [Untap(subject: PreviousEffectObject)],
      ))),
    ]))),
  )],
)
