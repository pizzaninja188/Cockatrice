// No pinned ruling. CR 701.8 (destroy), 111.1/111.10a (Treasure token creation and its mana
// ability), 115.1/601.2c (target at cast) and 608.2b (a stale sole target fizzles the whole
// spell, so no Treasure is created). Copy of the reviewed naturalize artifact-or-enchantment
// destruction plus brazen_freebooter's Treasure creation.
(
  id: "crack_open",
  name: "Crack Open",
  face_id: "crack_open",
  mana_cost: "{2}{G}",
  types: ["Sorcery"],
  spell_effect: [
    Destroy(subject: Chosen((
      any_of: Some([
        (kind: AnyPermanent, permanent_types: [Artifact]),
        (kind: AnyPermanent, permanent_types: [Enchantment]),
      ]),
    ))),
    CreateTokens(token: "treasure", count: 1),
  ],
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target artifact or enchantment",
    effect_indices: [0],
  )])),
)
