(
  id: "salvager_of_secrets",
  name: "Salvager of Secrets",
  mana_cost: "{3}{U}{U}",
  types: ["Creature", "Merfolk", "Wizard"],
  power: 2,
  toughness: 2,
  triggered_abilities: [
    (
      trigger: WhenSelfEntersBattlefield,
      effect: [ReturnFromGraveyard(filter: (owner: Controller, card_type: Some(InstantOrSorcery)), destination: Hand)],
      text: "When this creature enters, return target instant or sorcery card from your graveyard to your hand.",
    ),
  ],
)
