// replaced by the printed self loss.
(
  id: "anguished_unmaking",
  name: "Anguished Unmaking",
  face_id: "anguished_unmaking",
  mana_cost: "{1}{W}{B}",
  types: ["Instant"],
  spell_effect: [
    Exile(subject: Chosen((kind: AnyPermanent, excluded_permanent_types: [Land]))),
    LoseLife(amount: Fixed(3)),
  ],
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target nonland permanent",
    effect_indices: [0],
  )])),
)
