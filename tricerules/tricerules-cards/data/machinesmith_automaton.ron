// CR 702.19 (trample) and CR 603.6a/603.6d: "another artifact you control enters" watches any
// artifact permanent (the source is itself an artifact, excluded by exclude_source).
(
  id: "machinesmith_automaton",
  name: "Machinesmith Automaton",
  face_id: "machinesmith_automaton",
  mana_cost: "{2}{R}",
  types: ["Artifact", "Creature", "Robot", "Villain"],
  power: 2,
  toughness: 2,
  keywords: [Trample],
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([2]),
    trigger: WheneverPermanentEntersBattlefield(
      controller: Controller,
      filter: (permanent_type: Some(Artifact), exclude_source: true),
    ),
    effect: [PutCounters(counter: PlusOnePlusOne, count: 1, subject: Source)],
  )],
)
