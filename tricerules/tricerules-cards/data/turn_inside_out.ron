(
  id: "turn_inside_out",
  name: "Turn Inside Out",
  face_id: "turn_inside_out",
  mana_cost: "{R}",
  // The delayed trigger follows the exact battlefield object.
  types: ["Instant"],
  spell_effect: [
    PumpTarget(power: 3, toughness: 0, subject: Chosen((kind: Creature))),
    CreateDelayedTrigger(
      subject: Chosen((kind: Creature)),
      ability: (
        ability_id: "triggered_01",
        presentation: Fallback,
        trigger: WhenWatchedObjectDiesThisTurn,
        effect: [ManifestDread],
      ),
    ),
  ],
)
