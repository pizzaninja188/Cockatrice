// Oracle text from the pinned Scryfall bulk input; WotC's Dominaria Remastered ruling confirms
// that one multi-type permanent may satisfy more than one of Decimate's separate target instances.
// CR 601.2c and 115.3 govern the four required targets and repeated targeting across instances.
(
  id: "decimate",
  name: "Decimate",
  face_id: "decimate",
  mana_cost: "{2}{R}{G}",
  types: ["Sorcery"],
  spell_effect: [
    Destroy(subject: Chosen((kind: AnyPermanent, permanent_types: [Artifact]))),
    Destroy(subject: Chosen((kind: Creature))),
    Destroy(subject: Chosen((kind: AnyPermanent, permanent_types: [Enchantment]))),
    Destroy(subject: Chosen((kind: AnyPermanent, permanent_types: [Land]))),
  ],
  targeting: Some((groups: [
    (min: 1, max: 1, prompt: "Choose target artifact", effect_indices: [0]),
    (min: 1, max: 1, prompt: "Choose target creature", effect_indices: [1]),
    (min: 1, max: 1, prompt: "Choose target enchantment", effect_indices: [2]),
    (min: 1, max: 1, prompt: "Choose target land", effect_indices: [3]),
  ])),
)
