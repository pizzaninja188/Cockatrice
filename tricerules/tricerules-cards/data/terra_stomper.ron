// CR 113.6g (an ability that says a spell can't be countered functions on the stack), 701.6
// (counter) and 702.19a-b (trample). The pinned 2009-10-01 ruling confirms a counterspell can
// target it and resolves, but does not counter it; other effects work normally. Copy of Surrak,
// Elusive Hunter's uncounterable static plus Trample.
(
  id: "terra_stomper",
  name: "Terra Stomper",
  face_id: "terra_stomper",
  mana_cost: "{3}{G}{G}{G}",
  types: ["Creature", "Beast"],
  power: 8,
  toughness: 8,
  keywords: [Trample],
  static_abilities: [
    (
      ability_id: "static_01",
      presentation: OracleLines([1]),
      definition: SpellCannotBeCountered,
    ),
  ],
)
