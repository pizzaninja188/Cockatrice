(
  id: "glaring_aegis",
  name: "Glaring Aegis",
  face_id: "glaring_aegis",
  mana_cost: "{W}",
  // Aura attachment, ETB targeting, and layer effects are modeled independently.
  types: ["Enchantment", "Aura"],
  spell_effect: [AuraAttach(target: (kind: Creature))],
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: OracleLines([2]),
      trigger: WhenSelfEntersBattlefield,
      effect: [Tap(subject: Chosen((kind: Creature, controller: Opponent)))],
    ),
  ],
  static_abilities: [
    (ability_id: "static_01", presentation: Fallback, definition: AttachedModifier(delta_power: 1, delta_toughness: 3)),
  ],
)
