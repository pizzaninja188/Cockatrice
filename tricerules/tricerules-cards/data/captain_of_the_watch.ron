(
  id: "captain_of_the_watch",
  name: "Captain of the Watch",
  mana_cost: "{4}{W}{W}",
  types: ["Creature", "Human", "Soldier"],
  power: 3,
  toughness: 3,
  keywords: [Vigilance],
  triggered_abilities: [
    (
      trigger: WhenSelfEntersBattlefield,
      effect: CreateTokens(token: "soldier_w_1_1", count: 3),
      text: "When this creature enters, create three 1/1 white Soldier creature tokens.",
    ),
  ],
  // "Other Soldier creatures you control get +1/+1 and have vigilance." The +1/+1 is a
  // static type-filtered anthem (CR 604/613.4 layer 7c); the vigilance grant is a layer-6
  // keyword-granting effect, still deferred.
  static_abilities: [
    AnthemPt(
      filter: (controller: YouControl, subtype: "Soldier", exclude_self: true),
      delta_power: 1,
      delta_toughness: 1,
    ),
  ],
  partial: "vigilance grant to other Soldiers you control not implemented (keyword-granting anthem, layer 6)",
)
