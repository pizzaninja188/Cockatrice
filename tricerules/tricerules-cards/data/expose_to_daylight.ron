// Oracle c8195fcd-1858-4f23-aa73-b654d25035aa; source/rulings checked 2026-11-23 against the
// pinned Scryfall bulk SHA-256 a9a2fd3b550cc5cff4cec9bbc82aaf5fb8e3f781b4b95a896a0d94c15dce7853.
// CR 701.8 (destroy), 701.22a-b (scry), 115.1/601.2c (target at cast) and 608.2b (a stale sole
// target fizzles the whole spell, so no scry). The pinned 2019-01-25 ruling fixes both branches:
// illegal target means no scry, but an indestructible legal target still scries. Copy of the
// reviewed naturalize artifact-or-enchantment destruction plus omenspeaker's scry one.
(
  id: "expose_to_daylight",
  name: "Expose to Daylight",
  face_id: "expose_to_daylight",
  mana_cost: "{2}{W}",
  types: ["Instant"],
  spell_effect: [
    Destroy(subject: Chosen((
      any_of: Some([
        (kind: AnyPermanent, permanent_types: [Artifact]),
        (kind: AnyPermanent, permanent_types: [Enchantment]),
      ]),
    ))),
    Scry(count: 1),
  ],
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target artifact or enchantment",
    effect_indices: [0],
  )])),
)
