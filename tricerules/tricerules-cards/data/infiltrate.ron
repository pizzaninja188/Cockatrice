// No pinned ruling. CR 509.1b (a declaration of blockers is illegal when a restriction is
// disobeyed), 611.2a (the turn-scoped continuous restriction) and 115.1/601.2c (target at cast).
// Copy of the reviewed enter_the_enigma combat restriction without its draw rider.
(
  id: "infiltrate",
  name: "Infiltrate",
  face_id: "infiltrate",
  mana_cost: "{U}",
  types: ["Instant"],
  spell_effect: [ApplyCombatRestriction(
    scope: Chosen((kind: Creature)),
    restriction: (cant_be_blocked: true),
  )],
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target creature",
    effect_indices: [0],
  )])),
)
