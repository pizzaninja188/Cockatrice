// Oracle checked 2026-08-24. CR 601.2f and 118.7a: the reduction is determined from
// the announced targets, applies once, and affects only the generic component.
(
  id: "seized_from_slumber",
  name: "Seized from Slumber",
  mana_cost: "{4}{W}",
  cost_modifiers: [TargetMatchGenericReduction(
    amount: 3,
    filter: Battlefield((kind: Creature, tapped: Some(true))),
  )],
  types: ["Instant"],
  spell_effect: [Destroy(subject: Chosen((kind: Creature)))],
)
