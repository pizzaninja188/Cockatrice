  id: "guiding_bolt",
  name: "Guiding Bolt",
  face_id: "guiding_bolt",
  mana_cost: "{2}{W}",
  types: ["Instant"],
  spell_effect: [
    Destroy(subject: Chosen((kind: Creature, power: Some(AtLeast(4))))),
    Scry(count: 2),
  ],
  targeting: Some((groups: [(
    min: 1, max: 1,
    prompt: "Choose target creature with power 4 or greater",
    effect_indices: [0],
  )])),
