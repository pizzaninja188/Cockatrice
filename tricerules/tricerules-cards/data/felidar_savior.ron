(
  id: "felidar_savior",
  name: "Felidar Savior",
  mana_cost: "{3}{W}",
  types: ["Creature", "Cat", "Beast"],
  power: 2,
  toughness: 3,
  keywords: [Lifelink],
  triggered_abilities: [(
    trigger: WhenSelfEntersBattlefield,
    effect: [PutCounters(
      counter: PlusOnePlusOne,
      count: 1,
      subject: Chosen((kind: Creature, controller: You, exclude_source: true)),
    )],
    targeting: Some((groups: [(
      min: 0,
      max: 2,
      prompt: "Choose up to two other target creatures you control",
      effect_indices: [0],
    )])),
    text: "When this creature enters, put a +1/+1 counter on each of up to two other target creatures you control.",
  )],
)
