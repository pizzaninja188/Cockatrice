// Oracle and rulings fetched 2026-08-27. CR 701.26, 603.2c/e: only actual taps by you qualify.
(
  id: "solitary_sanctuary",
  name: "Solitary Sanctuary",
  face_id: "solitary_sanctuary",
  mana_cost: "{2}{W}",
  types: ["Enchantment"],
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: Fallback,
    trigger: WhenSelfEntersBattlefield,
    effect: [
      Tap(subject: Chosen((kind: Creature, controller: Opponent))),
      PutCounters(counter: Stun, count: 1, subject: Chosen((kind: Creature, controller: Opponent))),
    ],
    targeting: Some((groups: [(
      min: 1, max: 1, prompt: "Choose target creature an opponent controls", effect_indices: [0, 1],
    )])),
  ), (
    ability_id: "triggered_02",
    presentation: OracleLines([2]),
    trigger: WheneverPlayerTapsCreature(player: Controller, controllers: Opponents, cardinality: EachObject),
    effect: [PutCounters(counter: PlusOnePlusOne, count: 1, subject: Chosen((kind: Creature, controller: You)))],
  )],
)
