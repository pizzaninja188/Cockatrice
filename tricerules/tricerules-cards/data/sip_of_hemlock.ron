// CR 115.1a/601.2c (target at cast), 701.8 (destroy), 119.3 (life loss) and 608.2b: an illegal
// sole target fizzles, so no life is lost. The pinned 2013-09-15 ruling fixes the indestructible
// branch: the controller still loses 2 life. Copy of Victorious Destruction's controller life
// loss with the printed creature target.
(
  id: "sip_of_hemlock",
  name: "Sip of Hemlock",
  face_id: "sip_of_hemlock",
  mana_cost: "{4}{B}{B}",
  types: ["Sorcery"],
  spell_effect: [
    Destroy(subject: Chosen((kind: Creature))),
    LoseLife(amount: Fixed(2), who: ControllerOfTargetGroup(group_index: 0)),
  ],
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target creature",
    effect_indices: [0],
  )])),
)
