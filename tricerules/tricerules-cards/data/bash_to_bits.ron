// CR 115.1a/601.2c (artifact target at cast), 701.8 (destroy), 702.34a-d (flashback alternative
// cost; the spell is exiled any time it would leave the stack) and 608.2b (stale target).
// The pinned 2021-03-19 rulings confirm the flashback cost replaces the mana cost and the spell
// is exiled afterward even if it is countered. Copy of Firebolt's flashback with Shatter's
// artifact destruction.
(
  id: "bash_to_bits",
  name: "Bash to Bits",
  face_id: "bash_to_bits",
  mana_cost: "{3}{R}",
  types: ["Instant"],
  flashback_cost: Some("{4}{R}{R}"),
  spell_effect: [Destroy(subject: Chosen((kind: AnyPermanent, permanent_types: [Artifact])))],
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target artifact",
    effect_indices: [0],
  )])),
)
