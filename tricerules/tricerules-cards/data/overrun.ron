(
  id: "overrun",
  name: "Overrun",
  mana_cost: "{2}{G}{G}{G}",
  types: ["Sorcery"],
  // "Creatures you control get +3/+3 and gain trample until end of turn."
  // CR 613 layer 7c (PumpAll) + layer 6 (GrantKeywordsAll), both UntilEndOfTurn.
  spell_effect: [
    PumpAll(
      filter: (controller: YouControl),
      power: 3,
      toughness: 3,
    ),
    GrantKeywordsAll(
      filter: (controller: YouControl),
      keywords: [Trample],
    ),
  ],
)
