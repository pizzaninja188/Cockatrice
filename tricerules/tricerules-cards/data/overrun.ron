(
  id: "overrun",
  name: "Overrun",
  face_id: "overrun",
  mana_cost: "{2}{G}{G}{G}",
  types: ["Sorcery"],
  // Controller-wide +3/+3 and trample modification through end of turn.
  // CR 613 layer 7c (PumpAll) + layer 6 (GrantKeywordsAll), both UntilEndOfTurn.
  spell_effect: [
    PumpAll(
      filter: (controller: YouControl),
      power: 3,
      toughness: 3,
    ),
    GrantKeywordsAll(
      filter: (controller: YouControl),
      keywords: [Trample],
    ),
  ],
)
