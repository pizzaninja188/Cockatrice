(
  id: "obyra,_dreaming_duelist",
  name: "Obyra, Dreaming Duelist",
  face_id: "obyra_dreaming_duelist",
  mana_cost: "{U}{B}",
  supertypes: ["Legendary"],
  types: ["Creature", "Faerie", "Warrior"],
  power: 2,
  toughness: 2,
  keywords: [Flash, Flying],
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([3]),
    trigger: WheneverPermanentEntersBattlefield(
      controller: Controller,
      filter: (permanent_type: Some(Creature), exclude_source: true),
      creature_filter: Some((required_subtypes: ["Faerie"])),
    ),
    effect: [LoseLife(amount: Fixed(1), who: EachOpponent)],
  )],
)
