(
  id: "dusyut_earthcarver",
  name: "Dusyut Earthcarver",
  mana_cost: "{5}{G}",
  types: ["Creature", "Elephant", "Druid"],
  power: 4,
  toughness: 4,
  keywords: [Reach],
  triggered_abilities: [
    (
      trigger: WhenSelfEntersBattlefield,
      effect: [ChooseResolutionBranch(
        chooser: SourceController,
        optional: false,
        branches: [
          (
            label: "Put three +1/+1 counters on Dusyut Earthcarver",
            cost: None,
            requirement: EffectsApplicable,
            effects: [PutCounters(counter: PlusOnePlusOne, count: 3, subject: Source)],
          ),
          (
            label: "Create a 3/3 white Spirit creature token",
            cost: None,
            requirement: Always,
            effects: [CreateTokens(token: "spirit_w_3_3", count: 1, who: SourceController)],
          ),
        ],
      )],
      text: "When this creature enters, endure 3. (Put three +1/+1 counters on it or create a 3/3 white Spirit creature token.)",
    ),
  ],
)
