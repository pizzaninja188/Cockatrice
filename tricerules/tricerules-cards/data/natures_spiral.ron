(
  id: "natures_spiral",
  name: "Nature's Spiral",
  face_id: "natures_spiral",
  mana_cost: "{1}{G}",
  types: ["Sorcery"],
  spell_effect: [MoveGraveyardCards(
    filter: (card: Some((any_of: Some([
      (card_type: Some(Land)),
      (card_type: Some(NonlandPermanent)),
    ])))),
    destination: Hand,
  )],
)
