  face_id: "murdocks_crusade",
  mana_cost: "{1}{W}",
  types: ["Sorcery"],
  cast_cost_groups: [(
    group_id: "teamwork",
    presentation: OracleLines([1]),
    min: 0,
    max: 1,
    options: [TapPermanents(
      option_id: "teamwork_4",
