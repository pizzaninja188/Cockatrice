// Oracle/rulings verified 2026-08-28. CR 601.2/602.2: target before paying sacrifice cost.
(
  id: "haywire_mite",
  name: "Haywire Mite",
  face_id: "haywire_mite",
  mana_cost: "{1}",
  types: ["Artifact", "Creature", "Insect"],
  power: 1,
  toughness: 1,
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([1]),
    trigger: WhenSelfDies,
    effect: [GainLife(amount: 2)],
  )],
  activated_abilities: [(
    ability_id: "activated_01",
    presentation: OracleLines([2]),
    costs: [Mana("{G}"), SacrificeSelf],
    effect: [Exile(subject: Chosen((kind: AnyPermanent, permanent_types: [Artifact, Enchantment], excluded_permanent_types: [Creature])))],
  )],
)
