(
  id: "fireball",
  name: "Fireball",
  mana_cost: "{X}{R}",
  types: ["Sorcery"],
  spell_effect: [DamageTargets(
    amount: "X",
    target: (kind: AnyTarget),
    division: EvenAtResolution,
    extra_mana_per_target: 1,
  )],
  targeting: Some((groups: [(
    min: 0,
    max: 4294967295,
