// Oracle: Fireball deals X damage divided as you choose among any number of targets.
// It costs {1} more to cast for each target beyond the first.
// CR 601.2d / 601.2f: dividing X among targets; surcharge applies at cast time.
(
  id: "fireball",
  name: "Fireball",
  mana_cost: "{X}{R}",
  types: ["Sorcery"],
  spell_effect: [DamageTargets(
    amount: "X",
    target: (kind: AnyTarget),
    extra_mana_per_target: 1,
  )],
)
