(
  id: "masters_rebuke",
  name: "Master's Rebuke",
  face_id: "masters_rebuke",
  mana_cost: "{1}{G}",
  types: ["Instant"],
  spell_effect: [CreatureDealsDamageEqualToPower(
    source: (kind: Creature, controller: You),
    target: (kind: AnyPermanent, controller: NotYou, permanent_types: [Creature, Planeswalker]),
  )],
  targeting: Some((groups: [
    (
      min: 1,
      max: 1,
      prompt: "Choose target creature you control",
      effect_indices: [0],
      distinct_from: [1],
    ),
    (
      min: 1,
      max: 1,
      prompt: "Choose target creature or planeswalker you don't control",
      effect_indices: [0],
      distinct_from: [0],
    ),
  ])),
)
