// Oracle/rulings verified 2026-08-28. CR 122.8, 704.8: copy every pre-death counter kind.
(
  id: "dockworker_drone",
  name: "Dockworker Drone",
  mana_cost: "{1}{W}",
  types: ["Artifact", "Creature", "Robot"],
  power: 1,
  toughness: 1,
  static_abilities: [EntersWithCounters(counter: PlusOnePlusOne, amount: 1)],
  triggered_abilities: [(
    trigger: WhenSelfDies,
    effect: [PutCounterSnapshot(from: Source, subject: Chosen((kind: Creature, controller: You)))],
    text: "When this creature dies, put its counters on target creature you control.",
  )],
)
