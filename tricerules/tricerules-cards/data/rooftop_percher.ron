// Oracle checked 2026-08-26. The targeted graveyard cards share one graveyard (CR 115.9c).
(
  id: "rooftop_percher",
  name: "Rooftop Percher",
  mana_cost: "{5}",
  types: ["Creature", "Shapeshifter"],
  power: 3,
  toughness: 3,
  characteristic_defining_abilities: [Changeling],
  keywords: [Flying],
  triggered_abilities: [(
