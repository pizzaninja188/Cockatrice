  name: "Sakura-Tribe Elder",
  face_id: "sakura_tribe_elder",
  mana_cost: "{1}{G}",
  types: ["Creature", "Snake", "Shaman"],
  power: 1,
  toughness: 1,
  activated_abilities: [
    (
      ability_id: "activated_01",
      presentation: OracleLines([1]),
      costs: [SacrificeSelf],
      effect: [
        SearchLibrary(
          filter: Some((card_type: Some(BasicLand))),
          destination: Battlefield(tapped: true),
          shuffle: true,
          reveal: false,
        ),
      ],
