(
  id: "dwynens_elite",
  name: "Dwynen's Elite",
  face_id: "dwynen_s_elite",
  mana_cost: "{1}{G}",
  types: ["Creature", "Elf", "Warrior"],
  power: 2,
  toughness: 2,
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([1]),
