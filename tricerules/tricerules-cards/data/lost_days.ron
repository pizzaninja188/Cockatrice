// Oracle and rulings verified 2026-08-29. CR 400.3/401.4/608.2b: the target's
// owner chooses the exact placement. General meld support is intentionally deferred.
(
  id: "lost_days",
  name: "Lost Days",
  face_id: "lost_days",
  mana_cost: "{4}{U}",
  types: ["Instant", "Lesson"],
  spell_effect: [],
  spell_program: Some((
    body: (steps: [
      (id: "put_in_owners_library", bind: [], input: None,
        kind: Perform(PutInOwnersLibrary(
          subject: Chosen((kind: AnyPermanent, permanent_types: [Creature, Enchantment])),
          placement: OwnerChoiceSecondFromTopOrBottom,
        ))),
      (id: "create_clue", bind: [], input: None,
        kind: Perform(CreateTokens(token: "clue", count: 1))),
    ], yields: []),
    target_bindings: [(instruction_id: "put_in_owners_library", role: Subject, target_group_index: 0)],
  )),
  targeting: Some((groups: [(min: 1, max: 1, prompt: "Choose target creature or enchantment", effect_indices: [])])),
)
