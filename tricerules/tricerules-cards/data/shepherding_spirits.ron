(
  id: "shepherding_spirits",
  name: "Shepherding Spirits",
  mana_cost: "{4}{W}{W}",
  types: ["Creature", "Spirit"],
  power: 4,
  toughness: 5,
  keywords: [Flying],
  activated_abilities: [(
    source_zone: Hand,
    costs: [Mana("{2}"), DiscardSelf],
