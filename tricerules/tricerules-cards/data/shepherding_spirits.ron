      filter: Some((subtype: Some("Plains"))),
      destination: Hand,
      shuffle: true,
      reveal: true,
    )],
    text: "Plainscycling {2} ({2}, Discard this card: Search your library for a Plains card, reveal it, put it into your hand, then shuffle.)",
  )],
)
