// Oracle and rulings checked against Scryfall on 2026-08-26. Damage history follows the chosen
// target's captured zone-change generation after the first instruction exiles it.
(
  id: "sold_out",
  name: "Sold Out",
  face_id: "sold_out",
  mana_cost: "{3}{B}",
  types: ["Instant"],
  spell_effect: [],
  spell_program: Some((
    body: (steps: [
      (id: "exile_target", kind: Perform(Exile(subject: Chosen((kind: Creature))))),
      (id: "create_clue_if_damaged", kind: If(
        condition: ObjectWasDealtDamageThisTurn(
          object: ChosenTarget(group_index: 0, target_index: 0),
        ),
        yes: (steps: [
          (id: "create_clue", kind: Perform(CreateTokens(token: "clue", count: 1))),
        ], yields: []),
        no: (steps: [], yields: []),
      )),
    ], yields: []),
    target_bindings: [
      (instruction_id: "exile_target", role: Subject, target_group_index: 0),
    ],
  )),
  targeting: Some((groups: [
    (min: 1, max: 1, prompt: "Choose target creature", effect_indices: []),
  ])),
)
