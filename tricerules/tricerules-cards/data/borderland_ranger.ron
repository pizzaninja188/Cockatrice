// Oracle ffe25048-0bd4-49b5-aecb-2b1b57fb8d8b; source/rulings checked 2026-11-12.
// CR 603.1, 701.23 and 701.24: optional private basic-land search, reveal, hand, shuffle.
(
  id: "borderland_ranger",
  name: "Borderland Ranger",
  face_id: "borderland_ranger",
  mana_cost: "{2}{G}",
  types: ["Creature", "Human", "Scout", "Ranger"],
  power: 2,
  toughness: 2,
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([1]),
    trigger: WhenSelfEntersBattlefield,
    program: Some((body: (steps: [
      (id: "search_choice", kind: Choose(
        choice: "search",
        chooser: Controller,
        optional: true,
        branches: [(
          branch_id: "search_for_a_basic_land",
          presentation: Fallback,
          cost: None,
          body: (steps: [
            (id: "search_hand", kind: Perform(SearchLibrary(
              filter: Some((card_type: Some(BasicLand))),
              zones: Fixed([Library]),
              reveal: true,
              selection_bounds: Some((min: 0, max: 1)),
            )))
          ]),
        )],
        otherwise: (),
      )),
    ]))),
  )],
)
