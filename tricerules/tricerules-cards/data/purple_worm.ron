// targets triggers its own Ward. Copies Dreaded Bat-Cloud's conditional reduction and Tolarian
// Terror's Ward {2}.
(
  id: "purple_worm",
  name: "Purple Worm",
  face_id: "purple_worm",
  mana_cost: "{5}{G}{G}",
  types: ["Creature", "Worm"],
  power: 8,
  toughness: 7,
  cost_modifiers: [
    ConditionalGenericReduction(amount: 2, condition: CreatureDeathsThisTurn(min: Some(1))),
  ],
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: OracleLines([2]),
      trigger: WheneverSelfBecomesTarget(source: SpellOrAbility, source_controller: Opponent),
      program: Some(
        (
          body: (
            steps: [(id: "ward", kind: Perform(CounterTriggeringStackObjectUnlessPays(cost: Mana("{2}"))))],
          ),
        ),
      ),
    ),
  ],
)
