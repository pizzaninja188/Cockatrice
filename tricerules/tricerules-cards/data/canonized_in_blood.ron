// Oracle/rulings fetched 2026-08-27. CR 603.4 / 700.11: the end-step condition is historical;
// the target is still chosen and revalidated through the ordinary targeted-trigger pipeline.
(
    id: "canonized_in_blood",
    name: "Canonized in Blood",
    face_id: "canonized_in_blood",
    mana_cost: "{1}{B}",
    types: ["Enchantment"],
    triggered_abilities: [(
        ability_id: "triggered_01",
        presentation: Fallback,
        trigger: AtBeginningOfEndStep(player: Controller),
        intervening_if: Some(GameCondition(PermanentCardsEnteredGraveyardThisTurn(players: Controller, min: Some(1)))),
        effect: [PutCounters(counter: PlusOnePlusOne, count: 1, subject: Chosen((kind: Creature, controller: You)))],
    )],
    activated_abilities: [(
        ability_id: "activated_01",
        presentation: OracleLines([2]),
        costs: [Mana("{5}{B}{B}"), SacrificeSelf],
        effect: [CreateTokens(token: "vampire_demon_wb_4_3_flying", count: 1)],
    )],
)
