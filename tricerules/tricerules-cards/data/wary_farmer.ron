// Oracle and ruling checked against Scryfall on 2026-08-26. CR 603.4 checks the committed
// event-time "another creature entered" fact at trigger creation and resolution.
(
  id: "wary_farmer",
  name: "Wary Farmer",
  mana_cost: "{1}{G/W}{G/W}",
  types: ["Creature", "Kithkin", "Citizen"],
  power: 3,
  toughness: 3,
  triggered_abilities: [(
    trigger: AtBeginningOfEndStep(player: Controller),
    effect: [LibraryPartition(count: 1, top_min: 0, top_max: None, kind: Surveil)],
    intervening_if: Some(GameCondition(PermanentsEnteredThisTurn(
      controllers: Controller,
      filter: (permanent_type: Some(Creature), exclude_source: true),
      min: Some(1),
    ))),
    text: "At the beginning of your end step, if another creature entered the battlefield under your control this turn, surveil 1.",
  )],
)
