// until end of turn). The pinned 2018-10-05 ruling confirms an already-untapped creature still
// gains both keywords. Copy of Make a Stand's mass indestructible grant plus Vitalize's UntapAll.
(
  id: "join_shields",
  name: "Join Shields",
  face_id: "join_shields",
  mana_cost: "{3}{G}{W}",
  types: ["Instant"],
  spell_effect: [
    UntapAll(players: Controller),
    GrantKeywordsAll(filter: (controller: YouControl), keywords: [Hexproof, Indestructible]),
  ],
)
