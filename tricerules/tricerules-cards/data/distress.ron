// Pinned 2014-02-01 ruling: targeting yourself reveals your hand like any other player.
// CR 701.9 (discard), 400.2 (hidden hand), 701.20 (reveal) and 608.2c.
(
  id: "distress",
  name: "Distress",
  face_id: "distress",
  mana_cost: "{B}{B}",
  types: ["Sorcery"],
  spell_effect: [
    ChooseHandCards(action: Discard,
      count: 1,
      target: (kind: AnyPlayer),
      chooser: Controller,
      card_filter: Some(Nonland),
      visibility: PublicReveal,
    ),
  ],
  targeting: Some((groups: [(min: 1, max: 1, effect_indices: [0])])),
)
