(
  id: "gravedigger",
  name: "Gravedigger",
  mana_cost: "{3}{B}",
  types: ["Creature", "Zombie"],
  power: 2,
  toughness: 2,
  partial: "ETB trigger is mandatory (\"you may\" not yet supported by trigger system)",
  triggered_abilities: [
    (
      trigger: WhenSelfEntersBattlefield,
      effect: ReturnFromGraveyard(filter: (owner: Controller, card_type: Some(Creature)), destination: Hand),
      text: "When this creature enters, you may return target creature card from your graveyard to your hand.",
    ),
  ],
)
