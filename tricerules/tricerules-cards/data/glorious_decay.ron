  mana_cost: "{1}{G}",
  types: ["Instant"],
  modal_spell: (min_modes: 1, max_modes: 1, modes: [
    (mode_id: "mode_01", presentation: OracleLines([2]), effects: [Destroy(subject: Chosen((kind: AnyPermanent, permanent_types: [Artifact])))], targeting: Some((groups: [(min: 1, max: 1, prompt: "Choose target artifact", effect_indices: [0])]))),
    (mode_id: "mode_02", presentation: OracleLines([3]), effects: [DamageTarget(amount: 4, target: (kind: Creature, required_keywords: [Flying]))], targeting: Some((groups: [(min: 1, max: 1, prompt: "Choose target creature with flying", effect_indices: [0])]))),
    (mode_id: "mode_03", presentation: OracleLines([4]), effects: [MoveGraveyardCards(filter: (owner: AnyPlayer), destination: Exile), Draw(count: 1)], targeting: Some((groups: [(min: 1, max: 1, prompt: "Choose target card from a graveyard", effect_indices: [0])]))),
