(
  id: "rimeshield_frost_giant",
  name: "Rimeshield Frost Giant",
  face_id: "rimeshield_frost_giant",
  mana_cost: "{3}{U}{U}",
  types: ["Creature", "Giant", "Warrior"],
  power: 4,
  toughness: 5,
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: OracleLines([1]),
      trigger: WheneverSelfBecomesTarget(source: SpellOrAbility, source_controller: Opponent),
      program: Some(
        (
          body: (
            steps: [(id: "ward", kind: Perform(CounterTriggeringStackObjectUnlessPays(cost: Mana("{3}"))))],
          ),
        ),
      ),
    ),
  ],
)
