// Oracle and rulings checked 2026-10-01: https://scryfall.com/card/2x2/67/wash-out
// Each branch is a chosen-color fragment of the printed line; the whole line would mislabel it.
(
  id: "wash_out",
  name: "Wash Out",
  face_id: "wash_out",
  mana_cost: "{3}{U}",
  types: ["Sorcery"],
  spell_effect: [ChooseResolutionBranch(
    chooser: Controller,
    optional: false,
    branches: [
      (branch_id: "white", presentation: Fallback, cost: None,
       effects: [ReturnAllToOwnersHand(kind: (kind: AnyPermanent, is_color: Some(White)))]),
      (branch_id: "blue", presentation: Fallback, cost: None,
       effects: [ReturnAllToOwnersHand(kind: (kind: AnyPermanent, is_color: Some(Blue)))]),
      (branch_id: "black", presentation: Fallback, cost: None,
       effects: [ReturnAllToOwnersHand(kind: (kind: AnyPermanent, is_color: Some(Black)))]),
      (branch_id: "red", presentation: Fallback, cost: None,
       effects: [ReturnAllToOwnersHand(kind: (kind: AnyPermanent, is_color: Some(Red)))]),
      (branch_id: "green", presentation: Fallback, cost: None,
       effects: [ReturnAllToOwnersHand(kind: (kind: AnyPermanent, is_color: Some(Green)))]),
    ],
  )],
)
