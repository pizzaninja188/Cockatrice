(
  id: "foggy_swamp_vinebender",
  name: "Foggy Swamp Vinebender",
  mana_cost: "{3}{G}",
  types: ["Creature", "Human", "Plant", "Ally"],
  power: 4,
  toughness: 3,
  static_abilities: [SelfCombatRestriction(restriction: (cant_be_blocked_by: [(kind: Creature, power: Some(AtMost(2)))]))],
  activated_abilities: [(
    costs: [Waterbend("{5}")],
    conditions: [GameCondition(ActivePlayer(players: Controller))],
    effect: [PutCounters(counter: PlusOnePlusOne, count: 1, subject: Source)],
    text: "Waterbend {5}: Put a +1/+1 counter on this creature. Activate only during your turn.",
  )],
)
