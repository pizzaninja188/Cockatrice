// The 2021-07-23 ruling requires all four excluded creature types to be absent. CR 701.8
// (destroy), 115.1/601.2c (target), 205.3m (creature types) and 608.2b (stale target). Copy of
// Doom Blade's filtered destruction with the printed four-type exclusion.
(
  id: "power_word_kill",
  name: "Power Word Kill",
  face_id: "power_word_kill",
  mana_cost: "{1}{B}",
  types: ["Instant"],
  spell_effect: [Destroy(subject: Chosen((
    kind: Creature,
    excluded_subtypes: ["Angel", "Demon", "Devil", "Dragon"],
  )))],
  targeting: Some((groups: [
    (
      min: 1,
      max: 1,
      prompt: "Choose target non-Angel, non-Demon, non-Devil, non-Dragon creature",
      effect_indices: [0],
    ),
  ])),
)
