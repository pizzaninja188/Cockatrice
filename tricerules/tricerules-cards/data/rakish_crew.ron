// Oracle and rulings checked against Scryfall on 2026-08-27.
(
  id: "rakish_crew",
  name: "Rakish Crew",
  face_id: "rakish_crew",
  mana_cost: "{2}{B}",
  types: ["Enchantment"],
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: OracleLines([1]),
      trigger: WhenSelfEntersBattlefield,
      effect: [CreateTokens(token: "mercenary_r_1_1", count: 1)],
    ),
    (
      ability_id: "triggered_02",
      presentation: Fallback,
      trigger: WheneverPermanentLeavesBattlefield(
        controller: Controller,
        filter: (any_subtypes: ["Assassin", "Mercenary", "Pirate", "Rogue", "Warlock"]),
        destination: OneOf([Graveyard]),
      ),
      effect: [LoseLife(amount: Fixed(1), who: EachOpponent), GainLife(amount: 1)],
    ),
  ],
)
