// Oracle and rulings checked 2026-09-23 against pinned Scryfall oracle fbb7735f-ec91-4ed4-b735-d94a76e68a80.
// Handwritten typed definition promoted through the reviewed direct-RON path;
// review map and packet evidence live under authoring/review-maps and build/direct-ron.
// CR 702.17 (reach), CR 603.6a/603.6d (an exclude-self permanent-entry watcher), and CR 115.4
// (target opponent): the Sharpshooter deals 1 damage to a target opponent, not to a permanent.
(
  id: "shocking_sharpshooter",
  name: "Shocking Sharpshooter",
  face_id: "shocking_sharpshooter",
  mana_cost: "{1}{R}",
  types: ["Creature", "Human", "Archer"],
  power: 1,
  toughness: 3,
  keywords: [Reach],
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([2]),
    trigger: WheneverPermanentEntersBattlefield(
      controller: Controller,
      filter: (permanent_type: Some(Creature), exclude_source: true),
    ),
    effect: [DamageTarget(amount: 1, target: (kind: OpponentPlayer))],
  )],
)
