// lifelink source dealing damage to several recipients, and that a teammate's life gain in
// Two-Headed Giant does not trigger it.
(
  id: "cliffhaven_vampire",
  name: "Cliffhaven Vampire",
  face_id: "cliffhaven_vampire",
  mana_cost: "{2}{W}{B}",
  types: ["Creature", "Vampire", "Warrior", "Ally"],
  power: 2,
  toughness: 4,
  keywords: [Flying],
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([2]),
    trigger: WheneverPlayerGainsLife(),
    effect: [LoseLife(amount: Fixed(1), who: EachOpponent)],
  )],
)
