(
  id: "combustible_gearhulk",
  name: "Combustible Gearhulk",
  face_id: "combustible_gearhulk",
  mana_cost: "{4}{R}{R}",
  types: ["Artifact", "Creature", "Construct"],
  power: 6,
  toughness: 6,
  keywords: [FirstStrike],
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([2]),
    trigger: WhenSelfEntersBattlefield,
    program: Some((
      body: (
        steps: [
          (id: "draw_or_mill", kind: Choose(
            choice: "draw_or_mill",
            chooser: TargetedPlayer(group_index: 0, kind: OpponentPlayer),
            optional: true,
            branches: [(
              branch_id: "draw_three",
              presentation: OracleLines([2]),
              cost: None,
              body: (steps: [
                (id: "draw_three_cards",
                  kind: Perform(Draw( count: 3))),
              ]),
            )],
            otherwise: (steps: [
              (id: "mill_three", bind: ["milled"],
                kind: Perform(Mill( count: 3))),
              (id: "damage_opponent", input: Some("milled"),
                kind: Perform(DamagePlayer(
                  who: TargetedPlayer(group_index: 0, kind: OpponentPlayer),
                  amount: Count(CardResultCharacteristicSum(
                    filter: (source: PreviousEffect, action: Mill, players: Controller),
                    characteristic: ManaValue,
                  )),
                ))),
            ]),
          )),
        ],
      ),
      target_bindings: [(
        instruction_id: "damage_opponent",
        role: Target,
        target_group_index: 0,
      )],
    )),
    targeting: Some((groups: [(
      min: 1,
      max: 1,
      prompt: "Choose target opponent",
      effect_indices: [],
    )])),
  )],
)
