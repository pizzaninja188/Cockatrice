// Oracle and ruling verified 2026-08-29. Wither applies to all creature damage from the recipient.
(
  id: "barbed_bloodletter",
  name: "Barbed Bloodletter",
  face_id: "barbed_bloodletter",
  mana_cost: "{1}{B}",
  types: ["Artifact", "Equipment"],
  keywords: [Flash],
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: Fallback,
    trigger: WhenSelfEntersBattlefield,
    effect: [
      AttachSource(target: (kind: Creature, controller: You)),
      GrantKeywords(subject: Chosen((kind: Creature, controller: You)), keywords: [Wither]),
    ],
  )],
  static_abilities: [(ability_id: "static_01", presentation: Fallback, definition: AttachedModifier(delta_power: 1, delta_toughness: 2))],
  activated_abilities: [(
    ability_id: "activated_01",
    presentation: OracleLines([4]),
    costs: [Mana("{2}")],
    effect: [Equip(target: (kind: Creature, controller: You))],
  )],
)
