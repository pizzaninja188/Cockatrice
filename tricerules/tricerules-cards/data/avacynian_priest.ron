(
  id: "avacynian_priest",
  name: "Avacynian Priest",
  face_id: "avacynian_priest",
  mana_cost: "{1}{W}",
  types: ["Creature", "Human", "Cleric"],
  power: 1,
  toughness: 2,
  activated_abilities: [
    (
      ability_id: "activated_01",
