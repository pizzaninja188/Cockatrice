// Oracle and Marvel Super Heroes rulings verified 2026-09-02. Cybernetic Senses checks Viv
// Vision's current derived power only as the attack trigger resolves.
(
  id: "viv_vision,_teen_synthezoid",
  name: "Viv Vision, Teen Synthezoid",
  face_id: "viv_vision_teen_synthezoid",
  mana_cost: "{3}",
  types: ["Artifact", "Creature", "Robot", "Hero"],
  supertypes: ["Legendary"],
  power: 2,
  toughness: 2,
  keywords: [Flying],
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([2]),
    trigger: WheneverSelfAttacks(minimum_other_attackers: 0),
    effect: [Conditional(
      condition: ObjectMatches(
        object: Source,
        filter: (kind: Creature, power: Some(AtLeast(4))),
      ),
      effect: Draw(count: 1),
    )],
  )],
  activated_abilities: [(
    ability_id: "activated_01",
    presentation: OracleLines([3]),
    costs: [Mana("{7}")],
    cost_modifiers: [ConditionalSourceManaCostReduction(condition: PermanentsEnteredThisTurn(
      controllers: All,
      filter: (source_only: true),
      min: Some(1),
    ))],
    effect: [PutCounters(counter: PlusOnePlusOne, count: 2, subject: Source)],
    activation_limit: Some(PerObject(max_activations: 1)),
  )],
)
