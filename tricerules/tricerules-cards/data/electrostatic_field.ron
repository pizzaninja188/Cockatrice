// before the spell and resolves even if that spell is countered.
(
  id: "electrostatic_field",
  name: "Electrostatic Field",
  face_id: "electrostatic_field",
  mana_cost: "{1}{R}",
  types: ["Creature", "Wall"],
  power: 0,
  toughness: 4,
  keywords: [Defender],
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([2]),
    trigger: WheneverPlayerCastsSpell(filter: (card_type: Some(InstantOrSorcery))),
    effect: [DamagePlayer(amount: 1, who: EachOpponent)],
  )],
)
