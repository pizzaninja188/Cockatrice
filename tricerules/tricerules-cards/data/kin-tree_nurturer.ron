(
  id: "kin-tree_nurturer",
  name: "Kin-Tree Nurturer",
  mana_cost: "{2}{B}",
  types: ["Creature", "Human", "Druid"],
  power: 2,
  toughness: 1,
  keywords: [Lifelink],
  triggered_abilities: [
    (
      trigger: WhenSelfEntersBattlefield,
      effect: [ChooseResolutionBranch(
        chooser: SourceController,
        optional: false,
        branches: [
          (
            label: "Put a +1/+1 counter on Kin-Tree Nurturer",
            cost: None,
            requirement: EffectsApplicable,
            effects: [PutCounters(counter: PlusOnePlusOne, count: 1, subject: Source)],
          ),
          (
            label: "Create a 1/1 white Spirit creature token",
            cost: None,
            requirement: Always,
            effects: [CreateTokens(token: "spirit_w_1_1", count: 1, who: SourceController)],
          ),
        ],
      )],
      text: "When this creature enters, endure 1. (Put a +1/+1 counter on it or create a 1/1 white Spirit creature token.)",
    ),
  ],
)
