  face_id: "kaito_bane_of_nightmares",
  mana_cost: "{2}{U}{B}",
  supertypes: ["Legendary"],
  types: ["Planeswalker", "Kaito"],
  loyalty: 4,
  static_abilities: [(
    ability_id: "static_01",
