      costs: [Loyalty(1)],
      effect: [CreateStaticEmblem(
        emblem_id: "kaito_bane_of_nightmares_emblem",
        display_name: "Kaito, Bane of Nightmares Emblem",
        creatures: (controller: Some(YouControl), subtype: Some("Ninja")),
