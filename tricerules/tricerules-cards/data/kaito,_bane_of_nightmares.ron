      ],
    ),
    (
      ability_id: "activated_04",
      presentation: OracleLines([5]),
      costs: [Loyalty(-2)],
      effect: [
        Tap(subject: Chosen((kind: Creature))),
        PutCounters(counter: Stun, count: 2, subject: Chosen((kind: Creature))),
