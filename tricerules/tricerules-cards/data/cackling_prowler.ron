// Foundations. CR 603.4 / 702.21: Ward is an opponent-only becomes-target trigger, while
// morbid is an intervening-if condition checked at the beginning of the end step and again
// when the ability resolves.
(
  id: "cackling_prowler",
  name: "Cackling Prowler",
  face_id: "cackling_prowler",
  mana_cost: "{3}{G}",
  types: ["Creature", "Hyena", "Rogue"],
  power: 4,
  toughness: 3,
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: Fallback,
      trigger: WheneverSelfBecomesTarget(source: SpellOrAbility, source_controller: Opponent),
      effect: [CounterTriggeringStackObjectUnlessPays(cost: Mana("{2}"))],
    ),
    (
      ability_id: "triggered_02",
      presentation: Fallback,
      trigger: AtBeginningOfEndStep(player: Controller),
      intervening_if: Some(CreatureDeathsThisTurn(min: Some(1), max: None)),
      effect: [PutCounters(counter: PlusOnePlusOne, count: 1, subject: Source)],
    ),
  ],
)
