// Oracle and rulings checked 2026-08-21. CR 121.2: multiple-card draws are individual draw
// events. The first draw need not happen while this permanent is on the battlefield.
(
  id: "erudite_wizard",
  name: "Erudite Wizard",
  mana_cost: "{2}{U}",
  types: ["Creature", "Human", "Wizard"],
  power: 2,
  toughness: 3,
  triggered_abilities: [(
    trigger: WheneverPlayerDrawsNthCard(drawer: Controller, ordinal: 2),
    effect: [PutCounters(counter: PlusOnePlusOne, count: 1, subject: Source)],
    text: "Whenever you draw your second card each turn, put a +1/+1 counter on this creature.",
  )],
)
