// Oracle verified 2026-08-29. The Ally check is a resolution-time condition on
// the already chosen creature, not an additional cast-time target restriction.
(
  id: "yip_yip!",
  name: "Yip Yip!",
  face_id: "yip_yip",
  mana_cost: "{W}",
  types: ["Instant", "Lesson"],
  spell_effect: [
    PumpTarget(
      power: 2,
      toughness: 2,
      subject: Chosen((kind: Creature, controller: You)),
    ),
    Conditional(
      condition: ObjectMatches(
        object: ChosenTarget(group_index: 0, target_index: 0),
        filter: (kind: Creature, required_subtypes: ["Ally"]),
      ),
      effect: GrantKeywords(
        subject: Chosen((kind: Creature, controller: You)),
        keywords: [Flying],
      ),
    ),
  ],
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target creature you control",
    effect_indices: [0, 1],
  )])),
)
