// Oracle and rulings checked against Scryfall on 2026-08-26; there are no card-specific rulings.
(
  id: "crossroads_watcher",
  name: "Crossroads Watcher",
  mana_cost: "{2}{G}",
  types: ["Creature", "Kithkin", "Ranger"],
  power: 3,
  toughness: 3,
  keywords: [Trample],
  triggered_abilities: [(
    trigger: WheneverPermanentEntersBattlefield(
      controller: Controller,
      filter: (permanent_type: Some(Creature), exclude_source: true),
    ),
    effect: [PumpTarget(power: 1, toughness: 0, subject: Source)],
    text: "Whenever another creature you control enters, this creature gets +1/+0 until end of turn.",
  )],
)
