// CR 701.8 (destroy) and 702.29a (cycling is a hand-zone activated ability that discards the card
// as a cost, then draws). The pinned 2008-10-01 ruling confirms cycling is an activated ability.
// Copy of the reviewed barren_moor cycling plus cursebreak's destruction.
(
  id: "clear",
  name: "Clear",
  face_id: "clear",
  mana_cost: "{1}{W}",
  types: ["Instant"],
  spell_effect: [Destroy(subject: Chosen((kind: AnyPermanent, permanent_types: [Enchantment])))],
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target enchantment",
    effect_indices: [0],
  )])),
  activated_abilities: [(
    ability_id: "activated_01",
    presentation: OracleLines([2]),
    source_zone: Hand,
    costs: [Mana("{2}"), DiscardSelf],
    effect: [Draw(count: 1)],
  )],
)
