(
  id: "reckless_ransacking",
  name: "Reckless Ransacking",
  face_id: "reckless_ransacking",
  mana_cost: "{1}{R}",
  types: ["Instant"],
  spell_effect: [
    PumpTarget(power: 3, toughness: 2, subject: Chosen((kind: Creature))),
    CreateTokens(token: "treasure", count: 1),
  ],
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target creature",
    effect_indices: [0],
  )])),
)
