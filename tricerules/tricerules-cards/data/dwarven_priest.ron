(
  id: "dwarven_priest",
  name: "Dwarven Priest",
  face_id: "dwarven_priest",
  mana_cost: "{3}{W}",
  types: ["Creature", "Dwarf", "Cleric"],
  power: 2,
  toughness: 4,
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: OracleLines([1]),
      trigger: WhenSelfEntersBattlefield,
      effect: [
        GainLife(
          amount: Count(BattlefieldCreatures(
            filter: (controllers: Controller),
          )),
        ),
      ],
    ),
  ],
)
