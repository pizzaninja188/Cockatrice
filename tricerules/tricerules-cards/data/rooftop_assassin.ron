// Oracle/rulings verified 2026-08-28. Damage history belongs to the current object generation.
(
  id: "rooftop_assassin",
  name: "Rooftop Assassin",
  mana_cost: "{3}{B}",
  types: ["Creature", "Vampire", "Assassin"],
  power: 2,
  toughness: 2,
  keywords: [Flash, Flying, Lifelink],
  triggered_abilities: [(
    trigger: WhenSelfEntersBattlefield,
    effect: [Destroy(subject: Chosen((kind: Creature, controller: Opponent, was_dealt_damage_this_turn: Some(true))))],
    text: "When this creature enters, destroy target creature an opponent controls that was dealt damage this turn.",
  )],
)
