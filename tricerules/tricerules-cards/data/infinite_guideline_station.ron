// Pinned Oracle cda39514-86c9-483e-8d95-fd08138ce33a; Scryfall text/rulings checked 2026-11-23 (no rulings).
// "Multicolored" is two or more distinct derived colors (CR 105.2b), counted on resolution
// (CR 608.2h), so the five-color Station counts itself. CR 722.2: the attack trigger is printed
// in the 12+ striation, so it is part of that station symbol's static ability.
(
  id: "infinite_guideline_station",
  name: "Infinite Guideline Station",
  face_id: "infinite_guideline_station",
  mana_cost: "{W}{U}{B}{R}{G}",
  types: ["Artifact", "Spacecraft"],
  supertypes: ["Legendary"],
  power: 7,
  toughness: 15,
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: OracleLines([1]),
      trigger: WhenSelfEntersBattlefield,
      effect: [
        CreateTokens(
          token: "robot_c_2_2",
          count: Count(BattlefieldPermanents(filter: (controllers: Controller, matching: (kind: AnyPermanent, min_colors: Some(2))))),
          tapped: true,
        ),
      ],
    ),
  ],
  activated_abilities: [
    (
      ability_id: "activated_01",
      presentation: OracleLines([2]),
      costs: [
        TapPermanents(constraint: ExactCount(1), filter: (kind: Creature, controller: You), exclude_source: true),
      ],
      effect: [
        PutCounters(
          counter: Charge,
          count: Count(
            CardResultCharacteristicSum(
              filter: (source: Payment, action: Tap, players: Controller, card_type: Some(Creature)),
              characteristic: Power,
            ),
          ),
          subject: Source,
        ),
      ],
      timing: SorcerySpeed,
    ),
  ],
  static_abilities: [
    (
      ability_id: "static_01",
      presentation: OracleLines([3, 4]),
      definition: ConditionalSelfModifier(
        condition: SourceCounterCount(counter: Charge, min: Some(12)),
        add_types: (card_types: [Creature]),
        base_power: Some(7),
        base_toughness: Some(15),
        keywords: [Flying],
        triggered_abilities: [
          (
            ability_id: "triggered_02",
            presentation: OracleLines([4]),
            trigger: WheneverSelfAttacks(minimum_other_attackers: 0),
            effect: [
              Draw(count: Count(BattlefieldPermanents(filter: (controllers: Controller, matching: (kind: AnyPermanent, min_colors: Some(2)))))),
            ],
          ),
        ],
      ),
    ),
  ],
)
