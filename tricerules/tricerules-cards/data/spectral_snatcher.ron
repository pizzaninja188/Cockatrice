// Duskmourn: House of Horror. CR 702.21 / 702.29: Ward uses a discard resolution cost;
// Swampcycling is an activated ability from hand that discards this physical card as a cost.
(
  id: "spectral_snatcher",
  name: "Spectral Snatcher",
  mana_cost: "{4}{B}{B}",
  types: ["Creature", "Spirit"],
  power: 6,
  toughness: 5,
  triggered_abilities: [(
    trigger: WheneverSelfBecomesTarget(source: SpellOrAbility, source_controller: Opponent),
    effect: [CounterTriggeringStackObjectUnlessPays(cost: DiscardCard(filter: None))],
    text: "Ward—Discard a card",
  )],
  activated_abilities: [(
    source_zone: Hand,
    costs: [Mana("{2}"), DiscardSelf],
    effect: [SearchLibrary(
      filter: Some((subtype: Some("Swamp"))),
      destination: Hand,
      shuffle: true,
      reveal: true,
    )],
    text: "Swampcycling {2} ({2}, Discard this card: Search your library for a Swamp card, reveal it, put it into your hand, then shuffle.)",
  )],
)
