(
  id: "destructive_tampering",
  name: "Destructive Tampering",
  face_id: "destructive_tampering",
  mana_cost: "{2}{R}",
  types: ["Sorcery"],
  modal_spell: (
    min_modes: 1,
    max_modes: 1,
    modes: [
      (
        mode_id: "mode_01",
        presentation: OracleLines([2]),
        effects: [Destroy(
          subject: Chosen((kind: AnyPermanent, permanent_types: [Artifact])),
        )],
      ),
      (
        mode_id: "mode_02",
        presentation: OracleLines([3]),
        effects: [ApplyCombatRestriction(
          scope: Matching((kind: Creature, excluded_keywords: [Flying])),
          restriction: (cant_block: true),
        )],
      ),
    ],
  ),
)
