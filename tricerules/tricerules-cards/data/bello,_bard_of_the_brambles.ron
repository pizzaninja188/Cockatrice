// Checked 2026-10-12. CR 611.3 and 613.1d/f, 613.4b, 613.6 govern this shared multi-layer static.
(
    id: "bello,_bard_of_the_brambles",
    name: "Bello, Bard of the Brambles",
    face_id: "bello_bard_of_the_brambles",
    mana_cost: "{1}{R}{G}",
    supertypes: ["Legendary"],
    types: ["Creature", "Raccoon", "Bard"],
    power: 3,
    toughness: 3,
    static_abilities: [(
        ability_id: "static_01",
        presentation: OracleLines([1]),
        definition: ConditionalPermanentTransformation(
            filter: (any_of: Some([
                (kind: AnyPermanent, controller: You, permanent_types: [Artifact],
                    excluded_subtypes: ["Equipment"], min_mana_value: Some(4)),
                (kind: AnyPermanent, controller: You, permanent_types: [Enchantment],
                    excluded_subtypes: ["Aura"], min_mana_value: Some(4)),
            ])),
            condition: ActivePlayer(players: Controller),
            add_types: (card_types: [Creature], creature_types: ["Elemental"]),
            base_power: Some(4),
            base_toughness: Some(4),
            keywords: [Indestructible, Haste],
            triggered_abilities: [(
                ability_id: "triggered_01",
                presentation: OracleLines([1]),
                trigger: WheneverSelfDealsCombatDamageToPlayer,
                effect: [Draw(count: 1)],
            )],
        ),
    )],
)
