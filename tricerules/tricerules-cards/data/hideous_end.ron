// CR 115.1a/601.2c (target at cast), 701.8 (destroy), 105.2 (a black object is not a legal
// nonblack target), 119.3 (life loss) and 608.2b: an illegal sole target fizzles, so no life is
// lost. The pinned 2009-10-01 ruling confirms the whole-spell fizzle. Copy of Poison Arrow's
// nonblack destruction plus Victorious Destruction's controller life loss.
(
  id: "hideous_end",
  name: "Hideous End",
  face_id: "hideous_end",
  mana_cost: "{1}{B}{B}",
  types: ["Instant"],
  spell_effect: [
    Destroy(subject: Chosen((kind: Creature, not_color: Some(Black)))),
    LoseLife(amount: Fixed(2), who: ControllerOfTargetGroup(group_index: 0)),
  ],
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target nonblack creature",
    effect_indices: [0],
  )])),
)
