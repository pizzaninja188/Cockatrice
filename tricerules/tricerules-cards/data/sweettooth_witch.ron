// Pinned Oracle 635b854d-de71-4c85-9755-8c97bf3cba36; Scryfall text/four Food rulings checked 2026-09-22.
// Food is an artifact subtype, including nontoken Foods, and a sacrifice pays exactly one cost.
(
  id: "sweettooth_witch", name: "Sweettooth Witch", face_id: "sweettooth_witch",
  mana_cost: "{2}{B}", types: ["Creature", "Human", "Warlock"], power: 3, toughness: 2,
  triggered_abilities: [(
    ability_id: "triggered_01", presentation: OracleLines([1]), trigger: WhenSelfEntersBattlefield,
    effect: [CreateTokens(token: "food", count: 1)],
  )],
  activated_abilities: [(
    ability_id: "activated_01", presentation: OracleLines([2]),
    costs: [Mana("{2}"), SacrificePermanent(filter: (kind: AnyPermanent, controller: You, required_subtypes: ["Food"]))],
    effect: [TargetPlayerLosesLife(amount: 2, target: (kind: AnyPlayer))],
  )],
)
