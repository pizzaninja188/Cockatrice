(
  id: "bloodthirsty_aerialist",
  name: "Bloodthirsty Aerialist",
  mana_cost: "{1}{B}{B}",
  types: ["Creature", "Vampire", "Rogue"],
  power: 2,
  toughness: 3,
  keywords: [Flying],
  triggered_abilities: [
    (
      trigger: WheneverPlayerGainsLife(player: Controller),
