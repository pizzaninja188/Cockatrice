// Oracle and rulings verified against Scryfall on 2026-09-26 (Oracle ID 8ddfc283-c9b4-41a5-af88-cf0068e986cc).
// CR 608.2b, 701.6a, 701.7a, and 111.3-4 govern target legality, countering, and the Bird token.
(
  id: "swan_song",
  name: "Swan Song",
  face_id: "swan_song",
  mana_cost: "{U}",
  types: ["Instant"],
  spell_program: Some((body: (steps: [
    (id: "counter_spell", bind: ["target_controller"],
      kind: Perform(CounterTargetSpell(
        spell_filter: (any_of: Some([
          (card_type: Some(Enchantment)),
          (card_type: Some(Instant)),
          (card_type: Some(Sorcery)),
        ])),
      ))),
    (id: "create_bird", input: Some("target_controller"),
      kind: Perform(CreateTokens(
        token: "bird_u_2_2_flying",
        count: 1,
        who: ProgramInputPlayer,
      ))),
  ], yields: []), target_bindings: [
    (instruction_id: "counter_spell", role: Spell, target_group_index: 0),
  ])),
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target enchantment, instant, or sorcery spell",
    effect_indices: [],
  )])),
)
