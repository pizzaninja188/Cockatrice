// source when it is an artifact creature.
(
  id: "razorfield_rhino",
  name: "Razorfield Rhino",
  face_id: "razorfield_rhino",
  mana_cost: "{6}",
  types: ["Artifact", "Creature", "Rhino"],
  power: 4,
  toughness: 4,
  static_abilities: [
    (ability_id: "metalcraft", presentation: OracleLines([1]), definition: ConditionalSelfModifier(
      condition: BattlefieldAggregate(
        filter: (controllers: Controller, card_type: Some(Artifact)),
        aggregate: Count,
        min: Some(3),
      ),
      delta_power: 2,
      delta_toughness: 2,
    )),
  ],
)
