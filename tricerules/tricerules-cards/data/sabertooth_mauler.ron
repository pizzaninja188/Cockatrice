// Core Set 2021. CR 513.1-2 / 603.4: this triggers once at the beginning of its controller's
// end step only if a creature died earlier that turn, then checks the same condition on resolution.
(
  id: "sabertooth_mauler",
  name: "Sabertooth Mauler",
  face_id: "sabertooth_mauler",
  mana_cost: "{3}{G}",
  types: ["Creature", "Cat"],
  power: 3,
  toughness: 3,
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: OracleLines([1]),
      trigger: AtBeginningOfEndStep(player: Controller),
      intervening_if: Some(GameCondition(CreatureDeathsThisTurn(min: Some(1), max: None))),
      effect: [
        PutCounters(counter: PlusOnePlusOne, count: 1, subject: Source),
        Untap(subject: Source),
      ],
    ),
  ],
)
