// Oracle and rulings checked 2026-10-18 against the pinned source set.
// CR 603.4 checks Crime at trigger creation and resolution; CR 701.21a defines the sacrifice payment.
// A departed or stolen source cannot pay the optional self-sacrifice.
(
  id: "servant_of_the_stinger",
  name: "Servant of the Stinger",
  face_id: "servant_of_the_stinger",
  mana_cost: "{1}{B}",
  types: ["Creature", "Human", "Warlock"],
  power: 1,
  toughness: 3,
  keywords: [Deathtouch],
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([2]),
    trigger: WheneverSelfDealsCombatDamageToPlayer,
    intervening_if: Some(CrimesCommittedThisTurn(players: Controller, min: Some(1))),
    effect: [],
    program: Some((body: (steps: [
      (id: "choose_sacrifice", kind: Choose(
        choice: "sacrifice",
        chooser: Controller,
        optional: true,
        branches: [(
          branch_id: "sacrifice_servant_of_the_stinger",
          presentation: Fallback,
          cost: SacrificePermanent(
            filter: (kind: AnyPermanent, controller: You),
            source_only: true,
          ),
          requirement: Always,
          body: (steps: [
            (id: "search_library", kind: Perform(SearchLibrary(
              filter: None,
              destination: Hand,
              shuffle: true,
              reveal: false,
              selection_bounds: Some((min: 1, max: 1)),
            ))),
          ], yields: []),
        )],
        otherwise: (steps: [], yields: []),
      )),
    ], yields: []))),
  )],
)
