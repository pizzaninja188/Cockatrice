(
  id: "myr_retriever",
  name: "Myr Retriever",
  face_id: "myr_retriever",
  mana_cost: "{2}",
  types: ["Artifact", "Creature", "Myr"],
  power: 1,
  toughness: 1,
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([1]),
    trigger: WhenSelfDies,
    effect: [MoveGraveyardCards(
      filter: (
