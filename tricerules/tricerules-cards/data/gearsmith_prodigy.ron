// The battlefield condition is reevaluated continuously (CR 611.3 and 613.4c).
(
  id: "gearsmith_prodigy",
  name: "Gearsmith Prodigy",
  face_id: "gearsmith_prodigy",
  mana_cost: "{U}",
  types: ["Creature", "Human", "Artificer"],
  power: 1,
  toughness: 2,
  static_abilities: [
    (ability_id: "static_01", presentation: Fallback, definition: ConditionalSelfModifier(
      condition: BattlefieldAggregate(
        filter: (controllers: Controller, card_type: Some(Artifact)),
        aggregate: Count,
        min: Some(1),
      ),
      delta_power: 1,
    )),
  ],
)
