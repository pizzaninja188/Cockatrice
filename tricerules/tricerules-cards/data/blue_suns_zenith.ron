// Oracle/rulings verified 2026-10-01. CR 107.3, 121, 608.2c/m, 701.24c:
// draw the captured chosen X before moving/shuffling this resolving spell.
(
  id: "blue_suns_zenith",
  name: "Blue Sun's Zenith",
  face_id: "blue_suns_zenith",
  mana_cost: "{X}{U}{U}{U}",
  types: ["Instant"],
  spell_effect: [
    TargetPlayerDraws(count: "X", target: (kind: AnyPlayer)),
    ShuffleResolvingSpellIntoOwnersLibrary,
  ],
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target player",
    effect_indices: [0],
  )])),
)
