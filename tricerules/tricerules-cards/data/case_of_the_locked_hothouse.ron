(
    id: "case_of_the_locked_hothouse",
    name: "Case of the Locked Hothouse",
    face_id: "case_of_the_locked_hothouse",
    mana_cost: "{3}{G}",
    types: ["Enchantment", "Case"],
    static_abilities: [(
        ability_id: "static_01",
        presentation: OracleLines([1]),
        definition: ExtraLandPlays(count: 1),
    ), (
        ability_id: "static_02",
        presentation: OracleLines([3]),
        definition: LibraryTopPermission(
            look_at_top: true,
            cast_filter: Some((any_of: Some([
                (card_type: Some(Creature)),
                (card_type: Some(Enchantment)),
            ]))),
            play_lands: true,
            condition: Some(CaseSolved(solved: true)),
        ),
    )],
    triggered_abilities: [(
        ability_id: "triggered_01",
