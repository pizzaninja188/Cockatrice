// Oracle/rulings fetched 2026-08-27. CR 700.11 / 603.4: Descend remembers permanent-card
// entries even before this source arrived, and is checked at the beginning of the end step.
(
    id: "deep_goblin_skulltaker",
    name: "Deep Goblin Skulltaker",
    face_id: "deep_goblin_skulltaker",
    mana_cost: "{2}{B}",
    types: ["Creature", "Goblin", "Warrior"],
    power: 2,
    toughness: 2,
    keywords: [Menace],
    triggered_abilities: [(
        ability_id: "triggered_01",
        presentation: Fallback,
        trigger: AtBeginningOfEndStep(player: Controller),
        intervening_if: Some(GameCondition(PermanentCardsEnteredGraveyardThisTurn(players: Controller, min: Some(1)))),
        effect: [PutCounters(counter: PlusOnePlusOne, count: 1, subject: Source)],
    )],
)
