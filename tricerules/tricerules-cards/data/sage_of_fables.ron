// Oracle and rulings verified 2026-09-01. The counter-removal activation is a non-targeting cost.
(
  id: "sage_of_fables",
  name: "Sage of Fables",
  face_id: "sage_of_fables",
  mana_cost: "{2}{U}",
  types: ["Creature", "Merfolk", "Wizard"],
  power: 2,
  toughness: 2,
  static_abilities: [(
    ability_id: "static_01",
    presentation: OracleLines([1]),
    definition: EntersWithCounters(
      affected: Creatures((controller: Some(YouControl), subtype: Some("Wizard"), exclude_self: true)),
      counter: PlusOnePlusOne,
      amount: 1,
    ),
  )],
  activated_abilities: [(
    ability_id: "activated_01",
    presentation: OracleLines([2]),
    costs: [
      Mana("{2}"),
      RemoveCounters(
        counter: Some(PlusOnePlusOne),
        count: 1,
        payment_source: SelectedPermanent((kind: Creature, controller: You)),
      ),
    ],
    effect: [Draw(count: 1)],
  )],
)
