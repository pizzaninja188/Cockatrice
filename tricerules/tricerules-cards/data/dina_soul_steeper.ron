// Oracle 2121bcb4-f5fe-447f-9112-c7e5b5c45baf; source/rulings checked 2026-11-24 against the pinned Scryfall bulk
// SHA-256 a9a2fd3b550cc5cff4cec9bbc82aaf5fb8e3f781b4b95a896a0d94c15dce7853.
// CR 118.3/119.3 (one life-gain event drains each opponent for exactly 1), 602.1a/602.2
// (the activated ability), 701.21a (sacrifice as a cost), 611.2a/613.4c (until-end-of-turn
// pump) and 514.2 (cleanup). The pinned 2021-04-16 rulings confirm one trigger per life-gain
// event, a fixed 1-life loss regardless of the amount gained, and that X is the sacrificed
// creature's power on the battlefield, not in the graveyard.
(
  id: "dina,_soul_steeper",
  name: "Dina, Soul Steeper",
  face_id: "dina_soul_steeper",
  mana_cost: "{B}{G}",
  supertypes: ["Legendary"],
  types: ["Creature", "Dryad", "Druid"],
  power: 1,
  toughness: 3,
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([1]),
    trigger: WheneverPlayerGainsLife(),
    effect: [LoseLife(amount: Fixed(1), who: EachOpponent)],
  )],
  activated_abilities: [(
    ability_id: "activated_01",
    presentation: OracleLines([2]),
    costs: [
      Mana("{1}"),
      SacrificePermanent(filter: (kind: Creature, controller: You, excluded_objects: [Source])),
    ],
    effect: [PumpTarget(
      power: 0,
      toughness: 0,
      subject: Source,
      scale: Some((
        basis: Amount(Count(CardResultCharacteristicSum(
          filter: (
            source: Payment,
            action: Sacrifice,
            players: All,
            card_type: Some(Creature),
          ),
          characteristic: Power,
        ))),
        power_per_unit: 1,
        toughness_per_unit: 0,
      )),
    )],
  )],
)
