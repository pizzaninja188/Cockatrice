(
  id: "hero_in_training",
  name: "Hero in Training",
  face_id: "hero_in_training",
  mana_cost: "{2}{W}",
  types: ["Creature", "Human", "Hero"],
  power: 2,
  toughness: 2,
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([1]),
    trigger: WhenSelfEntersBattlefield,
    program: Some((
      body: (steps: [
        (id: "draw_one",
          kind: Perform(Draw( count: 1))),
        (id: "another_hero",
          kind: If(
            condition: BattlefieldAggregate(
              filter: (
                controllers: Controller,
                required_subtypes: ["Hero"],
                exclude_source: true,
              ),
              aggregate: Count,
              min: Some(1),
            ),
            yes: (steps: [
              (id: "gain_two_life",
                kind: Perform(GainLife(amount: 2))),
            ]),
            no: (),
          )),
      ]),
    )),
  )],
)
