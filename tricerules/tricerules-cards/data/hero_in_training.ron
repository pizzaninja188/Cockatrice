(
  id: "hero_in_training",
  name: "Hero in Training",
  face_id: "hero_in_training",
  mana_cost: "{2}{W}",
  types: ["Creature", "Human", "Hero"],
  power: 2,
  toughness: 2,
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([1]),
    trigger: WhenSelfEntersBattlefield,
    effect: [
      Draw(count: 1),
      ChooseResolutionBranch(
        selection: FirstApplicable,
        branches: [
          (
            branch_id: "another_hero",
            presentation: Fallback,
            cost: None,
            requirement: GameCondition(BattlefieldCreatureCount(
              filter: (controllers: Controller, subtype: Some("Hero"), exclude_source: true),
              min: Some(1),
            )),
            effects: [GainLife(amount: 2)],
          ),
          (branch_id: "no_other_hero", presentation: Fallback, cost: None, requirement: Always, effects: []),
        ],
      ),
    ],
  )],
)
