// Oracle and rulings fetched 2026-08-27. CR 603.12: target the reflexive trigger after payment.
(
  id: "icewrought_sentry",
  name: "Icewrought Sentry",
  mana_cost: "{2}{U}",
  types: ["Creature", "Elemental", "Soldier"],
  power: 2,
  toughness: 3,
  keywords: [Vigilance],
  triggered_abilities: [(
    trigger: WheneverSelfAttacks(minimum_other_attackers: 0),
    effect: [ChooseResolutionBranch(
      optional: true,
      branches: [(
        label: "Pay {1}{U}",
        cost: Mana("{1}{U}"),
        effects: [CreateReflexiveTrigger(ability: (
          effect: [Tap(subject: Chosen((kind: Creature, controller: Opponent)))],
          text: "When you do, tap target creature an opponent controls.",
        ))],
      )],
    )],
    text: "Whenever this creature attacks, you may pay {1}{U}. When you do, tap target creature an opponent controls.",
  ), (
    trigger: WheneverPlayerTapsCreature(player: Controller, controllers: Opponents, cardinality: EachObject),
    effect: [PumpTarget(power: 2, toughness: 1, subject: Source)],
    text: "Whenever you tap an untapped creature an opponent controls, this creature gets +2/+1 until end of turn.",
  )],
)
