// CR 603.6a (enters trigger), 701.22 (Scry) and 101.4/701.22c (each opponent makes their own scry
// choice in turn order and looks privately). Pinned 2023-02-04 ruling: first the controller scries
// two, then each opponent in turn order chooses whether to scry one; accepting opponents look at
// their top card at the same time and then decide in turn order. Copy of Kaya, Intangible Slayer's
// ordered Draw + EachOpponentMayScry composition with the controller's Scry leading.
(
  id: "myr_custodian",
  name: "Myr Custodian",
  face_id: "myr_custodian",
  mana_cost: "{3}",
  types: ["Artifact", "Creature", "Myr"],
  power: 2,
  toughness: 3,
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: OracleLines([1]),
      trigger: WhenSelfEntersBattlefield,
      effect: [Scry(count: 2), EachOpponentMayScry(count: 1)],
    ),
  ],
)
