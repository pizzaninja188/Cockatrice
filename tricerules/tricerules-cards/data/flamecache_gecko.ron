// Oracle and rulings fetched 2026-08-27. CR 119, 603.4, 605.1b: the ETB trigger uses
// the stack, and an opponent's earlier gain does not cancel their life-loss history.
(
  id: "flamecache_gecko",
  name: "Flamecache Gecko",
  face_id: "flamecache_gecko",
  mana_cost: "{1}{R}",
  types: ["Creature", "Lizard", "Warlock"],
  power: 2,
  toughness: 2,
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([1]),
    trigger: WhenSelfEntersBattlefield,
    intervening_if: Some(GameCondition(LifeChangedThisTurn(
      players: Relative(Opponents), change: Loss, quantifier: Any,
    ))),
    effect: [AddMana(amount: (b: 1, r: 1), retention: EndOfStep)],
  )],
  activated_abilities: [(
    ability_id: "activated_01",
    presentation: OracleLines([2]),
    costs: [Mana("{1}{R}"), Discard],
    effect: [Draw(count: 1)],
  )],
)
