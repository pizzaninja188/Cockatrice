// Oracle and rulings checked 2026-08-27. CR 700.14; ordinary sourced damage to each opponent.
(
  id: "teapot_slinger",
  name: "Teapot Slinger",
  mana_cost: "{3}{R}",
  types: ["Creature", "Raccoon", "Warrior"],
  power: 3,
  toughness: 4,
  keywords: [Menace],
  triggered_abilities: [(
    trigger: WheneverPlayerExpendsMana(amount: 4),
    effect: [DamagePlayer(amount: 2, who: EachOpponent)],
    text: "Whenever you expend 4, this creature deals 2 damage to each opponent.",
  )],
)
