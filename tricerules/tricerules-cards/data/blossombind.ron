// Oracle/rulings verified 2026-08-28. CR 101.2, 120.3, 122: prohibitions do not prevent damage.
(
  id: "blossombind",
  name: "Blossombind",
  face_id: "blossombind",
  mana_cost: "{1}{U}",
  types: ["Enchantment", "Aura"],
  spell_effect: [AuraAttach(target: (kind: Creature))],
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([2]),
    trigger: WhenSelfEntersBattlefield,
    effect: [Tap(subject: AttachedObject)],
  )],
  static_abilities: [
    (ability_id: "static_01", presentation: Fallback, definition: AttachedModifier(cant_untap: true)),
    (ability_id: "static_02", presentation: Fallback, definition: ProhibitCounters(affected: AttachedPermanent)),
  ],
)
