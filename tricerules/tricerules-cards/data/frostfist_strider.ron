// target is legal. Copy of Rimeshield Frost Giant's Ward {2} trigger and Alchemax Slayer-Bots'
// tap-plus-stun trigger.
(
  id: "frostfist_strider",
  name: "Frostfist Strider",
  face_id: "frostfist_strider",
  mana_cost: "{3}{U}{U}",
  types: ["Creature", "Elemental", "Giant"],
  power: 4,
  toughness: 4,
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: OracleLines([1]),
      trigger: WheneverSelfBecomesTarget(source: SpellOrAbility, source_controller: Opponent),
      program: Some((body: (steps: [
        (id: "ward", kind: Perform(CounterTriggeringStackObjectUnlessPays(cost: Mana("{2}")))),
      ]))),
    ),
    (
      ability_id: "triggered_02",
      presentation: OracleLines([2]),
      trigger: WhenSelfEntersBattlefield,
      effect: [
        Tap(subject: Chosen((kind: Creature, controller: Opponent))),
        PutCounters(counter: Stun, count: 1, subject: Chosen((kind: Creature, controller: Opponent))),
