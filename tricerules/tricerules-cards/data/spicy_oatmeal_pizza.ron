// Oracle and rulings verified 2026-09-01. The self-damage is untargeted damage, not life loss.
(
  id: "spicy_oatmeal_pizza",
  name: "Spicy Oatmeal Pizza",
  face_id: "spicy_oatmeal_pizza",
  mana_cost: "{2}{R}",
  types: ["Artifact", "Food"],
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([1]),
    trigger: WhenSelfEntersBattlefield,
    effect: [
      DamageTarget(amount: 4, target: (kind: AnyTarget)),
      DamagePlayer(amount: 3, who: Controller),
    ],
    targeting: Some((groups: [(
      min: 1,
      max: 1,
      prompt: "Choose any target",
      effect_indices: [0],
    )])),
  )],
  activated_abilities: [(
    ability_id: "activated_01",
    presentation: OracleLines([2]),
    costs: [Mana("{2}"), Tap, SacrificeSelf],
    effect: [GainLife(amount: 3)],
  )],
)
