// CR 301.7/301.7a and 208.3 (a noncreature Vehicle has no body), 702.122a-e (crew), 702.9 (flying) and 611.2a/514.2 (the type change ends at
// cleanup). Pinned 2017-09-29 rulings confirm a Vehicle is not a creature until crewed, crew taps
// any untapped creatures you control including one that just entered, you may tap more than
// necessary, and becoming a creature is not an enters-the-battlefield event. Copy of Consulate
// Dreadnought's crew ability with Brute Suit's printed-keyword layout.
(
  id: "sky_skiff",
  name: "Sky Skiff",
  face_id: "sky_skiff",
  mana_cost: "{2}",
  types: ["Artifact", "Vehicle"],
  power: 2,
  toughness: 3,
  keywords: [Flying],
  activated_abilities: [
    (
      ability_id: "crew",
      presentation: OracleLines([2]),
      costs: [TapPermanents(
        constraint: AggregateMinimum(minimum: 1, contribution: CurrentPower),
        filter: (kind: Creature, controller: You),
        exclude_source: true,
      )],
      effect: [AddTypes(subject: Source, addition: (card_types: [Creature]))],
    ),
  ],
)
