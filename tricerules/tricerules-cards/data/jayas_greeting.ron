// Oracle 1be474c6-5a9f-4c58-adc6-c1508348adea; source/rulings checked 2026-11-24 against the
// pinned Scryfall bulk SHA-256 a9a2fd3b550cc5cff4cec9bbc82aaf5fb8e3f781b4b95a896a0d94c15dce7853.
// CR 115.1/601.2c (one creature target), 120.3 (damage), 701.22a-b (scry) and 608.2b (a stale
// sole target fizzles the spell, so scry does not happen). Pinned 2019-05-03 ruling: an illegal
// target means the spell does not resolve and the controller does not scry. Copy of Unsubtle
// Mockery's damage-then-scry shape.
(
  id: "jayas_greeting",
  name: "Jaya's Greeting",
  face_id: "jayas_greeting",
  mana_cost: "{1}{R}",
  types: ["Instant"],
  spell_effect: [
    DamageTarget(amount: 3, target: (kind: Creature)),
    Scry(count: 1),
  ],
  targeting: Some((groups: [(min: 1, max: 1, effect_indices: [0])])),
)
