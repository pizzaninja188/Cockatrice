  face_id: "crypt_lurker",
  mana_cost: "{3}{B}",
  types: ["Creature", "Horror"],
  power: 3,
  toughness: 4,
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: OracleLines([1]),
      trigger: WhenSelfEntersBattlefield,
      program: Some((body: (steps: [
        (id: "choose_crypt_lurker_cost", kind: Choose(
          choice: "crypt_lurker",
          chooser: Controller,
          optional: true,
          branches: [
            (
              branch_id: "sacrifice_a_creature", presentation: Fallback,
              cost: SacrificePermanent(filter: (kind: Creature, controller: You)),
              body: (steps: [
                (id: "draw_after_sacrifice", kind: Perform(Draw( count: 1))),
              ]),
            ),
            (
              branch_id: "discard_a_creature_card", presentation: Fallback,
              cost: DiscardCard(filter: Some(Creature)),
              body: (steps: [
                (id: "draw_after_discard", kind: Perform(Draw( count: 1))),
              ]),
            ),
          ],
          otherwise: (),
        )),
      ]))),
    ),
  ],
)
