// Oracle 093f6123-6b1d-456f-a526-8740bc969b4e; source/rulings checked 2026-11-24 against the
// pinned Scryfall bulk SHA-256 a9a2fd3b550cc5cff4cec9bbc82aaf5fb8e3f781b4b95a896a0d94c15dce7853.
// CR 509.1b (the source-only blocking restriction), 603.6a (entry trigger), 701.26 (tap),
// 122.1f (stun counter) and 115.1 (one chosen opponent creature). The pinned 2024-11-08 ruling
// confirms an already-tapped target is legal and still receives the stun counter. Copy of
// Alchemax Slayer-Bots' tap-plus-stun trigger and Plasma Elemental's unblockable static.
(
  id: "gilded_scuttler",
  name: "Gilded Scuttler",
  face_id: "gilded_scuttler",
  mana_cost: "{2}{U}",
  types: ["Artifact", "Creature", "Crab"],
  power: 1,
  toughness: 3,
  static_abilities: [(
    ability_id: "static_01",
    presentation: OracleLines([1]),
    definition: SelfCombatRestriction(restriction: (cant_be_blocked: true)),
  )],
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([2]),
    trigger: WhenSelfEntersBattlefield,
    effect: [
      Tap(subject: Chosen((kind: Creature, controller: Opponent))),
      PutCounters(counter: Stun, count: 1, subject: Chosen((kind: Creature, controller: Opponent))),
    ],
    targeting: Some((groups: [(min: 1, max: 1, effect_indices: [0, 1])])),
  )],
)
