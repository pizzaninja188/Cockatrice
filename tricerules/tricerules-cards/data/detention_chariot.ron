// review map and packet evidence live under authoring/review-maps and build/direct-ron.
// CR 603.6a (entry trigger), CR 610.3/608.2b (exile until source leaves; a source that has
// already left does not exile the target), CR 702.29 (cycling from hand), and CR 702.122 (crew).
(
  id: "detention_chariot",
  name: "Detention Chariot",
  face_id: "detention_chariot",
  mana_cost: "{4}{W}{W}",
  types: ["Artifact", "Vehicle"],
  power: 6,
  toughness: 6,
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([1]),
    trigger: WhenSelfEntersBattlefield,
    effect: [ExileUntilSourceLeaves(target: (
      kind: AnyPermanent,
      controller: Opponent,
      permanent_types: [Artifact, Creature],
    ))],
    targeting: Some((groups: [(
      min: 1,
      max: 1,
      prompt: "Choose target artifact or creature an opponent controls",
      effect_indices: [0],
    )])),
  )],
  activated_abilities: [
    (
      ability_id: "activated_01",
      presentation: OracleLines([2]),
      costs: [TapPermanents(
        constraint: AggregateMinimum(minimum: 3, contribution: CurrentPower),
        filter: (kind: Creature, controller: You),
        exclude_source: true,
      )],
      effect: [AddTypes(subject: Source, addition: (card_types: [Creature]))],
    ),
    (
      ability_id: "activated_02",
      presentation: OracleLines([3]),
      source_zone: Hand,
      costs: [Mana("{W}"), DiscardSelf],
      effect: [Draw(count: 1)],
    ),
  ],
)
