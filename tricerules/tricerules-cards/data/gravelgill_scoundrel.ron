// Oracle and rulings checked 2026-08-26. This is an optional resolution payment, not a target;
// the creature may have entered this turn, while the restriction stays on the attacking incarnation.
(
  id: "gravelgill_scoundrel",
  name: "Gravelgill Scoundrel",
  face_id: "gravelgill_scoundrel",
  mana_cost: "{1}{U}",
  types: ["Creature", "Merfolk", "Rogue"],
  power: 1,
  toughness: 3,
  keywords: [Vigilance],
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([2]),
    trigger: WheneverSelfAttacks(minimum_other_attackers: 0),
    program: Some((body: (steps: [
      (id: "choose_tap", kind: Choose(
        choice: "tap_permanent", chooser: Controller, optional: true,
        branches: [(
          branch_id: "tap_another_untapped_creature_you_control", presentation: Fallback,
          cost: TapPermanents(
            count: 1,
            filter: (kind: Creature, controller: You),
            exclude_source: true,
          ),
          body: (steps: [
            (id: "make_unblockable",
              kind: Perform(ApplyCombatRestriction(
                scope: Source,
                restriction: (cant_be_blocked: true),
              ))),
          ]),
        )],
        otherwise: (),
      )),
    ]))),
  )],
)
