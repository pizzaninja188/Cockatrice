// 603.6c, 603.10a, 608.2b, 608.2h.
(
  id: "scrap_trawler",
  name: "Scrap Trawler",
  face_id: "scrap_trawler",
  mana_cost: "{3}",
  types: ["Artifact", "Creature", "Construct"],
  power: 3,
  toughness: 2,
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: OracleLines([1]),
      trigger: WhenSelfDies,
      effect: [MoveGraveyardCards(
        filter: (
          owner: Controller,
          card: Some((card_type: Some(Artifact))),
