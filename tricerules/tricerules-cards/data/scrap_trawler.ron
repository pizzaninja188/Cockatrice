      )])),
    ),
    (
      ability_id: "triggered_02",
      presentation: OracleLines([1]),
      trigger: WheneverPermanentLeavesBattlefield(
        controller: Controller,
        filter: (permanent_type: Some(Artifact), exclude_source: true),
        destination: OneOf([Graveyard]),
        cardinality: EachObject,
      ),
      effect: [MoveGraveyardCards(
        filter: (
          owner: Controller,
          card: Some((card_type: Some(Artifact))),
          mana_value_less_than_trigger_object: true,
        ),
        destination: Hand,
      )],
      targeting: Some((groups: [(
        min: 1,
        max: 1,
        prompt: "Choose target artifact card with lower mana value from your graveyard",
        effect_indices: [0],
      )])),
