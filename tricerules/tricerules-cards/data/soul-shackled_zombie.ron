// Oracle checked 2026-10-20. The named Exile result counts successful target-card Exile actions.
(
  id: "soul-shackled_zombie",
  name: "Soul-Shackled Zombie",
  face_id: "soul_shackled_zombie",
  mana_cost: "{3}{B}",
  types: ["Creature", "Zombie"],
  power: 4,
  toughness: 2,
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([1]),
    trigger: WhenSelfEntersBattlefield,
    program: Some((body: (steps: [
      (id: "exile_graveyard_cards", bind: ["exiled"],
        kind: Perform(MoveGraveyardCards(
          filter: (owner: AnyPlayer),
          destination: Exile,
        ))),
      (id: "drain_if_creature_exiled",
        kind: IfResult(
          condition: CardResultCount(
            result: "exiled",
            card_type: Some(Creature),
            min: Some(1),
          ),
          yes: (steps: [
            (id: "lose_life",
              kind: Perform(LoseLife(amount: Fixed(2), who: EachOpponent))),
            (id: "gain_life",
              kind: Perform(GainLife(amount: 2))),
          ]),
          no: (),
        )),
    ]), target_bindings: [
      (instruction_id: "exile_graveyard_cards", role: Target, target_group_index: 0),
    ])),
    targeting: Some((groups: [(
      min: 0,
      max: 2,
      prompt: "Choose up to two target cards from a single graveyard",
      effect_indices: [],
      same_graveyard: true,
    )])),
  )],
)
