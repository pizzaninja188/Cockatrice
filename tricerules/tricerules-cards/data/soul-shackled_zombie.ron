// Oracle checked 2026-08-24. The branch reads the exact cards this instruction actually exiled.
(
  id: "soul-shackled_zombie",
  name: "Soul-Shackled Zombie",
  mana_cost: "{3}{B}",
  types: ["Creature", "Zombie"],
  power: 4,
  toughness: 2,
  triggered_abilities: [(
    trigger: WhenSelfEntersBattlefield,
    effect: [
      MoveGraveyardCards(filter: (owner: AnyPlayer), destination: Exile),
      ChooseResolutionBranch(
        selection: FirstApplicable,
        branches: [
          (
            label: "Drain each opponent",
            cost: None,
            requirement: CardResultCount(
              filter: (
                source: PreviousEffect,
                action: Exile,
                players: All,
                card_type: Some(Creature),
              ),
              min: Some(1),
            ),
            effects: [
              DamagePlayer(amount: 2, who: EachOpponent),
              GainLife(amount: 2),
            ],
          ),
          (
            label: "No additional effect",
            cost: None,
            requirement: Always,
            effects: [],
          ),
        ],
      ),
    ],
    targeting: Some((groups: [(
      min: 0,
      max: 2,
      prompt: "Choose up to two target cards from a single graveyard",
      effect_indices: [0],
      same_graveyard: true,
    )])),
    text: "When this creature enters, exile up to two target cards from a single graveyard. If at least one creature card was exiled this way, each opponent loses 2 life and you gain 2 life.",
  )],
)
