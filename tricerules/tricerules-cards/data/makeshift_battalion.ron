// Oracle and rulings checked 2026-08-11. The attack-group threshold is part of the trigger event,
// not an intervening "if": once the ability triggers, later removing another attacker does not
// stop it. Attackers may be attacking different players or permanents.
(
  id: "makeshift_battalion",
  name: "Makeshift Battalion",
  face_id: "makeshift_battalion",
  mana_cost: "{2}{W}",
  types: ["Creature", "Human", "Soldier"],
  power: 3,
  toughness: 2,
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: OracleLines([1]),
      trigger: WheneverSelfAttacks(minimum_other_attackers: 2),
      effect: [PutCounters(counter: PlusOnePlusOne, count: 1, subject: Source)],
    ),
  ],
)
