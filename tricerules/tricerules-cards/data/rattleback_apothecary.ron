// Oracle and rulings verified 2026-08-27. The keyword is chosen on resolution, not as a trigger mode.
(
  id: "rattleback_apothecary",
  name: "Rattleback Apothecary",
  mana_cost: "{2}{B}",
  types: ["Creature", "Gorgon", "Warlock"],
  power: 3,
  toughness: 2,
  keywords: [Deathtouch],
  triggered_abilities: [(
    trigger: WheneverPlayerCommitsCrime(player: Controller),
    effect: [GrantKeywordChoice(subject: Chosen((kind: Creature, controller: You)), choices: [Menace, Lifelink])],
    text: "Whenever you commit a crime, target creature you control gains your choice of menace or lifelink until end of turn.",
  )],
)
