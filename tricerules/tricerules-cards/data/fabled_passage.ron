// Oracle and rulings checked against Scryfall on 2026-09-04.
// CR 608.2c/h, 701.23, 701.26a/b, and 400.7: bind the found land after it enters, then inspect the
// post-search battlefield and untap that exact physical object when four lands are controlled.
(
  id: "fabled_passage",
  name: "Fabled Passage",
  face_id: "fabled_passage",
  mana_cost: "",
  types: ["Land"],
  activated_abilities: [(
    ability_id: "activated_01",
    presentation: OracleLines([1]),
    costs: [Tap, SacrificeSelf],
    effect: [],
    program: Some((body: (steps: [
      (id: "find_basic_land", bind: ["found_land"], kind: Perform(SearchLibrary(
        filter: Some((card_type: Some(BasicLand))),
        zones: Fixed([Library]),
        destination: Battlefield(tapped: true),
        selection_bounds: Some((min: 0, max: 1)),
      ))),
      (id: "check_four_lands", kind: If(
        condition: BattlefieldAggregate(
          filter: (controllers: Controller, card_type: Some(Land)),
          aggregate: Count,
          min: Some(4),
        ),
        yes: (steps: [
          (id: "untap_found_land", input: Some("found_land"), kind: Perform(
            Untap(subject: PreviousEffectObject),
          )),
        ]),
        no: (),
      )),
    ]))),
  )],
)
