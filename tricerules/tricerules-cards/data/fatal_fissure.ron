(
  id: "fatal_fissure",
  name: "Fatal Fissure",
  face_id: "fatal_fissure",
  mana_cost: "{1}{B}",
  types: ["Instant"],
  spell_effect: [CreateDelayedTrigger(
    subject: Some(Chosen((kind: Creature))),
