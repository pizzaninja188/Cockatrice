// Oracle and rulings verified 2026-09-01. The type and base-P/T instructions
// are separate, ordered effects that share one target.
(
  id: "mind_transfer_protocol",
  name: "Mind Transfer Protocol",
  face_id: "mind_transfer_protocol",
  mana_cost: "{2}{U}",
  types: ["Instant"],
  spell_effect: [
    AddTypes(
      subject: Chosen((any_of: Some([
        (kind: AnyPermanent, permanent_types: [Artifact]),
        (kind: Creature),
      ]))),
      addition: (card_types: [Artifact, Creature]),
    ),
    SetBasePowerToughness(
      target: (any_of: Some([
        (kind: AnyPermanent, permanent_types: [Artifact]),
        (kind: Creature),
      ])),
      power: Fixed(4),
      toughness: Fixed(5),
    ),
    Draw(count: 1),
  ],
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target artifact or creature",
    effect_indices: [0, 1],
  )])),
)
