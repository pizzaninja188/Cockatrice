(
  id: "erratic_apparition",
  name: "Erratic Apparition",
  mana_cost: "{2}{U}",
  types: ["Creature", "Spirit"],
  power: 1,
  toughness: 3,
  keywords: [Flying, Vigilance],
  triggered_abilities: [
    (
      trigger: WheneverPermanentEntersBattlefield(
        controller: Controller,
        filter: (permanent_type: Some(Enchantment)),
      ),
      effect: [PumpTarget(power: 1, toughness: 1, subject: Source)],
      text: "Whenever an enchantment you control enters, this creature gets +1/+1 until end of turn.",
    ),
    (
      trigger: WheneverPlayerFullyUnlocksRoom(player: Controller),
      effect: [PumpTarget(power: 1, toughness: 1, subject: Source)],
      text: "Whenever you fully unlock a Room, this creature gets +1/+1 until end of turn.",
    ),
  ],
)
