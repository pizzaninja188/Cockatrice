(
  id: "brainstorm",
  name: "Brainstorm",
  face_id: "brainstorm",
  mana_cost: "{U}",
  types: ["Instant"],
  spell_program: Some((body: (
    steps: [
      (id: "draw_three", kind: Perform(Draw(who: Controller, count: 3))),
      (id: "choose_put_back", bind: ["chosen"], kind: Perform(SelectHandCards(
        count: 2,
        ordered: true,
        prompt: "Brainstorm: choose cards from your hand to put on top of your library (last chosen on top)."
      ))),
      (id: "put_back", input: Some("chosen"), kind: Perform(PutSelectedHandCardsOnLibraryTop))
    ],
    yields: []
  ))),
)
