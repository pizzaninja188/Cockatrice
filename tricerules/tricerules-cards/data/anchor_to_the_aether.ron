// CR 115.1/601.2c (one creature target), 401.4 (top of library), 701.22a-b (scry) and
// 608.2b (a stale sole target fizzles the whole spell, so scry does not happen). Copy of
// Excommunicate's put-on-top Program with an appended Opt-style scry step.
(
  id: "anchor_to_the_aether",
  name: "Anchor to the Aether",
  face_id: "anchor_to_the_aether",
  mana_cost: "{2}{U}",
  types: ["Sorcery"],
  spell_program: Some((
    body: (steps: [
      (id: "put_in_owners_library",
        kind: Perform(PutInOwnersLibrary(
          subject: Chosen((kind: Creature)), placement: Top,
        ))),
      (id: "scry", kind: Perform(Scry(count: 1))),
    ]),
    target_bindings: [(instruction_id: "put_in_owners_library", role: Subject, target_group_index: 0)],
  )),
  targeting: Some((groups: [(min: 1, max: 1, effect_indices: [])])),
)
