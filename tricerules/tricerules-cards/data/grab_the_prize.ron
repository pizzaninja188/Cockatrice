// Oracle checked 2026-10-20. CR 118.8/601.2h: the discard is paid with the total cost.
// CR 608.2i and 707.10: resolution and spell copies use the exact paid card snapshot.
(
  id: "grab_the_prize",
  name: "Grab the Prize",
  face_id: "grab_the_prize",
  mana_cost: "{1}{R}",
  types: ["Sorcery"],
  additional_costs: [DiscardCard],
  spell_program: Some((
    body: (steps: [
      (id: "import_paid_discard", bind: ["paid_discard"],
        kind: ImportCastPayment),
      (id: "draw_two",
        kind: Perform(Draw(count: 2))),
      (id: "check_paid_card_type",
        kind: IfResult(
          condition: CardResultCount(result: "paid_discard", card_type: Some(Nonland),
            min: Some(1)),
          yes: (steps: [
            (id: "damage_each_opponent",
              kind: Perform(DamagePlayer(amount: 2, who: EachOpponent))),
          ]),
          no: (),
        )),
    ]),
  )),
)
