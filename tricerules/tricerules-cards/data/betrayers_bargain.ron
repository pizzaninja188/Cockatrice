(
  id: "betrayers_bargain",
  name: "Betrayer's Bargain",
  face_id: "betrayers_bargain",
  mana_cost: "{1}{R}",
  types: ["Instant"],
  cast_cost_groups: [(
    group_id: "additional_cost",
    presentation: OracleLines([1]),
    min: 1,
    max: 1,
    options: [
      SacrificePermanent(
        option_id: "sacrifice_creature_or_enchantment",
        presentation: OracleLines([1]),
        kind: AdditionalPayment,
        filter: (any_of: Some([
          (kind: Creature, controller: You),
          (kind: AnyPermanent, controller: You, permanent_types: [Enchantment]),
        ])),
      ),
      Mana(
        option_id: "pay_mana",
        presentation: OracleLines([1]),
        kind: AdditionalPayment,
        cost: "{2}",
      ),
    ],
  )],
  spell_effect: [
    DamageTarget(amount: 5, target: (kind: Creature)),
    ExileIfWouldDieThisTurn(target: (kind: Creature)),
  ],
  targeting: Some((
    groups: [(
      min: 1,
      max: 1,
      prompt: "Choose target creature",
      effect_indices: [0, 1],
    )],
  )),
)
