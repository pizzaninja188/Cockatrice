// Oracle 984336a7-85bd-4549-9771-03a0c2367db0; source/rulings checked 2026-11-24 against the
// pinned Scryfall bulk SHA-256 a9a2fd3b550cc5cff4cec9bbc82aaf5fb8e3f781b4b95a896a0d94c15dce7853.
// CR 701.26 (untap), 613.4c (layer-7c pump) and 702.9 (flying). The pinned 2019-05-03 ruling
// confirms only creatures controlled at resolution that have flying then get +2/+2. Copy of Rally
// to Battle's untap-plus-scoped-pump shape with a current-flying scope.
(
  id: "rally_of_wings",
  name: "Rally of Wings",
  face_id: "rally_of_wings",
  mana_cost: "{1}{W}",
  types: ["Instant"],
  spell_effect: [
    UntapAll(players: Controller),
    PumpAll(
      filter: (controller: YouControl, required_keyword: Flying),
      power: 2,
      toughness: 2,
    ),
  ],
)
