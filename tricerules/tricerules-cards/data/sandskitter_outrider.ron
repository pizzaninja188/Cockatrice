(
  id: "sandskitter_outrider",
  name: "Sandskitter Outrider",
  mana_cost: "{3}{B}",
  types: ["Creature", "Goblin", "Soldier"],
  power: 2,
  toughness: 1,
  keywords: [Menace],
  triggered_abilities: [
    (
      trigger: WhenSelfEntersBattlefield,
      effect: [ChooseResolutionBranch(
        chooser: SourceController,
        optional: false,
        branches: [
          (
            label: "Put two +1/+1 counters on Sandskitter Outrider",
            cost: None,
            requirement: EffectsApplicable,
            effects: [PutCounters(counter: PlusOnePlusOne, count: 2, subject: Source)],
          ),
          (
            label: "Create a 2/2 white Spirit creature token",
            cost: None,
            requirement: Always,
            effects: [CreateTokens(token: "spirit_w_2_2", count: 1, who: SourceController)],
          ),
        ],
      )],
      text: "When this creature enters, endure 2. (Put two +1/+1 counters on it or create a 2/2 white Spirit creature token.)",
    ),
  ],
)
