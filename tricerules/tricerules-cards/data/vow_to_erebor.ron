// Oracle and rulings checked against Scryfall on 2026-09-01. CR 115.10/608.2d:
// the Equipment is an optional resolution choice, not an additional target.
(
  id: "vow_to_erebor",
  name: "Vow to Erebor",
  face_id: "vow_to_erebor",
  mana_cost: "{1}{W}",
  types: ["Instant"],
  spell_effect: [
    Untap(subject: Chosen((kind: Creature, controller: You))),
    PumpTarget(
      power: 2,
      toughness: 2,
      subject: Chosen((kind: Creature, controller: You)),
    ),
    Conditional(
      condition: ObjectMatches(
        object: ChosenTarget(group_index: 0, target_index: 0),
        filter: (kind: Creature, required_subtypes: ["Dwarf"]),
      ),
      effect: ChoosePermanents(
        chooser: Controller,
        filter: (
          kind: AnyPermanent,
          controller: You,
          required_subtypes: ["Equipment"],
        ),
        min: 0,
        max: 1,
        constraints: [EquipmentAttachableTo(
          recipient: ChosenTarget(group_index: 0, target_index: 0),
        )],
      ),
    ),
    AttachEquipment(
      equipment: PreviousEffectObject,
      creature: Chosen((kind: Creature, controller: You)),
    ),
  ],
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target creature you control",
    effect_indices: [0, 1, 3],
  )])),
)
