(
  id: "apostles_blessing",
  name: "Apostle's Blessing",
  face_id: "apostle_s_blessing",
  mana_cost: "{1}{W/P}",
  // CR 702.16 protection choice and restricted permanent targeting.
  types: ["Instant"],
  spell_effect: [
    GrantProtection(
      subject: Chosen((
        kind: AnyPermanent,
        controller: You,
        permanent_types: [Artifact, Creature],
      )),
      protection: Choose([
        CardType(Artifact),
        Color(White),
        Color(Blue),
        Color(Black),
        Color(Red),
        Color(Green),
      ]),
    ),
  ],
)
