// to this battlefield object incarnation; leaving and returning creates a fresh object (CR 400.7).
(
  id: "acrobatic_cheerleader",
  name: "Acrobatic Cheerleader",
  face_id: "acrobatic_cheerleader",
  mana_cost: "{1}{W}",
  types: ["Creature", "Human", "Survivor"],
  power: 2,
  toughness: 2,
  triggered_abilities: [(
