// Oracle and ruling checked 2026-08-24. A committed first spell cast before this enters
// still counts; the ability reduces exactly the controller's second spell of the turn.
(
  id: "highspire_bell-ringer",
  name: "Highspire Bell-Ringer",
  mana_cost: "{2}{U}",
  types: ["Creature", "Djinn", "Monk"],
  power: 1,
  toughness: 4,
  keywords: [Flying],
  static_abilities: [SpellGenericReduction(
    casters: Controller,
    amount: 1,
    condition: Some(SpellsCastThisTurn(
      players: Controller,
      min: Some(1),
      max: Some(1),
    )),
  )],
)
