// Oracle/rulings verified 2026-08-28. Sacrificing a token is a cost, tapping the source is an effect.
(
  id: "prosperity_tycoon",
  name: "Prosperity Tycoon",
  face_id: "prosperity_tycoon",
  mana_cost: "{3}{W}",
  types: ["Creature", "Human", "Noble"],
  power: 4,
  toughness: 2,
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([1]),
    trigger: WhenSelfEntersBattlefield,
    effect: [CreateTokens(token: "mercenary_r_1_1", count: 1)],
  )],
  activated_abilities: [(
    ability_id: "activated_01",
    presentation: Fallback,
    costs: [Mana("{2}"), SacrificePermanent(filter: (kind: AnyPermanent, controller: You, token: Some(true)))],
    effect: [GrantKeywords(subject: Source, keywords: [Indestructible]), Tap(subject: Source)],
  )],
)
