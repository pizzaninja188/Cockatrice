// Oracle and rulings checked 2026-08-26. The entry trigger offers a real untargeted tap payment;
// if it cannot or will not be paid, sacrificing the source is a semantic sacrifice, not destroy.
(
  id: "command_bridge",
  name: "Command Bridge",
  face_id: "command_bridge",
  mana_cost: "",
  types: ["Land"],
  activated_abilities: [(
    ability_id: "activated_01",
    presentation: OracleLines([3]),
    costs: [Tap],
    effect: [ProduceMana(options: [(w: 1), (u: 1), (b: 1), (r: 1), (g: 1)])],
  )],
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([2]),
    trigger: WhenSelfEntersBattlefield,
    effect: [ChooseResolutionBranch(
      branches: [
        (
          branch_id: "tap_an_untapped_permanent_you_control", presentation: Fallback,
          cost: TapPermanents(
            count: 1,
            filter: (kind: AnyPermanent, controller: You),
            exclude_source: false,
          ),
          effects: [],
        ),
        (
          branch_id: "sacrifice_command_bridge", presentation: Fallback,
          cost: None,
          effects: [Sacrifice(subject: Source)],
        ),
      ],
    )],
  )],
  static_abilities: [(ability_id: "static_01", presentation: Fallback, definition: EntersTapped(affected: Self_))],
)
