// Oracle and rulings checked 2026-08-26. The entry trigger offers an untargeted tap payment;
// otherwise it attempts to sacrifice this exact source under CR 701.21a's control requirement.
(
  id: "command_bridge",
  name: "Command Bridge",
  face_id: "command_bridge",
  mana_cost: "",
  types: ["Land"],
  activated_abilities: [(
    ability_id: "activated_01",
    presentation: OracleLines([3]),
    costs: [Tap],
    effect: [ProduceMana(options: [(w: 1), (u: 1), (b: 1), (r: 1), (g: 1)])],
  )],
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([2]),
    trigger: WhenSelfEntersBattlefield,
    program: Some((body: (steps: [
      (id: "choose_tap", kind: Choose(
        choice: "tap_permanent", chooser: Controller, optional: true,
        branches: [(
          branch_id: "tap_an_untapped_permanent_you_control", presentation: Fallback,
          cost: TapPermanents(
            count: 1,
            filter: (kind: AnyPermanent, controller: You),
          ),
          body: (),
        )],
        otherwise: (steps: [
          (id: "sacrifice_source",
            kind: Perform(Sacrifice(subject: Source))),
        ]),
      )),
    ]))),
  )],
  static_abilities: [(ability_id: "static_01", presentation: OracleLines([1]), definition: EntersTapped(affected: Self_))],
)
