// Oracle and WotC rulings checked 2026-10-06. Crew uses the existing aggregate tap payment;
// attacking copies only the target token's copiable values.
(
  id: "esikas_chariot",
  name: "Esika's Chariot",
  face_id: "esikas_chariot",
  mana_cost: "{3}{G}",
  supertypes: ["Legendary"],
  types: ["Artifact", "Vehicle"],
  power: 4,
  toughness: 4,
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: OracleLines([1]),
      trigger: WhenSelfEntersBattlefield,
      effect: [CreateTokens(
        token: "cat_g_2_2",
        count: 2,
        who: Controller,
        tapped: false,
        sacrifice_timing: None,
      )],
    ),
    (
      ability_id: "triggered_02",
      presentation: OracleLines([2]),
      trigger: WheneverSelfAttacks(minimum_other_attackers: 0),
      effect: [CreateTokenCopies(
        count: 1,
        source: Chosen((kind: AnyPermanent, controller: You, token: Some(true))),
      )],
      targeting: Some((groups: [(
        min: 1,
        max: 1,
        prompt: "Choose a token you control",
        effect_indices: [0],
      )])),
    ),
  ],
  activated_abilities: [(
    ability_id: "activated_01",
    presentation: OracleLines([3]),
    costs: [TapPermanents(
      constraint: AggregateMinimum(minimum: 4, contribution: CurrentPower),
      filter: (kind: Creature, controller: You),
      exclude_source: true,
    )],
    effect: [AddTypes(subject: Source, addition: (card_types: [Creature]))],
  )],
)
