// Oracle and rulings checked 2026-10-10 against the pinned Scryfall snapshot and WotC CLB release notes.
// CR 400.7, 603.5, 607.2a, and 702.122a govern source-incarnation links, triggers, and Crew.
(
  id: "nautiloid_ship",
  name: "Nautiloid Ship",
  face_id: "nautiloid_ship",
  mana_cost: "{4}",
  types: ["Artifact", "Vehicle"],
  power: 5,
  toughness: 5,
  keywords: [Flying],
  triggered_abilities: [(
    ability_id: "exile_target_graveyard",
    presentation: OracleLines([2]),
    trigger: WhenSelfEntersBattlefield,
    targeting: Some((groups: [(
      min: 1,
      max: 1,
      prompt: "Choose target player",
      effect_indices: [0],
      player: Some(AnyPlayer),
    )])),
    effect: [ExileGraveyards(
      players: TargetedPlayer(group_index: 0, kind: AnyPlayer),
      linked_exile_id: Some("exiled_cards"),
    )],
  ), (
    ability_id: "return_linked_creature",
    presentation: OracleLines([3]),
    trigger: WheneverSelfDealsCombatDamageToPlayer,
    effect: [ChooseLinkedExiledCard(
      producer_ability_id: "exile_target_graveyard",
      linked_exile_id: "exiled_cards",
      filter: (card_type: Some(Creature)),
      destination: ControllerBattlefield,
      optional: true,
    )],
  )],
  activated_abilities: [(
    ability_id: "crew",
    presentation: OracleLines([4]),
    source_zone: Battlefield,
    costs: [TapPermanents(
      constraint: AggregateMinimum(minimum: 3, contribution: CurrentPower),
      filter: (kind: Creature, controller: You),
      exclude_source: true,
    )],
    effect: [AddTypes(
      subject: Source,
      addition: (card_types: [Creature], creature_types: [], land_types: []),
    )],
  )],
)
