// Oracle and CR 101.4/701.9 checked 2026-08-24. This is untargeted and affects every opponent.
(
  id: "burglar_rat",
  name: "Burglar Rat",
  mana_cost: "{1}{B}",
  types: ["Creature", "Rat"],
  power: 1,
  toughness: 1,
  triggered_abilities: [(
    trigger: WhenSelfEntersBattlefield,
    effect: [Discard(who: EachOpponent, count: 1)],
    text: "When this creature enters, each opponent discards a card.",
  )],
)
