// Oracle and ruling checked 2026-08-27. CR 106.6; 116.2b/m; 701.40b; 709.5e.
// The same restricted blue mana pays enchantment spells, Room unlocks, and face-up costs.
(
  id: "creeping_peeper",
  name: "Creeping Peeper",
  face_id: "creeping_peeper",
  mana_cost: "{1}{U}",
  types: ["Creature", "Eye"],
  power: 2,
  toughness: 1,
  activated_abilities: [(
    ability_id: "activated_01",
    presentation: OracleLines([1]),
    costs: [Tap],
    effect: [ProduceMana(
      options: [(u: 1)],
      restriction: Some((
        restriction_id: "restriction_01",
        presentation: OracleLines([1]),
        cast_spell: [(card_type: Some(Enchantment))],
        special_actions: [UnlockRoomDoor, TurnFaceUp],
      )),
    )],
  )],
)
