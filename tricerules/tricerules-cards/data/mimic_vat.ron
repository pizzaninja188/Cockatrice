// Oracle/rulings checked 2026-10-10 against the pinned Scryfall snapshot and WotC LCI Release Notes.
// CR 111.12, 118.12, 400.7e, 603.5-603.7, 607.2a, and 707.2 govern the imprint and token copy.
// CR 800.4f governs a departed controller's unpaid optional imprint cost.
(
  id: "mimic_vat",
  name: "Mimic Vat",
  face_id: "mimic_vat",
  mana_cost: "{3}",
  types: ["Artifact"],
  triggered_abilities: [(
    ability_id: "imprint",
    presentation: OracleLines([1]),
    trigger: WheneverCreatureDies(
      filter: (permanent_type: Some(Creature), token: Some(false)),
    ),
    program: Some((body: (steps: [
      (id: "choose_imprint", kind: Choose(
        choice: "imprint_creature",
        chooser: Controller,
        optional: true,
        branches: [(
          branch_id: "imprint",
          presentation: OracleLines([1]),
          cost: None,
          requirement: EffectsApplicable,
          body: (steps: [
            (id: "exile_event", bind: ["imprint_receipt"],
              kind: Perform(Exile(
                subject: TriggerObject,
                linked_exile_id: Some("imprinted_card"),
              ))),
            (id: "return_previous", input: Some("imprint_receipt"),
              kind: Perform(ReturnOtherLinkedExiledCards(
                producer_ability_id: "imprint",
                linked_exile_id: "imprinted_card",
              )))
          ]),
        )],
        otherwise: (),
      )),
    ]))),
  )],
  activated_abilities: [(
    ability_id: "create_copy",
    presentation: OracleLines([2]),
    costs: [Mana("{3}"), Tap],
    effect: [],
    program: Some((body: (steps: [
      (id: "copy_entry", bind: ["copies"], kind: Perform(
        CreateTokenCopies(
          count: 1,
          source: LinkedExile(
            producer_ability_id: "imprint",
            linked_exile_id: "imprinted_card",
          ),
        ),
      )),
      (id: "grant_haste", input: Some("copies"), kind: Perform(
        ApplyPermanentModifier(
          subject: PreviousEffectObjects,
          modifier: GrantKeywords([Haste]),
          duration: Indefinite,
        ),
      )),
      (id: "schedule_exile", input: Some("copies"), kind: Perform(
        CreateDelayedTrigger(
          subject: Some(PreviousEffectObjects),
          ability: (
            ability_id: "exile_copy",
            presentation: OracleLines([2]),
            trigger: AtBeginningOfNextEndStep,
            effect: [ExileObservedObjects],
          ),
        ),
      )),
    ]))),
  )],
)
