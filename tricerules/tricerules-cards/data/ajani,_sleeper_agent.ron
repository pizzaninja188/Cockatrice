(
    id: "ajani,_sleeper_agent", name: "Ajani, Sleeper Agent", face_id: "ajani_sleeper_agent",
    mana_cost: "{1}{G}{G/W/P}{W}", supertypes: ["Legendary"], types: ["Planeswalker", "Ajani"], loyalty: 4,
    static_abilities: [(
        ability_id: "static_01", presentation: OracleLines([1]), definition: Compleated,
    )],
    activated_abilities: [(
        ability_id: "activated_01", presentation: OracleLines([2]), costs: [Loyalty(1)],
        effect: [RevealTopCardToHandIfMatches(
            filter: (any_of: Some([(card_type: Some(Creature)), (card_type: Some(Planeswalker))])),
            unmatched: MayPutBottom,
        )],
    ), (
        ability_id: "activated_02", presentation: OracleLines([3]), costs: [Loyalty(-3)],
        effect: [
            DistributeCounters(counter: PlusOnePlusOne, count: 3, subject: Chosen((kind: Creature))),
            GrantKeywords(subject: Chosen((kind: Creature)), keywords: [Vigilance]),
        ],
        targeting: Some((groups: [(
            min: 0, max: 3, effect_indices: [0, 1],
        )])),
    ), (
        ability_id: "activated_03", presentation: OracleLines([4]), costs: [Loyalty(-6)],
        effect: [CreateTriggeredEmblem(
