  name: "Shocking Grasp",
  face_id: "shocking_grasp",
  mana_cost: "{1}{U}",
  types: ["Instant"],
  spell_effect: [
    PumpTarget(power: -2, toughness: 0),
    Draw(count: 1),
  ],
  targeting: Some((groups: [(min: 1, max: 1, effect_indices: [0])])),
