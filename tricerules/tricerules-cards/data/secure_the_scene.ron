(
  id: "secure_the_scene",
  name: "Secure the Scene",
  face_id: "secure_the_scene",
  mana_cost: "{4}{W}",
  types: ["Sorcery"],
  spell_effect: [
    Exile(subject: Chosen((kind: AnyPermanent, excluded_permanent_types: [Land]))),
    CreateTokens(token: "soldier_w_1_1", count: 1, who: ControllerOfTargetGroup(group_index: 0)),
  ],
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target nonland permanent",
    effect_indices: [0],
  )])),
)
