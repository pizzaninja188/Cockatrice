(
  id: "ray_of_distortion",
  name: "Ray of Distortion",
  face_id: "ray_of_distortion",
  mana_cost: "{3}{W}",
  flashback_cost: Some("{4}{W}{W}"),
  types: ["Instant"],
  spell_effect: [Destroy(subject: Chosen((
    any_of: Some([
      (kind: AnyPermanent, permanent_types: [Artifact]),
      (kind: AnyPermanent, permanent_types: [Enchantment]),
    ]),
  )))],
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target artifact or enchantment",
    effect_indices: [0],
  )])),
