// CR 113.6g (an ability that says a spell can't be countered functions on the stack), 701.6
// (counter) and 702.16a-b (protection from blue). The pinned 2004-10-04 rulings confirm a
// counterspell still resolves and its other effects happen, and only countering is ignored.
// Copy of Surrak, Elusive Hunter's uncounterable static plus White Knight's color protection.
(
  id: "scragnoth",
  name: "Scragnoth",
  face_id: "scragnoth",
  mana_cost: "{4}{G}",
  types: ["Creature", "Beast"],
  power: 3,
  toughness: 4,
  protections: [Color(Blue)],
  static_abilities: [
    (
      ability_id: "static_01",
      presentation: OracleLines([1]),
      definition: SpellCannotBeCountered,
    ),
  ],
)
