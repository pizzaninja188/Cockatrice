// Oracle and rulings checked against the exact BFZ Scryfall record on 2026-09-28.
// CR 702.114 and 613.1e govern Devoid; CR 503.1 the upkeep trigger; CR 701.23 the subtype search.
(
  id: "from_beyond",
  name: "From Beyond",
  face_id: "from_beyond",
  mana_cost: "{3}{G}",
  types: ["Enchantment"],
  characteristic_defining_abilities: [(
    ability_id: "devoid",
    presentation: OracleLines([1]),
    definition: Devoid,
  )],
  triggered_abilities: [(
    ability_id: "upkeep_spawn",
    presentation: OracleLines([2]),
    trigger: AtBeginningOfUpkeep(player: Controller),
    effect: [CreateTokens(token: "eldrazi_scion_c_1_1", count: 1)],
  )],
  activated_abilities: [(
    ability_id: "search_eldrazi",
    presentation: OracleLines([3]),
    source_zone: Battlefield,
    costs: [Mana("{1}{G}"), SacrificeSelf],
    effect: [SearchLibrary(
      filter: Some((required_subtypes: ["Eldrazi"])),
      destination: Hand,
      shuffle: true,
      reveal: true,
    )],
  )],
)
