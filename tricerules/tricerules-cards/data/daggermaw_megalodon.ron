(
  id: "daggermaw_megalodon",
  name: "Daggermaw Megalodon",
  mana_cost: "{4}{U}{U}",
  types: ["Creature", "Shark"],
  power: 5,
  toughness: 7,
  keywords: [Vigilance],
  activated_abilities: [(
    source_zone: Hand,
    costs: [Mana("{2}"), DiscardSelf],
    effect: [SearchLibrary(
      filter: Some((subtype: Some("Island"))),
      destination: Hand,
      shuffle: true,
      reveal: true,
    )],
    text: "Islandcycling {2} ({2}, Discard this card: Search your library for an Island card, reveal it, put it into your hand, then shuffle.)",
  )],
)
