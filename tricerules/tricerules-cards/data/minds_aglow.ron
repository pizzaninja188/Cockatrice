// Oracle and ruling verified 2026-10-07. CR 117.1d, 608.2g, 121.2c, 800.4f:
// sequential optional mana contributions determine the exact mandatory EachPlayer draw count.
// Source: https://scryfall.com/card/c16/93/minds-aglow
(
  id: "minds_aglow",
  name: "Minds Aglow",
  face_id: "minds_aglow",
  mana_cost: "{U}",
  types: ["Sorcery"],
  spell_effect: [],
  spell_program: Some((body: (steps: [
    (id: "collect_contributions", bind: ["total_mana_paid"], input: None,
      kind: Perform(JoinForces)),
    (id: "draw_for_total_mana_paid", bind: [], input: Some("total_mana_paid"),
      kind: Perform(Draw(who: EachPlayer, count: Count(ProgramInputCount)))),
  ], yields: []), target_bindings: [])),
)
