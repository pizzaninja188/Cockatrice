// target plus Vapor Snag's controller-of-target life loss.
(
  id: "spreading_rot",
  name: "Spreading Rot",
  face_id: "spreading_rot",
  mana_cost: "{4}{B}",
  types: ["Sorcery"],
  spell_effect: [
    Destroy(subject: Chosen((kind: AnyPermanent, permanent_types: [Land]))),
    LoseLife(amount: Fixed(2), who: ControllerOfTargetGroup(group_index: 0)),
