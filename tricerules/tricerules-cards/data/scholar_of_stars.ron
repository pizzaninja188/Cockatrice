// Oracle and rulings checked 2026-08-11. CR 603.4 checks the artifact condition both when this
// ability would trigger and when it resolves; the qualifying artifact may differ between checks.
(
  id: "scholar_of_stars",
  name: "Scholar of Stars",
  face_id: "scholar_of_stars",
  mana_cost: "{3}{U}",
  types: ["Creature", "Human", "Artificer"],
  power: 3,
  toughness: 2,
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: OracleLines([1]),
      trigger: WhenSelfEntersBattlefield,
      effect: [Draw(count: 1)],
      intervening_if: Some(GameCondition(BattlefieldAggregate(
        filter: (controllers: Controller, card_type: Some(Artifact)),
        aggregate: Count,
        min: Some(1),
      ))),
    ),
  ],
)
