// Oracle 981298e6-ddee-49c0-9377-f47f019b4138 and rulings checked 2026-10-20 against the pinned Scryfall snapshot and official card gallery.
// CR 400.7, 603.2c, 603.5, 607.2a, 608.2d, 608.2m, and 800.4a govern this discard trigger,
// its linked-card choice, and source-owner departure during a begun multiplayer resolution.
(
  id: "currency_converter",
  name: "Currency Converter",
  face_id: "currency_converter",
  mana_cost: "{1}",
  types: ["Artifact"],
  triggered_abilities: [(
    ability_id: "discard_to_exile",
    presentation: OracleLines([1]),
    trigger: WheneverPlayerDiscardsCard(),
    program: Some((body: (steps: [
      (id: "choose_to_exile", kind: Choose(
        choice: "may_exile_discarded_card",
        chooser: Controller,
        optional: true,
        branches: [(
          branch_id: "exile_discarded_card",
          presentation: OracleLines([1]),
          cost: None,
          requirement: EffectsApplicable,
          body: (steps: [
            (id: "exile_discarded_card",
              kind: Perform(Exile(
                subject: TriggerObject,
                linked_exile_id: Some("exiled_cards"),
              ))),
          ]),
        )],
        otherwise: (),
      )),
    ]))),
  )],
  activated_abilities: [(
    ability_id: "draw_then_discard",
    presentation: OracleLines([2]),
    costs: [Mana("{2}"), Tap],
    effect: [],
    program: Some((body: (steps: [
      (id: "draw_one", kind: Perform(Draw( count: 1))),
      (id: "discard_one", kind: Perform(Discard( quantity: Exact(1)))),
    ]))),
  ), (
    ability_id: "return_linked_card",
    presentation: OracleLines([3]),
    costs: [Tap],
    effect: [],
    program: Some((body: (steps: [
      (id: "choose_linked_card", bind: ["chosen"],
        kind: Perform(ChooseLinkedExiledCard(
          producer_ability_id: "discard_to_exile",
          linked_exile_id: "exiled_cards",
          filter: (any_of: Some([
            (card_type: Some(Creature)),
            (card_type: Some(Noncreature)),
          ])),
          destination: OwnerGraveyard,
        ))),
      (id: "create_treasure_for_land",
        kind: IfResult(
          condition: CardResultCount(result: "chosen", card_type: Some(Land), min: Some(1)),
          yes: (steps: [(id: "create_treasure",
            kind: Perform(CreateTokens(token: "treasure", count: 1,
              tapped: false)))]),
          no: (),
        )),
      (id: "create_rogue_for_nonland",
        kind: IfResult(
          condition: CardResultCount(result: "chosen", card_type: Some(Nonland), min: Some(1)),
          yes: (steps: [(id: "create_rogue",
            kind: Perform(CreateTokens(token: "rogue_b_2_2", count: 1,
              tapped: false)))]),
          no: (),
        )),
    ]))),
  )],
)
