// Oracle 981298e6-ddee-49c0-9377-f47f019b4138 and rulings checked 2026-10-20 against the pinned Scryfall snapshot and official card gallery.
// CR 400.7, 603.2c, 603.5, 607.2a, and 608.2d govern discard triggers and linked-card choices.
(
  id: "currency_converter",
  name: "Currency Converter",
  face_id: "currency_converter",
  mana_cost: "{1}",
  types: ["Artifact"],
  triggered_abilities: [(
    ability_id: "discard_to_exile",
    presentation: OracleLines([1]),
    trigger: WheneverPlayerDiscardsCard(player: Controller),
    effect: [ChooseResolutionBranch(
      chooser: Controller,
      optional: true,
      selection: PlayerChoice,
      branches: [(
        branch_id: "exile_discarded_card",
        presentation: OracleLines([1]),
        cost: None,
        requirement: EffectsApplicable,
        effects: [Exile(
          subject: TriggerObject,
          linked_exile_id: Some("exiled_cards"),
        )],
      )],
    )],
  )],
  activated_abilities: [(
    ability_id: "draw_then_discard",
    presentation: OracleLines([2]),
    source_zone: Battlefield,
    costs: [Mana("{2}"), Tap],
    effect: [],
    program: Some((body: (steps: [
      (id: "draw_one", kind: Perform(Draw(who: Controller, count: 1))),
      (id: "discard_one", kind: Perform(Discard(who: Controller, quantity: Exact(1)))),
    ], yields: []), target_bindings: [])),
  ), (
    ability_id: "return_linked_card",
    presentation: OracleLines([3]),
    source_zone: Battlefield,
    costs: [Tap],
    effect: [],
    program: Some((body: (steps: [
      (id: "choose_linked_card", bind: ["chosen"], input: None,
        kind: Perform(ChooseLinkedExiledCard(
          producer_ability_id: "discard_to_exile",
          linked_exile_id: "exiled_cards",
          filter: (any_of: Some([
            (card_type: Some(Creature)),
            (card_type: Some(Noncreature)),
          ])),
          destination: OwnerGraveyard,
          optional: false,
        ))),
      (id: "create_treasure_for_land", bind: [], input: None,
        kind: IfResult(
          condition: CardResultCount(result: "chosen", card_type: Some(Land), min: Some(1), max: None),
          yes: (steps: [(id: "create_treasure", bind: [], input: None,
            kind: Perform(CreateTokens(token: "treasure", count: 1, who: Controller,
              tapped: false, sacrifice_timing: None)))], yields: []),
          no: (steps: [], yields: []),
        )),
      (id: "create_rogue_for_nonland", bind: [], input: None,
        kind: IfResult(
          condition: CardResultCount(result: "chosen", card_type: Some(Nonland), min: Some(1), max: None),
          yes: (steps: [(id: "create_rogue", bind: [], input: None,
            kind: Perform(CreateTokens(token: "rogue_b_2_2", count: 1, who: Controller,
              tapped: false, sacrifice_timing: None)))], yields: []),
          no: (steps: [], yields: []),
        )),
    ], yields: []), target_bindings: [])),
  )],
)
