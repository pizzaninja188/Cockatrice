(
  id: "sunderflock", name: "Sunderflock", face_id: "sunderflock",
  mana_cost: "{7}{U}{U}", types: ["Creature", "Elemental"],
  power: 5, toughness: 5, keywords: [Flying],
  cost_modifiers: [GenericReduction(amount: Count(BattlefieldMaximum(
