  mana_cost: "{2}{U}",
  types: ["Instant"],
  spell_effect: [
    PumpTarget(power: -3, toughness: 0),
    Draw(count: 1),
  ],
  targeting: Some((groups: [(min: 1, max: 1, effect_indices: [0])])),
