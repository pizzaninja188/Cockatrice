// legal but indestructible target still scries 2.
(
  id: "rubble_reading",
  name: "Rubble Reading",
  face_id: "rubble_reading",
  mana_cost: "{3}{R}",
  types: ["Sorcery"],
  spell_effect: [
    Destroy(subject: Chosen((kind: AnyPermanent, permanent_types: [Land]))),
    Scry(count: 2),
  ],
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target land",
    effect_indices: [0],
  )])),
)
