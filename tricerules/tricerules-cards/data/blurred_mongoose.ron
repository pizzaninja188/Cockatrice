// CR 113.6g (an ability that says a spell can't be countered functions on the stack), 701.6
// (counter), 702.18a (shroud) and 115.1 (a counterspell can still target it). The pinned
// 2004-10-04 rulings confirm a counterspell resolves but does not counter it, and shroud only
// applies on the battlefield. Copy of Surrak, Elusive Hunter's uncounterable static plus the
// Shroud keyword.
(
  id: "blurred_mongoose",
  name: "Blurred Mongoose",
  face_id: "blurred_mongoose",
  mana_cost: "{1}{G}",
  types: ["Creature", "Mongoose"],
  power: 2,
  toughness: 1,
  keywords: [Shroud],
  static_abilities: [
    (
      ability_id: "static_01",
      presentation: OracleLines([1]),
      definition: SpellCannotBeCountered,
    ),
  ],
)
