(
  id: "griffin_protector",
  name: "Griffin Protector",
  mana_cost: "{3}{W}",
  types: ["Creature", "Griffin"],
  power: 2,
  toughness: 3,
  keywords: [Flying],
  triggered_abilities: [
    (
      trigger: WheneverPermanentEntersBattlefield(
        controller: Controller,
        permanent_type: Some(Creature),
        exclude_self: true,
      ),
      effect: [PumpTarget(power: 1, toughness: 1, subject: Source)],
      text: "Whenever another creature you control enters, this creature gets +1/+1 until end of turn.",
    ),
  ],
)
