// Core Set 2021. Shares the reusable end-step event and counted turn-history condition with
// Sabertooth Mauler; the condition is checked both when the ability triggers and on resolution.
(
  id: "twinblade_assassins",
  name: "Twinblade Assassins",
  face_id: "twinblade_assassins",
  mana_cost: "{3}{B}{G}",
  types: ["Creature", "Elf", "Assassin"],
  power: 5,
  toughness: 4,
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: OracleLines([1]),
      trigger: AtBeginningOfEndStep(player: Controller),
      intervening_if: Some(CreatureDeathsThisTurn(min: Some(1), max: None)),
      effect: [Draw(count: 1)],
    ),
  ],
)
