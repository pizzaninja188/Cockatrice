// Oracle and rulings checked against Scryfall on 2026-08-26. A Land Treefolk matches both
// branches of the public union but contributes only one permanent.
(
  id: "tend_the_sprigs",
  name: "Tend the Sprigs",
  face_id: "tend_the_sprigs",
  mana_cost: "{2}{G}",
  types: ["Sorcery"],
  spell_program: Some((
    body: (steps: [
      (id: "search_basic_land",
        kind: Perform(SearchLibrary(
          filter: Some((card_type: Some(BasicLand))),
          zones: Fixed([Library]),
          destination: Battlefield(tapped: true),
          selection_bounds: Some((min: 0, max: 1)),
        ))),
      (id: "seven_land_or_treefolk",
        kind: If(
          condition: BattlefieldAggregate(
            filter: (
              controllers: Controller,
              any_of: Some([
                (controllers: Controller, card_type: Some(Land)),
                (controllers: Controller, required_subtypes: ["Treefolk"]),
              ]),
            ),
            aggregate: Count,
            min: Some(7),
          ),
          yes: (steps: [
            (id: "create_treefolk",
              kind: Perform(CreateTokens(
                token: "treefolk_g_3_4_reach",
                count: 1,
              ))),
          ]),
          no: (),
        )),
    ]),
  )),
)
