// Kami of the Crescent Moon — the same draw-step trigger as Howling Mine with no
// intervening-"if" clause, and on a creature whose controller is often not the drawing player.
(
    id: "kami_of_the_crescent_moon",
    name: "Kami of the Crescent Moon",
    face_id: "kami_of_the_crescent_moon",
    mana_cost: "{U}{U}",
    supertypes: ["Legendary"],
    types: ["Creature", "Spirit"],
    power: 1,
    toughness: 3,
    triggered_abilities: [
        (
            ability_id: "triggered_01",
            presentation: OracleLines([1]),
            trigger: AtBeginningOfDrawStep(player: AnyPlayer),
            effect: [Draw(who: AffectedPlayer, count: 1)],
        ),
    ],
)
