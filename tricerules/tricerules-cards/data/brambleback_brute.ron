(
  id: "brambleback_brute",
  name: "Brambleback Brute",
  face_id: "brambleback_brute",
  mana_cost: "{2}{R}",
  types: ["Creature", "Giant", "Warrior"],
  power: 4,
  toughness: 5,
  static_abilities: [(ability_id: "static_01", presentation: Fallback, definition: EntersWithCounters(counter: MinusOneMinusOne, amount: 2))],
  activated_abilities: [(
    ability_id: "activated_01",
    presentation: OracleLines([2]),
    costs: [Mana("{1}{R}"), RemoveCounters(counter: None, count: 1)],
    effect: [ApplyCombatRestriction(scope: Chosen((kind: Creature)), restriction: (cant_block: true))],
    timing: SorcerySpeed,
  )],
