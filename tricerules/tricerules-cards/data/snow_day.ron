// CR 115.1a/115.3 (up to two targets), 701.26 (tap), 502.3/611.2a (skip the next untap step),
// 121 (draw), 701.9 (discard) and 608.2c (printed order). The pinned 2021-04-16 rulings confirm
// tapped creatures remain legal targets, and that all targets becoming illegal removes the spell
// from the stack so it neither draws nor discards.
(
  id: "snow_day",
  name: "Snow Day",
  face_id: "snow_day",
  mana_cost: "{4}{U}{U}",
  types: ["Instant"],
  spell_effect: [
    Tap(subject: Chosen((kind: Creature))),
    SkipNextUntap(target: (kind: Creature)),
    Draw(count: 2),
    Discard(quantity: Exact(1)),
  ],
  targeting: Some((groups: [(min: 0, max: 2, effect_indices: [0, 1])])),
)
