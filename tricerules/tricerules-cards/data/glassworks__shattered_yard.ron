(
  id: "glassworks_shattered_yard",
  name: "Glassworks // Shattered Yard",
  layout: Room,
  faces: [
    (
      name: "Glassworks",
      mana_cost: "{2}{R}",
      types: ["Enchantment", "Room"],
      triggered_abilities: [(
        trigger: WhenThisDoorUnlocked,
        effect: [DamageTarget(
          amount: 4,
          target: (kind: Creature, controller: Opponent),
        )],
        text: "When you unlock this door, this Room deals 4 damage to target creature an opponent controls.",
      )],
    ),
    (
      name: "Shattered Yard",
      mana_cost: "{4}{R}",
      types: ["Enchantment", "Room"],
      triggered_abilities: [(
        trigger: AtBeginningOfEndStep(player: Controller),
        effect: [DamagePlayer(amount: 1, who: EachOpponent)],
        text: "At the beginning of your end step, this Room deals 1 damage to each opponent.",
      )],
    ),
  ],
)
