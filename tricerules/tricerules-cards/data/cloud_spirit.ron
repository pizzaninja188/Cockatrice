  name: "Cloud Spirit",
  face_id: "cloud_spirit",
  mana_cost: "{2}{U}",
  types: ["Creature", "Spirit"],
  power: 3,
  toughness: 1,
  keywords: [Flying],
  static_abilities: [
    (
      ability_id: "static_01",
      presentation: OracleLines([2]),
      definition: SelfCombatRestriction(restriction: (
