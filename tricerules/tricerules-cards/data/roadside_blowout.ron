// Oracle and ruling checked 2026-09-22 against pinned Scryfall oracle 03008c7d-c738-473d-a968-1922b2899d1a.
// CR 601.2f: the reduction is fixed from the announced target. CR 608.2b-c: recheck the target, then resolve in order.
(
  id: "roadside_blowout",
  name: "Roadside Blowout",
  face_id: "roadside_blowout",
  mana_cost: "{2}{U}",
  types: ["Sorcery"],
  cost_modifiers: [TargetMatchGenericReduction(
    amount: 2,
    filter: Battlefield((kind: AnyPermanent, min_mana_value: Some(1), max_mana_value: Some(1))),
  )],
  spell_effect: [
    ReturnToOwnersHand(subject: Chosen((any_of: Some([
      (kind: Creature, controller: Opponent),
      (kind: AnyPermanent, controller: Opponent, required_subtypes: ["Vehicle"]),
    ])))),
    Draw(count: 1),
  ],
  targeting: Some((groups: [(
    min: 1,
    max: 1,
    prompt: "Choose target creature or Vehicle an opponent controls",
    effect_indices: [0],
  )])),
)
