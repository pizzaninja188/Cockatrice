// Exact Oracle 95d51048-be32-4c5f-8b75-fca3a891c9d6; source/rulings checked 2026-10-18 (none).
// Reasoned CR application, not a card-specific ruling: 101.2, 101.3, 118.3, and 614.17b make
// a Narset-prohibited mandatory single draw unavailable, so the Otherwise counter branch resolves.
(
  id: "trade_route_envoy",
  name: "Trade Route Envoy",
  face_id: "trade_route_envoy",
  mana_cost: "{3}{G}",
  types: ["Creature", "Dog", "Soldier"],
  power: 4,
  toughness: 3,
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([1]),
    trigger: WhenSelfEntersBattlefield,
    program: Some((body: (steps: [
      (id: "draw_or_counter", kind: Choose(
        choice: "draw_if_countered",
        chooser: Controller,
        optional: false,
        branches: [(
          branch_id: "draw_a_card",
          presentation: OracleLines([1]),
          cost: None,
          requirement: GameCondition(BattlefieldCreatureCount(
            filter: (
              controllers: Controller,
              requires_any_counter: true,
            ),
            min: Some(1),
          )),
          body: (steps: [
            (id: "draw", kind: Perform(Draw( count: 1))),
          ]),
        )],
        otherwise: (steps: [
          (id: "put_counter", kind: Perform(PutCounters(
            counter: PlusOnePlusOne,
            count: 1,
            subject: Source,
          ))),
        ]),
      )),
    ]))),
  )],
)
