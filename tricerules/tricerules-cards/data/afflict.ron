  mana_cost: "{2}{B}",
  types: ["Instant"],
  spell_effect: [
    PumpTarget(power: -1, toughness: -1),
    Draw(count: 1),
  ],
  targeting: Some((groups: [(min: 1, max: 1, effect_indices: [0])])),
