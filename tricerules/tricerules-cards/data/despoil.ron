// and 608.2b (a stale sole target fizzles, so no life is lost). Copy of Rain of Tears' land
// target plus Vapor Snag's controller-of-target life loss.
(
  id: "despoil",
  name: "Despoil",
  face_id: "despoil",
  mana_cost: "{3}{B}",
  types: ["Sorcery"],
  spell_effect: [
    Destroy(subject: Chosen((kind: AnyPermanent, permanent_types: [Land]))),
    LoseLife(amount: Fixed(2), who: ControllerOfTargetGroup(group_index: 0)),
  ],
  targeting: Some((groups: [
    (min: 1, max: 1, prompt: "Choose target land", effect_indices: [0]),
  ])),
)
