// CR 115.1/601.2c (attacking or blocking creature target), 120.3 (damage), 701.22a-b (scry) and
// 608.2b (a stale sole target fizzles the spell, so scry does not happen). Copy of Cosmium
// Blast's combat-role damage and Unsubtle Mockery's damage-then-scry ordering.
(
  id: "piercing_light",
  name: "Piercing Light",
  face_id: "piercing_light",
  mana_cost: "{W}",
  types: ["Instant"],
  spell_effect: [
    DamageTarget(amount: 2, target: (kind: Creature, combat_role: AttackingOrBlocking)),
    Scry(count: 1),
  ],
  targeting: Some((groups: [(min: 1, max: 1, prompt: "Choose target attacking or blocking creature", effect_indices: [0])])),
)
