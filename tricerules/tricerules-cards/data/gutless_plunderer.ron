// Oracle and three card-specific rulings checked against Scryfall on 2026-08-21. The rulings
// confirm short-library handling and that raid remembers any attack during the complete turn.
(
  id: "gutless_plunderer",
  name: "Gutless Plunderer",
  face_id: "gutless_plunderer",
  mana_cost: "{2}{B}",
  types: ["Creature", "Skeleton", "Pirate"],
  power: 2,
  toughness: 2,
  keywords: [Deathtouch],
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([2]),
    trigger: WhenSelfEntersBattlefield,
    effect: [LibraryPartition(count: 3, top_min: 0, top_max: Some(1), kind: Look)],
    intervening_if: Some(AttackedThisTurn(players: Controller)),
  )],
)
