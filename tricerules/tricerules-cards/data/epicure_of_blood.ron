// Oracle bdb319a6-a1cd-44f5-999d-af1bb55b2fc4; source/rulings checked 2026-11-24 against the pinned Scryfall bulk
// SHA-256 a9a2fd3b550cc5cff4cec9bbc82aaf5fb8e3f781b4b95a896a0d94c15dce7853.
// CR 118.3 (a life-gain event), 603.2 (the trigger fires once per event) and 119.3
// (each opponent loses exactly 1 life). The pinned 2019-07-12 rulings confirm the ability
// triggers once per amount of life gained, including "for each" amounts, and that each opponent
// of the controller loses 1 life.
(
  id: "epicure_of_blood",
  name: "Epicure of Blood",
  face_id: "epicure_of_blood",
  mana_cost: "{4}{B}",
  types: ["Creature", "Vampire"],
  power: 4,
  toughness: 4,
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([1]),
    trigger: WheneverPlayerGainsLife(),
    effect: [LoseLife(amount: Fixed(1), who: EachOpponent)],
  )],
)
