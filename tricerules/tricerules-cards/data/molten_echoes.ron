// Oracle/rulings verified 2026-10-09. CR 205.3m, 603.6, 607, 608.2h, 707.
(
  id: "molten_echoes",
  name: "Molten Echoes",
  face_id: "molten_echoes",
  mana_cost: "{2}{R}{R}",
  types: ["Enchantment"],
  static_abilities: [(
    ability_id: "choose_type",
    presentation: OracleLines([1]),
    definition: AsEntersChooseCreatureType(link_id: "chosen_type"),
  )],
  triggered_abilities: [(
    ability_id: "copy_matching_creature",
    presentation: OracleLines([2]),
    trigger: WheneverPermanentEntersBattlefield(
      controller: Controller,
      filter: (
        permanent_type: Some(Creature),
        token: Some(false),
        source_chosen_creature_type: Some("chosen_type"),
      ),
    ),
    program: Some((body: (steps: [
      (id: "copy_entry", bind: ["copies"], kind: Perform(
        CreateTokenCopies(count: 1, source: TriggerObject),
      )),
      (id: "grant_haste", input: Some("copies"), kind: Perform(
        ApplyPermanentModifier(
          subject: PreviousEffectObjects,
          modifier: GrantKeywords([Haste]),
          duration: Indefinite,
        ),
      )),
      (id: "schedule_exile", input: Some("copies"), kind: Perform(
        CreateDelayedTrigger(
          subject: Some(PreviousEffectObjects),
          ability: (
            ability_id: "exile_copy",
            presentation: OracleLines([2]),
            trigger: AtBeginningOfNextEndStep,
            effect: [ExileObservedObjects],
          ),
        ),
      )),
    ]))),
  )],
)
