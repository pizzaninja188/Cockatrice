// Oracle 200ce414-8583-4bbd-88a6-ca30babb613d; source/rulings checked 2026-11-25 against the
// pinned Scryfall bulk SHA-256 a9a2fd3b550cc5cff4cec9bbc82aaf5fb8e3f781b4b95a896a0d94c15dce7853.
// CR 702.10 (haste), 603.6a (the entry watcher includes this creature or another Ally), 603.5
// (the controller may decline the optional ability) and 122.1 (the +1/+1 counter). Pinned ruling
// 2009-10-01: the ability triggers on this creature entering, so it enters with its unmodified
// power and toughness and receives the counter only after the trigger resolves. Copy of Raging
// Minotaur's Haste plus Hada Freeblade's Ally entry counter.
(
  id: "tuktuk_grunts",
  name: "Tuktuk Grunts",
  face_id: "tuktuk_grunts",
  mana_cost: "{4}{R}",
  types: ["Creature", "Goblin", "Warrior", "Ally"],
  power: 2,
  toughness: 2,
  keywords: [Haste],
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([2]),
    trigger: WheneverPermanentEntersBattlefield(
      controller: Controller,
      filter: (permanent_type: Some(Creature)),
      creature_filter: Some((required_subtypes: ["Ally"])),
    ),
    effect: [PutCounters(counter: PlusOnePlusOne, count: 1, subject: Source)],
    may: true,
  )],
)
