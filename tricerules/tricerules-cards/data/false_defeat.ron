// CR 601.2c (one graveyard target), 608.2b (stale target fizzles), 110.2/110.2a (owner and
// effect controller) and 110.5b (untapped entry).
(
  id: "false_defeat",
  name: "False Defeat",
  face_id: "false_defeat",
  mana_cost: "{3}{W}",
  types: ["Sorcery"],
  spell_effect: [MoveGraveyardCards(filter: ( card: Some((card_type: Some(Creature)))), destination: Battlefield(tapped: false))],
  targeting: Some((groups: [(min: 1, max: 1, prompt: "Choose target creature card in your graveyard", effect_indices: [0])])),
)
