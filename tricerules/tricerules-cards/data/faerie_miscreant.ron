// Oracle and rulings checked 2026-08-11. CR 603.4 checks for another creature with this effective
// copiable name both as the ETB trigger is created and again as it resolves.
(
  id: "faerie_miscreant",
  name: "Faerie Miscreant",
  face_id: "faerie_miscreant",
  mana_cost: "{U}",
  types: ["Creature", "Faerie", "Rogue"],
  power: 1,
  toughness: 1,
  keywords: [Flying],
  triggered_abilities: [
    (
      ability_id: "triggered_01",
      presentation: OracleLines([2]),
      trigger: WhenSelfEntersBattlefield,
      effect: [Draw(count: 1)],
      intervening_if: Some(BattlefieldAggregate(
        filter: (
          controllers: Controller,
          card_type: Some(Creature),
          name: Some("Faerie Miscreant"),
          exclude_source: true,
        ),
        aggregate: Count,
        min: Some(1),
      )),
    ),
  ],
)
