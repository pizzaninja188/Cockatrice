(
  id: "sign_in_blood",
  name: "Sign in Blood",
  face_id: "sign_in_blood",
  mana_cost: "{B}{B}",
  types: ["Sorcery"],
  spell_effect: [
    TargetPlayerDraws(count: 2, target: (kind: AnyPlayer)),
    TargetPlayerLosesLife(amount: 2, target: (kind: AnyPlayer)),
