// Oracle/rulings verified 2026-10-07. CR 603, 603.7, 608.2h, 611.2a, and 707.
(
  id: "flameshadow_conjuring",
  name: "Flameshadow Conjuring",
  face_id: "flameshadow_conjuring",
  mana_cost: "{3}{R}",
  types: ["Enchantment"],
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([1]),
    trigger: WheneverPermanentEntersBattlefield(
      controller: Controller,
      filter: (
        permanent_type: Some(Creature),
        token: Some(false),
      ),
    ),
    effect: [],
    program: Some((body: (steps: [
      (id: "choose_copy", kind: Choose(
        choice: "choose_copy",
        chooser: Controller,
        optional: true,
        branches: [(
          branch_id: "pay_to_copy",
          presentation: OracleLines([1]),
          cost: Mana("{R}"),
          requirement: Always,
          body: (steps: [
            (id: "copy_entry", bind: ["copies"], kind: Perform(
              CreateTokenCopies(count: 1, source: TriggerObject),
            )),
            (id: "grant_haste", input: Some("copies"), kind: Perform(
              ApplyPermanentModifier(
                subject: PreviousEffectObjects,
                modifier: GrantKeywords([Haste]),
                duration: Indefinite,
              ),
            )),
            (id: "schedule_exile", input: Some("copies"), kind: Perform(
              CreateDelayedTrigger(
                subject: Some(PreviousEffectObjects),
                ability: (
                  ability_id: "delayed_01",
                  presentation: OracleLines([1]),
                  trigger: AtBeginningOfNextEndStep,
                  effect: [ExileObservedObjects],
                ),
              ),
            )),
          ], yields: []),
        )],
        otherwise: (steps: [], yields: []),
      )),
    ], yields: []))),
  )],
)
