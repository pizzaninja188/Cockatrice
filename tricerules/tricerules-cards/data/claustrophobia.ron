(
  id: "claustrophobia",
  name: "Claustrophobia",
  mana_cost: "{1}{U}{U}",
  // Oracle: Enchant creature. When this Aura enters, tap enchanted creature.
  // Enchanted creature doesn't untap during its controller's untap step.
  // CR 303.4m, 502.3, 603, 611.3.
  types: ["Enchantment", "Aura"],
  spell_effect: [AuraAttach(target: (kind: Creature))],
  triggered_abilities: [
    (
      trigger: WhenSelfEntersBattlefield,
      effect: [Tap(subject: AttachedObject)],
      text: "When this Aura enters, tap enchanted creature.",
    ),
  ],
  static_abilities: [
    AttachedModifier(doesnt_untap_during_untap_step: true),
  ],
)
