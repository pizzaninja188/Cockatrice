// Oracle and rulings checked 2026-08-21. CR 601.2i and 603.2: flurry observes the controller's
// second completed cast even when the first spell was cast before this permanent entered.
(
  id: "poised_practitioner",
  name: "Poised Practitioner",
  face_id: "poised_practitioner",
  mana_cost: "{2}{W}",
  types: ["Creature", "Human", "Monk"],
  power: 2,
  toughness: 3,
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: Fallback,
    trigger: WheneverPlayerCastsSpell(caster: Controller, ordinal: Some(2)),
    effect: [
      PutCounters(counter: PlusOnePlusOne, count: 1, subject: Source),
      Scry(count: 1),
    ],
  )],
)
