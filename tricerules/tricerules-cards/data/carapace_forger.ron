(
  id: "carapace_forger",
  name: "Carapace Forger",
  face_id: "carapace_forger",
  mana_cost: "{1}{G}",
  types: ["Creature", "Elf", "Artificer"],
  power: 2,
  toughness: 2,
  static_abilities: [
    (ability_id: "metalcraft", presentation: OracleLines([1]), definition: ConditionalSelfModifier(
      condition: BattlefieldAggregate(
        filter: (controllers: Controller, matching: (kind: AnyPermanent, permanent_types: [Artifact])),
        aggregate: Count,
        min: Some(3),
