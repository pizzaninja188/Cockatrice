// 2024-11-08 rulings confirm Food is an artifact subtype and one Food cannot pay two costs. Copy
// of Sweettooth Witch's entry Food and Food-sacrifice life loss with the printed {T} and 3 life.
(
  id: "tempting_witch",
  name: "Tempting Witch",
  face_id: "tempting_witch",
  mana_cost: "{2}{B}",
  types: ["Creature", "Human", "Warlock"],
  power: 1,
  toughness: 3,
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([1]),
    trigger: WhenSelfEntersBattlefield,
    effect: [CreateTokens(token: "food", count: 1)],
