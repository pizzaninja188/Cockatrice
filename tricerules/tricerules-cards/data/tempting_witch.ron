  activated_abilities: [(
    ability_id: "activated_01",
    presentation: OracleLines([2]),
    costs: [
      Mana("{2}"),
      Tap,
      SacrificePermanent(filter: (kind: AnyPermanent, controller: You, required_subtypes: ["Food"])),
