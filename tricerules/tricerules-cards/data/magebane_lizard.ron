// Oracle/rulings: https://scryfall.com/card/otj/134/magebane-lizard (verified 2026-08-27).
// CR 601.2i, 603, 608.2h-i: count committed casts when the damage instruction resolves.
(
  id: "magebane_lizard",
  name: "Magebane Lizard",
  face_id: "magebane_lizard",
  mana_cost: "{1}{R}",
  types: ["Creature", "Lizard"],
  power: 1,
  toughness: 4,
  triggered_abilities: [(
    ability_id: "triggered_01",
    presentation: OracleLines([1]),
    trigger: WheneverPlayerCastsSpell(caster: AnyPlayer, filter: (card_type: Some(Noncreature))),
    effect: [DamagePlayer(
      amount: Count(SpellsCastThisTurn(players: AffectedPlayer, filter: (card_type: Some(Noncreature)))),
      who: AffectedPlayer,
    )],
  )],
)
