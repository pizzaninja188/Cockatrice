(
  id: "adorned_crocodile",
  name: "Adorned Crocodile",
  mana_cost: "{4}{B}",
  types: ["Creature", "Crocodile"],
  power: 5,
  toughness: 3,
  triggered_abilities: [(
    trigger: WhenSelfDies,
    effect: [CreateTokens(token: "zombie_b_2_2_druid", count: 1)],
    text: "When this creature dies, create a 2/2 black Zombie Druid creature token.",
  )],
  activated_abilities: [(
    source_zone: Graveyard,
    costs: [Mana("{B}"), ExileSelf],
    effect: [PutCounters(
      counter: PlusOnePlusOne,
      count: 1,
      subject: Chosen((kind: Creature)),
    )],
    targeting: Some((groups: [(
      min: 1,
      max: 1,
      prompt: "Choose target creature",
      effect_indices: [0],
    )])),
    timing: SorcerySpeed,
    text: "Renew {B} — {B}, Exile this card from your graveyard: Put a +1/+1 counter on target creature. Activate only as a sorcery.",
  )],
)
