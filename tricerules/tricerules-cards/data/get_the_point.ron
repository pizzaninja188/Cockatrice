// CR 701.8 (destroy), 701.22a-b (scry), 115.1/601.2c (target at cast) and 608.2b (an illegal
// sole target stops the whole spell, so no scry). Pinned 2019-01-25 ruling: a legal but
// indestructible target is not destroyed and the controller still scries. Copy of Hour of
// Defeat's destroy-then-filter shape with Guiding Bolt's scry.
(
  id: "get_the_point",
  name: "Get the Point",
  face_id: "get_the_point",
  mana_cost: "{3}{B}{R}",
  types: ["Instant"],
  spell_effect: [
    Destroy(subject: Chosen((kind: Creature))),
    Scry(count: 1),
  ],
  targeting: Some((groups: [(min: 1, max: 1, effect_indices: [0])])),
)
