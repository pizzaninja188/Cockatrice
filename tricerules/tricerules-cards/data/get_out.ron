// Oracle and rulings verified 2026-09-08; CR 110.2, 400.7, 601.2c, 608.2b.
// Ownership is independent of the permanent's current controller.
(
  id: "get_out",
  name: "Get Out",
  face_id: "get_out",
  mana_cost: "{U}{U}",
  types: ["Instant"],
  modal_spell: (
    min_modes: 1,
    max_modes: 1,
    modes: [
      (
        mode_id: "mode_01",
        presentation: OracleLines([2]),
        effects: [CounterTargetSpell(spell_filter: (any_of: Some([
          (card_type: Some(Creature)),
          (card_type: Some(Enchantment)),
        ])))],
        targeting: Some((groups: [(min: 1, max: 1, prompt: "Choose a creature or enchantment spell", effect_indices: [0])])),
      ),
      (
        mode_id: "mode_02",
        presentation: OracleLines([3]),
        effects: [ReturnToOwnersHand(subject: Chosen((kind: AnyPermanent, owner: You, permanent_types: [Creature, Enchantment])))],
        targeting: Some((groups: [(min: 1, max: 2, prompt: "Choose one or two creatures and/or enchantments you own", effect_indices: [0])])),
      ),
    ],
  ),
)
