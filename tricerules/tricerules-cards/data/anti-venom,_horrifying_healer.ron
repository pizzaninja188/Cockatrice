(
  id: "anti-venom,_horrifying_healer",
  name: "Anti-Venom, Horrifying Healer",
  face_id: "anti_venom_horrifying_healer",
  mana_cost: "{W}{W}{W}{W}{W}",
  supertypes: ["Legendary"],
  types: ["Creature", "Symbiote", "Hero"],
  power: 5,
  toughness: 5,
  static_abilities: [
    (ability_id: "static_01", presentation: Fallback, definition: PreventDamage(
      subject: Source,
