(
  id: "spellgorger_weird",
  name: "Spellgorger Weird",
  mana_cost: "{2}{R}",
  types: ["Creature", "Weird"],
  power: 2,
  toughness: 2,
  triggered_abilities: [
    (
      trigger: WheneverPlayerCastsSpell(
        caster: Controller,
        spell_type: Some(Noncreature),
