+        assert_eq!(
+            trigger.trigger,
+            TriggerCondition::WhenSelfEntersBattlefield,
+            "{id}"
+        );
+        let Some(SpellEffectKind::SearchLibrary {
+            filter: Some(filter),
+            optional,
+            reveal,
