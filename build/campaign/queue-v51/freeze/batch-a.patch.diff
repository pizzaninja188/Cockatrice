+            (None, Some((power, toughness))) => assert_eq!(
+                (e.effective_power(golem), e.effective_toughness(golem)),
+                (Some(3 + power), Some(3 + toughness)),
+                "{}",
+                case.id
+            ),
+            (None, None) => {
+                assert_eq!(
+                    (e.effective_power(golem), e.effective_toughness(golem)),
