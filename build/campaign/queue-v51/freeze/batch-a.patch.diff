+#[test]
+fn q51_token_spells_map_definitions_and_tokens() {
+    for (id, name, mana, types, token, count) in [
+        (
+            "call_of_the_conclave",
+            "Call of the Conclave",
+            "{G}{W}",
+            &["Sorcery"][..],
+            "centaur_g_3_3",
+            1,
+        ),
+        (
+            "elemental_summoning",
+            "Elemental Summoning",
+            "{3}{U/R}{U/R}",
+            &["Sorcery", "Lesson"][..],
+            "elemental_ur_4_4",
+            1,
+        ),
+        (
+            "advent_of_the_wurm",
+            "Advent of the Wurm",
+            "{1}{G}{G}{W}",
+            &["Instant"][..],
+            "wurm_g_5_5_trample",
+            1,
+        ),
+        (
+            "spore_swarm",
+            "Spore Swarm",
+            "{3}{G}",
+            &["Instant"][..],
+            "saproling_g_1_1",
+            3,
+        ),
+        (
+            "masters_call",
+            "Master's Call",
+            "{2}{W}",
+            &["Instant"][..],
+            "myr_token_c_1_1",
+            2,
+        ),
+        (
+            "servo_exhibition",
+            "Servo Exhibition",
+            "{1}{W}",
+            &["Sorcery"][..],
+            "servo_c_1_1",
+            2,
+        ),
+        (
+            "sworn_companions",
+            "Sworn Companions",
+            "{2}{W}",
+            &["Sorcery"][..],
+            "soldier_w_1_1_lifelink",
+            2,
+        ),
+        (
+            "icatian_town",
+            "Icatian Town",
+            "{5}{W}",
+            &["Sorcery"][..],
+            "citizen_w_1_1",
+            4,
+        ),
+        (
+            "knight_watch",
+            "Knight Watch",
+            "{4}{W}",
+            &["Sorcery"][..],
+            "knight_w_2_2_vigilance",
+            2,
+        ),
+        (
+            "flurry_of_horns",
+            "Flurry of Horns",
+            "{4}{R}",
+            &["Sorcery"][..],
+            "minotaur_r_2_3_haste",
+            2,
+        ),
+        (
+            "take_up_arms",
+            "Take Up Arms",
+            "{4}{W}",
+            &["Instant"][..],
+            "warrior_w_1_1",
+            3,
+        ),
+    ] {
+        identity(id, name, mana, types, None);
+        token_effect(id, token, count);
+    }
+    for (token, name, types, color, pt, keyword) in [
+        (
+            "centaur_g_3_3",
+            "Centaur",
+            &["Creature", "Centaur"][..],
+            "g",
+            (3, 3),
+            None,
+        ),
+        (
+            "elemental_ur_4_4",
+            "Elemental",
+            &["Creature", "Elemental"][..],
+            "ur",
+            (4, 4),
+            None,
+        ),
+        (
+            "wurm_g_5_5_trample",
+            "Wurm",
+            &["Creature", "Wurm"][..],
+            "g",
+            (5, 5),
+            Some(Keyword::Trample),
+        ),
+        (
+            "servo_c_1_1",
+            "Servo",
+            &["Artifact", "Creature", "Servo"][..],
+            "",
+            (1, 1),
+            None,
+        ),
+        (
+            "soldier_w_1_1_lifelink",
+            "Soldier",
+            &["Creature", "Soldier"][..],
+            "w",
+            (1, 1),
+            Some(Keyword::Lifelink),
+        ),
+        (
+            "citizen_w_1_1",
+            "Citizen",
+            &["Creature", "Citizen"][..],
+            "w",
+            (1, 1),
+            None,
+        ),
+        (
+            "minotaur_r_2_3_haste",
+            "Minotaur",
+            &["Creature", "Minotaur"][..],
+            "r",
+            (2, 3),
+            Some(Keyword::Haste),
+        ),
+        (
+            "warrior_w_1_1",
+            "Warrior",
+            &["Creature", "Warrior"][..],
+            "w",
+            (1, 1),
+            None,
+        ),
+        (
+            "golem_c_3_3",
+            "Golem",
+            &["Artifact", "Creature", "Phyrexian", "Golem"][..],
+            "",
+            (3, 3),
+            None,
+        ),
+    ] {
+        let token_def = definition(token);
+        assert!(
+            registry::global().is_token(token),
+            "{token} is a token template"
+        );
+        let f = token_def.primary_face();
+        assert_eq!(f.name, name, "{token} name");
+        assert_eq!(
+            f.types.iter().map(String::as_str).collect::<Vec<_>>(),
+            types,
+            "{token} types"
+        );
+        let mut letters = f
+            .colors()
+            .iter()
+            .map(|color| match format!("{color:?}").as_str() {
+                "White" => 'w',
+                "Blue" => 'u',
+                "Black" => 'b',
+                "Red" => 'r',
+                "Green" => 'g',
+                _ => '?',
+            })
+            .collect::<Vec<_>>();
+        letters.sort_by_key(|letter| "wubrg".find(*letter).unwrap_or(5));
+        assert_eq!(
+            letters.into_iter().collect::<String>(),
+            color,
+            "{token} color"
+        );
+        assert_eq!(
+            (f.power, f.toughness),
+            (Some(pt.0), Some(pt.1)),
+            "{token} body"
+        );
+        assert_eq!(
+            f.keywords,
+            keyword.into_iter().collect::<Vec<_>>(),
+            "{token} keywords"
+        );
+    }
+}
