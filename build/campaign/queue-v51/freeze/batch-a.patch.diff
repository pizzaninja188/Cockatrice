+    "// 701.20a/701.23e (reveal), 701.24b (shuffle then put the found card on top) and\n"
+    "// 608.2 (resolution). No pinned ruling changes the printed behavior."
+)
+
+for card_id, oid, name, mana, body, subtypes, extra in [
