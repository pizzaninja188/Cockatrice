+
+struct DiscardCase {
+    id: &'static str,
+    mana: ManaGift,
+    body: (u32, u32),
+}
+
+fn discard_cases() -> [DiscardCase; 3] {
+    [
+        DiscardCase {
+            id: "miasmic_mummy",
+            mana: ManaGift {
+                b: 1,
+                c: 1,
+                ..Default::default()
+            },
+            body: (2, 2),
+        },
+        DiscardCase {
+            id: "sibsig_icebreakers",
+            mana: ManaGift {
+                b: 1,
+                c: 2,
+                ..Default::default()
+            },
+            body: (2, 3),
+        },
+        DiscardCase {
+            id: "earsplitting_rats",
+            mana: ManaGift {
+                b: 1,
+                c: 3,
+                ..Default::default()
+            },
+            body: (2, 1),
+        },
+    ]
+}
+
+fn cast_discard_creature(e: &mut GameEngine, case: &DiscardCase) -> u32 {
+    inject_card_into_hand(e, 0, case.id);
+    give_mana(e, 0, gift(&case.mana));
+    let slot = hand_index_for_card(e, 0, case.id);
+    e.apply_scenario_command(0, &cast_spell(slot, vec![]))
+        .unwrap_or_else(|error| panic!("cast {}: {error:?}", case.id));
+    pass_both_players(e);
+    assert_eq!(e.state.stack.len(), 1, "{}: ETB trigger pending", case.id);
+    battlefield_object_for_card(e, 0, case.id)
+}
