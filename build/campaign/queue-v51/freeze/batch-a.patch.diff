+
+# ── 05 aura restrictions ─────────────────────────────────────────────────
+
+AURA_NOTE = (
+    "// CR 303.4 (Aura enchant), 509.1b (blocking restrictions), 613.1f/613.4c (layer 6\n"
+    "// keyword and P/T modifiers), 602.5 (prohibit activated abilities) and 502.3\n"
