+    keyword: Option<Keyword>,
+    pump: Option<(u32, u32)>,
+}
+
+fn splicers() -> Vec<Splicer> {
+    vec![
+        Splicer {
+            id: "wing_splicer",
+            keyword: Some(Keyword::Flying),
+            pump: None,
+        },
+        Splicer {
+            id: "sensor_splicer",
+            keyword: Some(Keyword::Vigilance),
+            pump: None,
+        },
+        Splicer {
+            id: "master_splicer",
+            keyword: None,
+            pump: Some((1, 1)),
