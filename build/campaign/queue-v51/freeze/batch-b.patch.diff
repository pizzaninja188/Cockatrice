+"""Generate queue-v51 family records from the pinned revalidation data."""
+from pathlib import Path
+
+ROOT = Path("/home/ubuntu/Cockatrice")
+OUT = ROOT / "build" / "campaign" / "queue-v51"
+FAMILIES = OUT / "families"
+
+SHAPES = {
