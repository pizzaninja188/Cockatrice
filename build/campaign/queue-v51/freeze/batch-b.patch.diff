+fn reach_search(e: &mut GameEngine) -> RuledCommand {
+    let branch = pass_both_players_with_batch(e);
+    assert_eq!(
+        find_resolution_choice(&branch)
+            .expect("optional branch")
+            .choice_kind(),
+        ChoiceKind::ResolutionBranch
+    );
+    select_branch(0)
+}
