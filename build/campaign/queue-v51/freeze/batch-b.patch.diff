+
+struct Tutor {
+    id: &'static str,
+    matching: &'static [&'static str],
+    nonmatching: &'static str,
+    creature: &'static str,
+}
+
+fn tutors() -> Vec<Tutor> {
+    vec![
+        Tutor {
+            id: "trinket_mage",
+            matching: &["sol_ring", "lotus_petal"],
+            nonmatching: "mind_stone",
+            creature: "grizzly_bears",
+        },
+        Tutor {
+            id: "tribute_mage",
+            matching: &["mind_stone"],
+            nonmatching: "sol_ring",
+            creature: "grizzly_bears",
+        },
+        Tutor {
+            id: "trophy_mage",
+            matching: &["azorius_locket"],
