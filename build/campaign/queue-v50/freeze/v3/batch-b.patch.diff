+// ── 03 tap plus stun counters ──────────────────────────────────────────────
+
+struct StunCase {
+    id: &'static str,
+    mana: ManaGift,
+    counters: u32,
+    opponent_only: bool,
+    scry: u32,
+}
+
+fn stun_cases() -> [StunCase; 4] {
+    [
+        StunCase { id: "cryogenic_stasis", mana: ManaGift { u: 1, c: 1, ..Default::default() }, counters: 1, opponent_only: false, scry: 0 },
+        StunCase { id: "impede_momentum", mana: ManaGift { u: 1, c: 1, ..Default::default() }, counters: 3, opponent_only: false, scry: 1 },
+        StunCase { id: "tranquilize", mana: ManaGift { u: 1, c: 1, ..Default::default() }, counters: 3, opponent_only: true, scry: 0 },
+        StunCase { id: "freeze_in_place", mana: ManaGift { u: 1, c: 1, ..Default::default() }, counters: 3, opponent_only: true, scry: 2 },
+    ]
+}
+
+fn stun_engine(seed: u64, card: &str) -> GameEngine {
+    let decks = Some(vec![
+        deck_with("island", &[card]),
+        deck_with("forest", &["grizzly_bears"]),
+    ]);
+    let mut e = GameEngine::new(
+        tricerules_cards::registry::global(),
+        seed,
+        &[0, 1],
+        20,
+        decks,
+        true,
+    )
+    .expect("engine");
+    advance_to_main1_from_game_start(&mut e);
+    e
+}
