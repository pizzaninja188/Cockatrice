+// ── 03 tap plus stun counters ──────────────────────────────────────────────
+
+#[test]
+fn q50_tap_stun_maps_definitions() {
+    struct Case {
+        id: &'static str,
+        name: &'static str,
+        mana: &'static str,
+        types: &'static [&'static str],
+        counters: u32,
+        scry: u32,
+        opponent_only: bool,
+        draw: bool,
+    }
+    for case in [
+        Case { id: "cryogenic_stasis", name: "Cryogenic Stasis", mana: "{1}{U}", types: &["Instant"], counters: 1, scry: 0, opponent_only: false, draw: true },
+        Case { id: "impede_momentum", name: "Impede Momentum", mana: "{1}{U}", types: &["Sorcery"], counters: 3, scry: 1, opponent_only: false, draw: false },
+        Case { id: "tranquilize", name: "Tranquilize", mana: "{1}{U}", types: &["Sorcery"], counters: 3, scry: 0, opponent_only: true, draw: false },
+        Case { id: "freeze_in_place", name: "Freeze in Place", mana: "{1}{U}", types: &["Sorcery"], counters: 3, scry: 2, opponent_only: true, draw: false },
+    ] {
+        let f = identity(case.id, case.name, case.mana, case.types, None);
+        assert!(matches!(f.spell_effect[0], SpellEffectKind::Tap { .. }), "{}", case.id);
+        let SpellEffectKind::PutCounters {
+            counter,
+            count,
+            subject,
+        } = &f.spell_effect[1]
+        else {
+            panic!("{}: stun placement", case.id)
+        };
+        assert_eq!(*counter, CounterKind::Stun, "{}", case.id);
+        let tricerules_cards::primitives::Amount::Fixed(count) = count else {
+            panic!("{}: fixed stun count", case.id)
+        };
+        assert_eq!(*count, case.counters, "{}", case.id);
+        let EffectSubject::Chosen(filter) = subject else {
+            panic!("{}: chosen target", case.id)
+        };
+        assert_eq!(filter.kind, TargetKind::Creature, "{}", case.id);
+        assert_eq!(
+            filter.controller,
+            if case.opponent_only { TargetController::Opponent } else { TargetController::Any },
+            "{}: controller scope",
+            case.id
+        );
+        let has_scry = f
+            .spell_effect
+            .iter()
+            .any(|effect| matches!(effect, SpellEffectKind::Scry { .. }));
+        assert_eq!(has_scry, case.scry > 0, "{}", case.id);
+        let has_draw = f
+            .spell_effect
+            .iter()
+            .any(|effect| matches!(effect, SpellEffectKind::Draw { .. }));
+        assert_eq!(has_draw, case.draw, "{}", case.id);
+    }
+}
