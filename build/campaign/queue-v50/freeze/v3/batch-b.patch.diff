+//! Registry conformance for the queue-v50 reviewed cohorts.
+#![allow(clippy::type_complexity)]
+use tricerules_cards::primitives::{
+    CardTypeFilter, CounterKind, EffectSubject, GraveyardDestination, Keyword,
+    SpellEffectKind, TargetController, TargetKind, TriggerCondition,
+};
+use tricerules_cards::{registry, CardDefinition, CardFace, Layout};
+
+fn definition(id: &str) -> &'static CardDefinition {
+    registry::global()
+        .get(id)
+        .unwrap_or_else(|| panic!("missing {id}"))
+}
+
+fn face_id(name: &str) -> String {
+    let folded = name.to_lowercase().replace(['\'', ','], "").replace(['é', 'è', 'ê'], "e").replace(['à', 'â'], "a").replace(['ô'], "o");
+    let mut text = String::new();
+    let mut last_underscore = false;
+    for ch in folded.chars() {
+        if ch.is_ascii_alphanumeric() {
+            text.push(ch);
+            last_underscore = false;
+        } else if !last_underscore {
+            text.push('_');
+            last_underscore = true;
+        }
+    }
+    text.trim_matches('_').to_string()
+}
+
+fn identity(
+    id: &str,
+    name: &str,
+    mana: &str,
+    types: &[&str],
+    body: Option<(u32, u32)>,
+) -> &'static CardFace {
+    let definition = definition(id);
+    assert_eq!(definition.layout, Layout::Normal, "{id}");
+    assert_eq!(registry::global().id_for_name(name), Some(id), "{id}");
+    let f = definition.primary_face();
+    assert_eq!(f.face_id.as_str(), face_id(name), "{id} face id");
+    assert_eq!(f.name, name, "{id} name");
+    assert_eq!(f.mana_cost.to_string(), mana, "{id} mana");
+    assert_eq!(
+        f.types.iter().map(String::as_str).collect::<Vec<_>>(),
+        types,
+        "{id} types"
+    );
+    assert_eq!(
+        (f.power, f.toughness),
+        body.map_or((None, None), |(p, t)| (Some(p), Some(t))),
+        "{id} body"
+    );
+    f
+}
