+#[test]
+fn q50_put_top_cards_accept_each_disjunctive_branch() {
+    for (index, (id, mana, target_card)) in [
+        ("run_aground", ManaGift { u: 1, c: 3, ..Default::default() }, "grizzly_bears"),
+        ("run_aground", ManaGift { u: 1, c: 3, ..Default::default() }, "bonesplitter"),
+        ("banishment_decree", ManaGift { w: 2, c: 3, ..Default::default() }, "crusade"),
+        ("temporal_eddy", ManaGift { u: 2, c: 2, ..Default::default() }, "forest"),
+        ("temporal_eddy", ManaGift { u: 2, c: 2, ..Default::default() }, "grizzly_bears"),
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        let mut e = engine(50_013_500 + index as u64, "island", id);
+        let target = inject_permanent_on_battlefield(&mut e, 1, target_card);
+        cast_at(&mut e, id, &mana, target)
+            .unwrap_or_else(|error| panic!("{id} at {target_card}: {error:?}"));
+        pass_both_players(&mut e);
+        assert_eq!(
+            e.state.objects[&target].zone,
