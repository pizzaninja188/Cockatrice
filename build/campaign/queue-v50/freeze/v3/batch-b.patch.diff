+// ── 01 put target on top of its owner's library ───────────────────────────
+
+#[test]
+fn q50_put_top_maps_definitions() {
+    struct Case {
+        id: &'static str,
+        name: &'static str,
+        mana: &'static str,
+        types: &'static [&'static str],
+        flashback: Option<&'static str>,
+    }
+    for case in [
+        Case { id: "repel", name: "Repel", mana: "{3}{U}", types: &["Instant"], flashback: None },
+        Case { id: "grasp_of_phantoms", name: "Grasp of Phantoms", mana: "{3}{U}", types: &["Sorcery"], flashback: Some("{7}{U}") },
+        Case { id: "run_aground", name: "Run Aground", mana: "{3}{U}", types: &["Instant"], flashback: None },
+        Case { id: "banishment_decree", name: "Banishment Decree", mana: "{3}{W}{W}", types: &["Instant"], flashback: None },
+        Case { id: "temporal_eddy", name: "Temporal Eddy", mana: "{2}{U}{U}", types: &["Sorcery"], flashback: None },
+        Case { id: "fallow_earth", name: "Fallow Earth", mana: "{2}{G}", types: &["Sorcery"], flashback: None },
+    ] {
+        let f = identity(case.id, case.name, case.mana, case.types, None);
+        assert!(f.spell_program.is_some(), "{}: placement program", case.id);
+        assert!(f.spell_effect.is_empty(), "{}", case.id);
+        assert!(f.triggered_abilities.is_empty(), "{}", case.id);
+        let targeting = f.targeting.as_ref().expect("one target");
+        assert_eq!(targeting.groups.len(), 1, "{}", case.id);
+        assert_eq!(targeting.groups[0].min, 1, "{}", case.id);
+        assert_eq!(targeting.groups[0].max, 1, "{}", case.id);
+        assert_eq!(
+            f.flashback_cost.as_ref().map(|cost| cost.to_string()),
+            case.flashback.map(str::to_string),
+            "{}: flashback",
+            case.id
+        );
+    }
+}
