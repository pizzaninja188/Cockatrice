+        Case { id: "black_dragon", name: "Black Dragon", mana: "{5}{B}{B}", types: &["Creature", "Dragon"], body: (4, 4), keywords: &[Keyword::Flying], power: -3, toughness: -3 },
+        Case { id: "faerie_duelist", name: "Faerie Duelist", mana: "{1}{U}", types: &["Creature", "Faerie", "Rogue"], body: (1, 2), keywords: &[Keyword::Flash, Keyword::Flying], power: -2, toughness: 0 },
+        Case { id: "brinebarrow_intruder", name: "Brinebarrow Intruder", mana: "{U}", types: &["Creature", "Human", "Rogue"], body: (1, 2), keywords: &[Keyword::Flash], power: -2, toughness: 0 },
