+            assert_eq!(e.effective_toughness(observer), Some(2), "{id}: no stale pump");
+        } else {
+            assert_eq!(
+                e.state.objects[&target].counters.get(&CounterKind::PlusOnePlusOne),
+                None,
+                "{id}: no stale counter"
