+#[test]
+fn q50_put_top_cards_fizzle_when_the_target_leaves() {
+    for (index, (id, mana)) in [
+        ("repel", ManaGift { u: 1, c: 3, ..Default::default() }),
+        ("grasp_of_phantoms", ManaGift { u: 1, c: 3, ..Default::default() }),
+        ("run_aground", ManaGift { u: 1, c: 3, ..Default::default() }),
+        ("banishment_decree", ManaGift { w: 2, c: 3, ..Default::default() }),
+        ("temporal_eddy", ManaGift { u: 2, c: 2, ..Default::default() }),
+        ("fallow_earth", ManaGift { g: 1, c: 2, ..Default::default() }),
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        let mut e = engine(50_014_000 + index as u64, "island", id);
+        let target = if id == "fallow_earth" {
