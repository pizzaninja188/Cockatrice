+        StunCase { id: "impede_momentum", mana: ManaGift { u: 1, c: 1, ..Default::default() }, counters: 3, opponent_only: false, scry: 1 },
+        StunCase { id: "tranquilize", mana: ManaGift { u: 1, c: 1, ..Default::default() }, counters: 3, opponent_only: true, scry: 0 },
+        StunCase { id: "freeze_in_place", mana: ManaGift { u: 1, c: 1, ..Default::default() }, counters: 3, opponent_only: true, scry: 2 },
+    ]
+}
