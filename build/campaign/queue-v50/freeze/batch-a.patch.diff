+fn chosen_filter(subject: &EffectSubject) -> &tricerules_cards::primitives::TargetFilter {
+    match subject {
+        EffectSubject::Chosen(filter) => filter,
+        other => panic!("expected chosen subject, got {other:?}"),
+    }
+}
