+#[test]
+fn q50_tap_stun_canary_hardest_freeze_in_place_scries_two() {
+    let case = &stun_cases()[3];
+    let mut e = stun_engine(50_031_001, case.id);
+    let target = inject_creature_on_battlefield(&mut e, 1, "grizzly_bears");
