+#[test]
+fn q50_put_top_cards_put_only_their_matching_permanents_on_top() {
+    struct Case {
+        id: &'static str,
+        mana: ManaGift,
+        target: &'static str,
+        illegal: &'static str,
+    }
+    for (index, case) in [
+        Case { id: "repel", mana: ManaGift { u: 1, c: 3, ..Default::default() }, target: "grizzly_bears", illegal: "forest" },
+        Case { id: "grasp_of_phantoms", mana: ManaGift { u: 1, c: 3, ..Default::default() }, target: "grizzly_bears", illegal: "forest" },
+        Case { id: "run_aground", mana: ManaGift { u: 1, c: 3, ..Default::default() }, target: "bonesplitter", illegal: "forest" },
+        Case { id: "banishment_decree", mana: ManaGift { w: 2, c: 3, ..Default::default() }, target: "crusade", illegal: "forest" },
+        Case { id: "temporal_eddy", mana: ManaGift { u: 2, c: 2, ..Default::default() }, target: "grizzly_bears", illegal: "bonesplitter" },
+        Case { id: "fallow_earth", mana: ManaGift { g: 1, c: 2, ..Default::default() }, target: "forest", illegal: "grizzly_bears" },
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        let mut e = engine(50_012_000 + index as u64, "island", case.id);
+        let target = if case.target == "forest" {
+            inject_permanent_on_battlefield(&mut e, 1, "forest")
+        } else {
+            inject_permanent_on_battlefield(&mut e, 1, case.target)
+        };
+        cast_at(&mut e, case.id, &case.mana, target).expect("cast the placement spell");
+        pass_both_players(&mut e);
+        assert_eq!(
+            e.state.objects[&target].zone,
+            Zone::Library,
+            "{}: the matching permanent moved",
+            case.id
+        );
+        assert_eq!(e.state.objects[&target].owner, 1, "{}", case.id);
+        assert_eq!(
+            e.state.players[1].library.front(),
+            Some(&target),
+            "{}: the permanent is on top of its owner's library",
+            case.id
+        );
+
+        let mut e = engine(50_013_000 + index as u64, "island", case.id);
+        let illegal = inject_permanent_on_battlefield(&mut e, 1, case.illegal);
+        assert!(
+            cast_at(&mut e, case.id, &case.mana, illegal).is_err(),
+            "{}: an illegal card type is rejected before casting",
+            case.id
+        );
+        assert_eq!(
+            e.state.objects[&illegal].zone,
+            Zone::Battlefield,
+            "{}: the illegal permanent stays",
+            case.id
+        );
+        assert!(e.state.stack.is_empty(), "{}", case.id);
+    }
+}
