+#[test]
+fn q50_destroy_cards_accept_only_their_printed_target_types() {
+    for (index, (id, mana, legal, illegal)) in [
+        ("naturalize", ManaGift { g: 1, c: 1, ..Default::default() }, "bonesplitter", "grizzly_bears"),
+        ("naturalize", ManaGift { g: 1, c: 1, ..Default::default() }, "crusade", "grizzly_bears"),
+        ("natures_chant", ManaGift { g: 1, c: 1, ..Default::default() }, "bonesplitter", "forest"),
+        ("natures_chant", ManaGift { g: 1, c: 1, ..Default::default() }, "crusade", "forest"),
+        ("return_to_the_earth", ManaGift { g: 1, c: 3, ..Default::default() }, "storm_crow", "grizzly_bears"),
+        ("return_to_the_earth", ManaGift { g: 1, c: 3, ..Default::default() }, "bonesplitter", "grizzly_bears"),
+        ("return_to_the_earth", ManaGift { g: 1, c: 3, ..Default::default() }, "crusade", "forest"),
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        let mut e = engine(50_092_000 + index as u64, "forest", id);
+        let target = inject_permanent_on_battlefield(&mut e, 1, legal);
+        cast_at(&mut e, id, &mana, target).expect("cast at the legal target");
+        pass_both_players(&mut e);
+        assert_eq!(e.state.objects[&target].zone, Zone::Graveyard, "{id}: {legal}");
+
+        let mut e = engine(50_093_000 + index as u64, "forest", id);
+        let rejected = inject_permanent_on_battlefield(&mut e, 1, illegal);
+        assert!(
+            cast_at(&mut e, id, &mana, rejected).is_err(),
+            "{id}: {illegal} is not a legal target"
+        );
+        assert_eq!(e.state.objects[&rejected].zone, Zone::Battlefield, "{id}");
+        assert!(e.state.stack.is_empty(), "{id}");
+    }
+}
