+fn choose_trigger_target(targets: Vec<tricerules_proto::ruled::v1::TargetRef>) -> RuledCommand {
+    RuledCommand {
+        cmd: Some(Cmd::ChooseTriggerTarget(
+            tricerules_proto::ruled::v1::ChooseTriggerTarget {
